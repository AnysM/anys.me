---
// Page de travail (non référencée) : comparer les trois façons de montrer les cinq dimensions.
import Base from '../layouts/Base.astro';
import Rosace from '../components/Rosace.astro';
import Rangee from '../components/Rangee.astro';
import { getEntry } from 'astro:content';
import { UNIVERS } from '../lib/univers.mjs';

const acc = (await getEntry('pages', 'accueil'))!.data;
const piliers = UNIVERS.map((u, i) => ({ ...u, nom: acc.piliers?.[i]?.nom ?? u.nom, note: acc.piliers?.[i]?.note ?? '', image: acc.piliers?.[i]?.picto || null }));
const centre = acc.piliers_centre ?? 'Quintessence';
---
<Base title="Comparer les trois versions" description="Page de travail" noindex>
  <section style="padding-top:8rem;">
    <div class="wrap" style="text-align:center;">
      <p class="eyebrow">Page de travail</p>
      <h1 style="margin-top:0.6rem;">Trois façons de montrer les cinq dimensions</h1>
      <p class="muted" style="margin-top:0.8rem;">Cette page n'est pas dans le menu et n'est pas indexée par Google.</p>
    </div>
  </section>

  <section class="bloc">
    <div class="wrap">
      <div class="tete"><p class="eyebrow">Version A</p><h2>La rosace, avec le mot au centre</h2></div>
      <Rosace univers={piliers} centre={centre} />
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="tete"><p class="eyebrow">Version B</p><h2>La rosace, sans le mot au centre</h2></div>
      <Rosace univers={piliers} centre={''} />
    </div>
  </section>

  <section class="bloc">
    <div class="wrap">
      <div class="tete"><p class="eyebrow">Version C</p><h2>En ligne, avec de petites icônes</h2></div>
      <Rangee univers={piliers} centre={centre} />
    </div>
  </section>
</Base>
