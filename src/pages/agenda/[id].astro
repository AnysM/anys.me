---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const all = (await getCollection('agenda')).filter((e) => e.data.publie && !e.data.site);
  const dated = all.filter((e) => e.data.date).sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
  const recur = all.filter((e) => !e.data.date).sort((a, b) => a.data.ordre - b.data.ordre);
  const ordered = [...dated, ...recur];
  return ordered.map((e, i) => {
    const n = ordered.length > 1 ? ordered[(i + 1) % ordered.length] : null;
    const next = n ? { id: n.id, titre: n.data.titre } : null;
    return { params: { id: e.id }, props: { e, next } };
  });
}
const { e, next } = Astro.props;
const { Content } = await render(e);
const d = e.data;
const quand = d.date ? new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(d.date) : (d.rythme ?? 'Sur inscription');
const infos = [{ k: 'Quand', v: quand + (d.heure ? ` · ${d.heure}` : '') }];
if (d.lieu) infos.push({ k: 'Lieu', v: d.lieu });
if (d.prix) infos.push({ k: 'Tarif', v: d.prix });
if (d.earlybird) infos.push({ k: 'Early bird', v: `jusqu'au ${d.earlybird}` });
---
<Base title={`${d.titre} — Anys Mechkar`}>
  <section class="page-hero"><img src={d.image ?? '/img/u-immersion.jpg'} alt="" />
    <div class="wrap"><p class="eyebrow">{quand}</p><h1>{d.titre}</h1></div>
  </section>

  <section>
    <div class="narrow"><div class="prose"><Content /></div></div>
  </section>

  {d.resume && (
    <section class="breath" style="min-height:44vh;"><img src={d.image ?? '/img/breath-desert.jpg'} alt="" /><div class="phrase">{d.resume}</div></section>
  )}

  <section class="bloc-or">
    <div class="narrow">
      <p class="eyebrow">Infos pratiques</p>
      <div class="infos" style="margin-top:1.4rem;">{infos.map((it) => <div><div class="k">{it.k}</div><div class="v">{it.v}</div></div>)}</div>
      {d.reservable && d.lien && (
        <div style="margin-top:1.8rem;">
          <a class="btn btn--solid" href={d.lien} target={d.lien.startsWith('http') ? '_blank' : undefined} rel="noopener">{d.cta ?? 'Réserver'}</a>
        </div>
      )}
    </div>
  </section>

  <section class="striptease">
    <div class="photo-slot">Photo à venir</div>
    <div class="photo-slot">Photo à venir</div>
    <div class="photo-slot">Photo à venir</div>
  </section>

  <section class="invite">
    <div class="narrow">
      <p class="eyebrow">Une question</p>
      <h2>Envie d'en savoir plus ?</h2>
      <p class="muted" style="margin:0.9rem auto 0; max-width:46ch;">Écris-moi pour toute question sur cet événement, ou réservons un temps d'échange.</p>
      <div class="invite__btns">
        <a class="btn btn--solid" href="/contact">Écrire à Anys</a>
        <a class="btn" href="/contact#appel">Prendre un appel</a>
      </div>
    </div>
  </section>

  <section style="padding-top:0;">
    <div class="narrow detail-nav">
      <a class="cta" href="/agenda">← Tout l'agenda</a>
      {next && <a class="cta cta--r" href={`/agenda/${next.id}`}>Prochain événement <span class="line"></span></a>}
    </div>
  </section>
</Base>
