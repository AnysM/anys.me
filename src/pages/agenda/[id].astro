---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';
import Sigils from '../../components/Sigils.astro';
import Icone from '../../components/Icone.astro';
import { codexDe } from '../../lib/monde';
import { seuil, seuilDe, typeLabel } from '../../lib/univers.mjs';
import { fil, description, PERSONNE_ID, SITE, abs } from '../../lib/seo';
const ICONES = { 'Quand': 'date', 'Lieu': 'lieu', 'Tarif': 'prix', 'Early bird': 'duree' };
export async function getStaticPaths() {
  const all = (await getCollection('agenda')).filter((e) => e.data.publie && !e.data.site);
  const dated = all.filter((e) => e.data.date).sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
  const recur = all.filter((e) => !e.data.date).sort((a, b) => a.data.ordre - b.data.ordre);
  const ordered = [...dated, ...recur];
  return ordered.map((e, i) => {
    const n = ordered.length > 1 ? ordered[(i + 1) % ordered.length] : null;
    const next = n ? { id: n.id, titre: n.data.titre, image: n.data.image ?? null } : null;
    return { params: { id: e.id }, props: { e, next } };
  });
}
const { e, next } = Astro.props;
const { Content } = await render(e);
const d = e.data;
const quand = d.date ? new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(d.date) : (d.rythme ?? 'Sur inscription');
const infos = [{ k: 'Quand', v: quand + (d.heure ? ` · ${d.heure}` : '') }];
if (d.lieu) infos.push({ k: 'Lieu', v: d.lieu });
if (d.prix) infos.push({ k: 'Tarif', v: d.prix });
if (d.earlybird) infos.push({ k: 'Early bird', v: `jusqu'au ${d.earlybird}` });
const lies = await codexDe(`agenda/${e.id}`);
const touche = lies.filter((f) => f.data.type !== 'allie');
const avec = lies.filter((f) => f.data.type === 'allie');
const sigils = [...new Set(touche.flatMap((f) => f.data.univers))];
const fmt = (t = '') => t.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/\*(.+?)\*/g, '<em>$1</em>');
const s = seuil(seuilDe(d));
const appel = (await getEntry('pages', 'contact'))!.data.appel_lien;
const contact = `/contact?pour=${encodeURIComponent(d.titre)}`;
const desc = description(d.resume, e.body);
const enLigne = /en ligne/i.test(d.lieu ?? '');
// "20h" ou "19h30" → 2026-10-26T20:00:00+01:00 (heure de Paris, été comme hiver)
function debut(date: Date, heure?: string) {
  const jour = date.toISOString().slice(0, 10);
  const m = heure?.match(/^(\d{1,2})h(\d{2})?/);
  if (!m) return jour;
  const decalage = new Intl.DateTimeFormat('en', { timeZone: 'Europe/Paris', timeZoneName: 'longOffset' }).formatToParts(date).find((p) => p.type === 'timeZoneName')!.value.replace('GMT', '') || '+00:00';
  return `${jour}T${m[1].padStart(2, '0')}:${m[2] ?? '00'}:00${decalage}`;
}
const prix = d.prix && /\d/.test(d.prix) ? d.prix.match(/\d+([.,]\d+)?/)![0].replace(',', '.') : d.prix && /gratuit/i.test(d.prix) ? '0' : null;
const jsonld = [
  ...(d.date ? [{
    '@type': 'Event',
    name: d.titre,
    description: desc,
    startDate: debut(d.date, d.heure),
    ...(d.date_fin && { endDate: d.date_fin.toISOString().slice(0, 10) }),
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: enLigne ? 'https://schema.org/OnlineEventAttendanceMode' : 'https://schema.org/OfflineEventAttendanceMode',
    location: enLigne ? { '@type': 'VirtualLocation', url: abs(`/agenda/${e.id}`) } : { '@type': 'Place', name: d.lieu ?? 'Lyon', address: d.lieu ?? 'Lyon, France' },
    ...(d.image && { image: new URL(d.image, SITE).href }),
    organizer: { '@id': PERSONNE_ID },
    performer: { '@id': PERSONNE_ID },
    ...(prix !== null && { offers: { '@type': 'Offer', price: prix, priceCurrency: 'EUR', availability: 'https://schema.org/InStock', url: d.lien ?? abs(`/agenda/${e.id}`) } }),
    inLanguage: 'fr-FR',
  }] : []),
  fil([{ nom: 'Accueil', url: '/' }, { nom: 'Agenda', url: '/agenda' }, { nom: d.titre, url: `/agenda/${e.id}` }]),
];
---
<Base title={`${d.titre} — Agenda | Anys Mechkar`} description={desc} image={d.image} jsonld={jsonld}>
  <section class="page-hero">{d.image ? <img src={d.image} alt="" /> : <div class="ph-band"></div>}
    <div class="wrap"><p class="eyebrow">{quand}</p><h1>{d.titre}</h1>
      <p class="seuil-tag"><i>{s?.num}</i> {s?.nom}<Sigils ids={sigils} /></p></div>
  </section>

  <section>
    <div class="narrow"><div class="prose"><Content /></div>
      {touche.length > 0 && (
        <div class="touche">
          <p class="rune">Ce que ça touche</p>
          <div class="echos">{touche.map((f) => <a class="echo" href={`/codex/${f.id}`}>{f.data.titre}<small>{typeLabel(f.data.type)}</small></a>)}</div>
        </div>
      )}
      {avec.length > 0 && (
        <p class="muted" style="margin-top:1.4rem; font-size:0.92rem;">Avec {avec.map((a, i) => <Fragment>{i > 0 && (i === avec.length - 1 ? ' et ' : ', ')}<a class="lore" href={`/codex/${a.id}`}>{a.data.titre}</a></Fragment>)}</p>
      )}
    </div>
  </section>

  {d.resume && (
    <section class="breath" style="min-height:44vh;">{d.image ? <img src={d.image} alt="" /> : <div class="ph-band"></div>}<div class="phrase" set:html={fmt(d.resume)}></div></section>
  )}

  <section class="bloc-or">
    <div class="narrow">
      <p class="eyebrow">Infos pratiques</p>
      <div class="infos" style="margin-top:1.4rem;">{infos.map((it) => <div><div class="k"><Icone nom={ICONES[it.k] ?? 'etoile'} />{it.k}</div><div class="v">{it.v}</div></div>)}</div>
      {d.reservable && d.lien && (
        <div style="margin-top:1.8rem;">
          <a class="btn btn--solid" href={d.lien} target={d.lien.startsWith('http') ? '_blank' : undefined} rel="noopener">{d.cta ?? 'Réserver'}</a>
        </div>
      )}
    </div>
  </section>


  <section class="invite">
    <div class="narrow">
      <p class="eyebrow">Une question</p>
      <h2>Envie d'en savoir plus ?</h2>
      <p class="muted" style="margin:0.9rem auto 0; max-width:46ch;">Écris-moi pour toute question sur cet événement, ou réservons un temps ensemble.</p>
      <div class="invite__btns">
        <a class="btn btn--solid" href={contact}>Écris-moi</a>
        {appel && <a class="btn" href={appel} target="_blank" rel="noopener">Prendre un appel</a>}
      </div>
    </div>
  </section>

  <section class="detail-foot">
    <div class="wrap detail-nav">
      <a class="cta" href="/agenda">← Tout l'agenda</a>
      {next && (
        <a class="next-card" href={`/agenda/${next.id}`}>
          <span class="next-card__txt"><span class="next-card__label">Prochain événement</span><span class="next-card__title">{next.titre}</span></span>
          <span class="next-card__img">{next.image ? <img src={next.image} alt={next.titre} /> : <div class="imgph"><span></span></div>}</span>
        </a>
      )}
    </div>
  </section>
</Base>
