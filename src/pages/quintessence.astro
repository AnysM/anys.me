---
import Base from '../layouts/Base.astro';
import { getEntry } from 'astro:content';
const qc = (await getEntry('pages', 'quintessence')).data;
const fmt = (t) => (t || '').replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/\*(.+?)\*/g, '<span class="script">$1</span>');
const pratiques = qc.pratiques ?? [];
---
<Base title="Quintessence — Anys Mechkar">
  <!-- HERO -->
  <section class="page-hero" style="min-height:64vh;">{qc.hero_image ? <img src={qc.hero_image} alt="" /> : <div class="ph-band"></div>}
    <div class="wrap"><p class="eyebrow">{qc.hero_eyebrow}</p><h1 style="font-size:clamp(2.4rem,6vw,4rem);">{qc.hero_titre}</h1><p class="lead" style="margin-top:1rem;">{qc.hero_lead}</p></div>
  </section>

  <!-- PASSAGE -->
  <section class="passage">
    <div class="narrow">
      <p>{qc.passage}</p>
    </div>
  </section>

  <!-- RESPIRATION -->
  <section class="breath" style="min-height:52vh;">{qc.resp_image ? <img src={qc.resp_image} alt="" /> : <div class="ph-band"></div>}<div class="phrase" set:html={fmt(qc.citation)}></div></section>

  <!-- LE VOYAGE (image + texte) -->
  <section style="padding:0;">
    <div class="univers">
      <div class="univers__img">{qc.silence_image ? <img class="slot-img" src={qc.silence_image} alt="" /> : <div class="imgph"><span>QUINT-SILENCE</span></div>}</div>
      <div class="univers__body">
        <h2>{qc.silence_titre}</h2>
        <p>{qc.silence_texte}</p>
      </div>
    </div>
    <div class="univers rev">
      <div class="univers__img">{qc.crea_image ? <img class="slot-img" src={qc.crea_image} alt="" /> : <div class="imgph"><span>QUINT-CREA</span></div>}</div>
      <div class="univers__body">
        <h2>{qc.crea_titre}</h2>
        <p>{qc.crea_texte}</p>
      </div>
    </div>
  </section>

  <!-- PRATIQUES (bloc de couleur) -->
  <section class="bloc-or">
    <div class="wrap">
      <p class="eyebrow">{qc.pratiques_eyebrow}</p>
      <h2 style="margin-top:0.8rem;" set:html={fmt(qc.pratiques_titre)}></h2>
      <div class="pratiques">{pratiques.map((p) => <span>{p}</span>)}</div>
    </div>
  </section>

  <!-- GALERIE (emplacements photo dédiés) -->
  <section class="striptease">
    <div class="photo-slot">Photo à venir</div>
    <div class="photo-slot">Photo à venir</div>
    <div class="photo-slot">Photo à venir</div>
  </section>

  <!-- INFOS -->
  <section>
    <div class="narrow">
      <div class="encart">
        <div class="encart__title">Infos pratiques</div>
        <div class="infos">
          <div><div class="k">Format</div><div class="v">5 jours</div></div>
          <div><div class="k">Lieu</div><div class="v">France</div></div>
          <div><div class="k">Dates</div><div class="v">À venir</div></div>
          <div><div class="k">Tarif</div><div class="v">À venir</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="breath" style="min-height:40vh;">
    {qc.fin_image ? <img src={qc.fin_image} alt="" /> : <div class="ph-band"></div>}
    <div class="phrase" style="display:flex;flex-direction:column;align-items:center;gap:1.6rem;">
      {qc.cta_texte}
      <a class="btn" href="mailto:contact@anys.me?subject=Quintessence" style="font-style:normal;">Écrire à Anys</a>
    </div>
  </section>
</Base>
