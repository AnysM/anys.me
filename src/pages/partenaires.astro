---
import Base from '../layouts/Base.astro';
const partenaires = [
  { n: 'Meïsō', img: '/img/meiso-photo.jpg', logo: '/img/logo-meiso.png', d: 'Centre de flottaison et de bien-être, à Lyon. Un espace de lâcher-prise dans une eau dense en sels.', lien: 'https://meiso.fr/flottaison-lyon' },
  { n: 'Chanka Studio', img: '/img/u-atelier.jpg', logo: '/img/logo-chanka.svg', d: "Studio d'arts et de pratiques à Lyon, où se tiennent les ateliers Infloressence.", lien: 'https://chanka-studio-lyon.fr' },
  { n: 'Blast', img: '/img/blast.jpg', d: 'Collectif artistique.' },
  { n: 'TAMAKEAPA', img: '/img/breath-desert.jpg', logo: '/img/logo-partner-white.png', d: 'Partenaire.' },
  { n: 'Espriterre', img: '/img/u-soin.jpg', d: "Le travail d'Alex, en nature.", lien: 'https://espriterre.com' },
];
---
<Base title="Partenaires — Anys Mechkar">
  <section class="page-hero"><img src="/img/hero-partenaires.jpg" alt="" />
    <div class="wrap"><p class="eyebrow">Compagnons de route</p><h1>Partenaires</h1></div>
  </section>
  <section>
    <div class="wrap">
      <p class="lead">Les lieux, collectifs et personnes avec qui je crée.</p>
      <div class="parts">
        {partenaires.map((p) => (
          <div class="part">
            <div class="part__media"><img src={p.img} alt={p.n} />{p.logo && <img class="part__logo" src={p.logo} alt={p.n} />}</div>
            <div class="part__name">{p.n}</div>
            <div class="part__desc">{p.lien ? <a href={p.lien} target="_blank" rel="noopener">{p.d}</a> : p.d}</div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
