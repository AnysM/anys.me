---
import Base from '../layouts/Base.astro';
import { getEntry } from 'astro:content';
const pt = (await getEntry('pages', 'partenaires')).data;
const partenaires = pt.partenaires ?? [];
---
<Base title="Partenaires — Anys Mechkar">
  <section class="page-hero">{pt.hero_image ? <img src={pt.hero_image} alt="" /> : <div class="ph-band" data-h="HERO-PARTENAIRES"></div>}
    <div class="wrap"><p class="eyebrow">{pt.hero_eyebrow}</p><h1>{pt.hero_titre}</h1></div>
  </section>
  <section>
    <div class="wrap">
      <p class="lead">Les lieux, collectifs et personnes avec qui je crée.</p>
      <div class="parts">
        {partenaires.map((p) => (
          <div class="part">
            <div class="part__media">{p.image ? <img class="slot-img" src={p.image} alt={p.n} /> : <div class="imgph"><span>{p.handle}</span></div>}{p.logo && <img class={`part__logo${p.logoWhite ? ' part__logo--white' : ''}`} src={p.logo} alt={p.n} />}</div>
            <div class="part__name">{p.n}</div>
            <div class="part__desc">{p.lien ? <a href={p.lien} target="_blank" rel="noopener">{p.d}</a> : p.d}</div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
