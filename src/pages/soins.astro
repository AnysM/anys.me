---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { getEntry } from 'astro:content';
const sc = (await getEntry('pages', 'soins')).data;
const fmt = (t) => (t || '').replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/\*(.+?)\*/g, '<span class="script">$1</span>');
const soins = (await getCollection('offres')).filter((o) => o.data.publie && o.data.categorie === 'soin').sort((a, b) => a.data.ordre - b.data.ordre);
---
<Base title="Soins — Anys Mechkar">
  <section class="page-hero">{sc.hero_image ? <img src={sc.hero_image} alt="" /> : <div class="ph-band" data-h="HERO-SOINS"></div>}
    <div class="narrow"><p class="eyebrow">{sc.hero_eyebrow}</p><h1>{sc.hero_titre}</h1></div>
  </section>

  <!-- CŒUR À CŒUR -->
  <section class="coeur">
    <div class="wrap split">
      <div class="photo">{sc.portrait_image ? <img class="slot-img" src={sc.portrait_image} alt="" /> : <div class="imgph"><span>SOINS-PORTRAIT</span></div>}</div>
      <div class="coeur__text">{sc.coeur.split(/\n\n+/).map((par) => <p set:html={fmt(par)}></p>)}</div>
    </div>
  </section>

  <!-- LES SOINS -->
  <section>
    <div class="wrap">
      <p class="eyebrow">{sc.soins_eyebrow}</p>
      <h2 style="margin-top:0.8rem;" set:html={fmt(sc.soins_titre)}></h2>
      <p class="muted" style="margin-top:0.8rem;">{sc.soins_intro}</p>
      <div style="margin-top:2.4rem;">
        {soins.map((o) => (
          <a class="evt" href={`/offre/${o.id}`}>
            <div class="evt__img"><img src={o.data.image} alt={o.data.titre} /></div>
            <div class="evt__body">
              <div class="evt__date"><span class="soon">{o.data.tag}</span></div>
              <div class="evt__title">{o.data.titre}</div>
              <div class="evt__desc" set:html={fmt(o.data.resume)}></div>
              <div class="evt__meta">{o.data.duree}{o.data.prix ? ` · ${o.data.prix}` : ''}</div>
              <span class="cta" style="margin-top:0.4rem;">Découvrir <span class="line"></span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
