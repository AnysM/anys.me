---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { getEntry } from 'astro:content';
const sc = (await getEntry('pages', 'soins')).data;
const fmt = (t) => (t || '').replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/\*(.+?)\*/g, '<span class="script">$1</span>');
const soins = (await getCollection('offres')).filter((o) => o.data.publie && o.data.categorie === 'soin').sort((a, b) => a.data.ordre - b.data.ordre);
---
<Base title="Soins énergétiques et massages à Lyon — Anys Mechkar" description="Soin énergétique et massage à l'huile à Lyon, en studio sur les quais de Saône ou à domicile. Un temps pour relâcher, harmoniser et remettre du mouvement.">
  <section class="page-hero">{sc.hero_image ? <img src={sc.hero_image} alt="" /> : <div class="ph-band"></div>}
    <div class="narrow"><p class="eyebrow">{sc.hero_eyebrow}</p><h1>{sc.hero_titre}</h1></div>
  </section>

  <!-- Un seul niveau : ce que je mets dans un soin, puis les deux soins.
       On arrive vite au choix, sans détour par un portrait. -->
  <section class="soins-entree">
    <div class="narrow soins-tete">
      <p class="eyebrow">{sc.soins_eyebrow}</p>
      <h2 set:html={fmt(sc.soins_titre)}></h2>
      <p class="muted soins-chapeau">{sc.soins_intro}</p>
      <div class="soins-mot">{sc.coeur.split(/\n\n+/).map((par) => <p set:html={fmt(par)}></p>)}</div>
    </div>
    <div class="wrap soins-cartes">
        {soins.map((o) => (
          <a class="evt" href={o.data.page ?? `/offre/${o.id}`}>
            <div class="evt__img"><img src={o.data.image} alt={o.data.titre} /></div>
            <div class="evt__body">
              <div class="evt__date"><span class="soon">{o.data.tag}</span></div>
              <div class="evt__title">{o.data.titre}</div>
              <div class="evt__desc" set:html={fmt(o.data.resume)}></div>
              <div class="evt__meta">{o.data.duree}{o.data.prix ? ` · ${o.data.prix}` : ''}</div>
              <span class="cta" style="margin-top:0.4rem;">Découvrir <span class="line"></span></span>
            </div>
          </a>
        ))}
    </div>
  </section>
</Base>
