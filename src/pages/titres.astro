---
import Base from '../layouts/Base.astro';
const fonts = [
  { fam: 'Adelina Camarie', file: 'Adelina_Camarie.otf', fmt: 'opentype', size: '1.2em', note: 'actuelle, un peu grasse' },
  { fam: 'Biloxi Script',   file: 'Biloxi_Script.ttf',   fmt: 'truetype', size: '1.55em', note: 'accents OK' },
  { fam: 'Nagietha',        file: 'Nagitha.otf',         fmt: 'opentype', size: '1.55em', note: 'accents OK' },
  { fam: 'Racing Catalogue',file: 'Racing_Catalogue.ttf',fmt: 'truetype', size: '1.35em', note: 'accents OK' },
  { fam: 'Paragraph',       file: 'Paragraph.otf',       fmt: 'opentype', size: '1.6em',  note: "sans accents (à éviter en FR)" },
];
const faces = fonts.map((f) => `@font-face{font-family:'${f.fam}';src:url('/fonts/${f.file}') format('${f.fmt}');font-display:swap;}`).join('\n');
---
<Base title="Essais de titres — Anys Mechkar">
  <style is:global set:html={faces}></style>
  <style>
    .mix { border-top: 1px solid var(--faint); padding: clamp(2.4rem, 5vw, 3.6rem) 0; }
    .mix-title { font-family: 'Jost', sans-serif; font-weight: 300; font-size: clamp(1.5rem, 2.9vw, 2.25rem); line-height: 1.1; }
    .mix-title .jost { display: block; text-transform: uppercase; letter-spacing: 0.06em; color: var(--cream); }
    .mix-title .hw { display: block; line-height: 0.95; margin-top: 0.12em; color: var(--cream); }
    .mix-acc { font-size: 1.5rem; color: var(--gold); margin-top: 1.1rem; }
    .mix-label { font-family: 'Jost', sans-serif; text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.72rem; color: var(--muted); margin-top: 0.9rem; }
    .mix-label b { color: var(--gold); }
  </style>

  <section style="padding-top:120px; padding-bottom:1rem;">
    <div class="wrap">
      <p class="eyebrow">Essais de titres</p>
      <h1>Quelle manuscrite&nbsp;?</h1>
      <p class="muted" style="margin-top:1rem; max-width:60ch;">À chaque fois le même titre&nbsp;: la sans-serif Jost pour les premiers mots, puis l'accent dans la police d'essai. La ligne dorée en dessous teste les accents.</p>
    </div>
  </section>

  {fonts.map((f) => (
    <section class="mix">
      <div class="wrap">
        <div class="mix-title">
          <span class="jost">Marcher un chemin qui</span>
          <span class="hw" style={`font-family:'${f.fam}'; font-size:${f.size};`}>te ressemble vraiment.</span>
        </div>
        <p class="mix-acc" style={`font-family:'${f.fam}';`}>à â ä · é è ê ë · î ï · ô ö · ù û ü · ç — présence, créativité</p>
        <p class="mix-label"><b>{f.fam}</b> · {f.note}</p>
      </div>
    </section>
  ))}

  <section style="padding-top:2rem;"><div class="wrap"><a class="cta" href="/">← Retour à l'accueil</a></div></section>
</Base>
