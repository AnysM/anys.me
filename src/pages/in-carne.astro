---
// IN CARNE a sa propre page : une descente, de l'ombre vers la lumière.
// Les textes et les tarifs viennent de la fiche de l'offre (Tina › Offres › IN CARNE).
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Appel from '../components/Appel.astro';
import BarreAction from '../components/BarreAction.astro';
import { getEntry } from 'astro:content';
import { fil, description, PERSONNE_ID, SITE, abs } from '../lib/seo';

const o = (await getEntry('offres', 'in-carne'))!;
const d = o.data;
const fmt = (t = '') => t.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/\*(.+?)\*/g, '<span class="script">$1</span>');
const intention = (d.intention ?? '').split(/\n\n+/).filter(Boolean);
const contact = `/contact?pour=${encodeURIComponent('IN CARNE')}&interet=transformer`;

// Chaque mouvement porte sa couleur : la terre, l'eau, l'air, le feu, puis la lumière.
const COULEURS = ['#D8A24C', '#5C7CFF', '#A3A8FF', '#F07A5F', '#FFC53D', '#8FB3FF', '#ECE7DE'];

const jsonld = [
  {
    '@type': 'Service', '@id': abs('/in-carne/') + '#service', name: 'IN CARNE', serviceType: 'Parcours initiatique',
    provider: { '@id': PERSONNE_ID }, areaServed: 'En ligne', url: abs('/in-carne/'),
    description: d.resume,
    offers: (d.tarifs ?? []).map((t) => ({ '@type': 'Offer', name: t.label, price: (t.prix.match(/\d[\d\s]*/)?.[0] ?? '').replace(/\s/g, ''), priceCurrency: 'EUR' })),
  },
  fil([{ nom: 'Accueil', url: '/' }, { nom: 'Accompagnement', url: '/accompagnement' }, { nom: 'IN CARNE', url: '/in-carne' }]),
];
---
<Base title="IN CARNE — parcours initiatique pour hommes | Anys Mechkar" description={description(d.resume, o.body)} image={d.image} jsonld={jsonld}>
  <!-- 1. L'APPEL -->
  <section class="ic-appel">
    <img class="ic-appel__fond" src={d.image} alt="" />
    <div class="ic-appel__contenu">
      <img class="ic-sigil" src={d.logo} alt="" />
      <h1>IN CARNE</h1>
      <p class="ic-appel__sous">{d.tag} · {d.format}</p>
      <p class="ic-appel__phrase">{d.resume}</p>
    </div>
    <div class="ic-scroll"><span></span>Descendre</div>
  </section>

  <!-- 2. LE CONSTAT : trois temps, un message chacun -->
  <section class="ic-constat">
    <div class="ic-large">
      <p class="ic-grand ic-reveal">Tu as lu les livres, fait les formations, peut-être une thérapie. <em>Tu as compris.</em></p>
      <p class="ic-grand ic-reveal">Et pourtant, rien ne tient. Les mêmes schémas reviennent, l'écart reste entre tes élans et tes actes.</p>
      <p class="ic-grand ic-reveal">Parce que la compréhension reste dans la tête, que le corps n'est jamais convié, et que tu marches seul.</p>
    </div>
  </section>

  <!-- RESPIRATION : le feu -->
  <section class="ic-souffle">
    <img src="/img/hero.jpg" alt="" loading="lazy" />
    <p class="ic-souffle__mot">Ce que la tête a compris, <span class="script">le corps doit le vivre.</span></p>
  </section>

  <!-- 3. LE RÉCIT -->
  <section class="ic-recit">
    <div class="ic-recit__grille">
      <div class="ic-recit__photo"><img src="/img/portrait.jpg" alt="Anys Mechkar" loading="lazy" /></div>
      <div>
        <p class="eyebrow">{d.intention_eyebrow}</p>
        <div class="ic-recit__texte">{intention.map((par) => <p class="ic-reveal" set:html={fmt(par)}></p>)}</div>
      </div>
    </div>
  </section>

  <!-- 4. LE NOM -->
  <section class="ic-nom">
    <img class="ic-sigil ic-sigil--grand" src={d.logo} alt="" loading="lazy" />
    <h2 set:html={fmt(d.nom_titre ?? '')}></h2>
    <p set:html={fmt(d.nom_texte ?? '')}></p>
  </section>

  <!-- 5. LES SEPT MOUVEMENTS -->
  <section class="ic-roue" id="mouvements">
    <div class="ic-large">
      <p class="eyebrow">{d.cap_eyebrow}</p>
      <h2 set:html={fmt(d.cap_titre ?? '')}></h2>
      <p class="ic-roue__intro">Sept interlocuteurs intérieurs, sept directions. À chaque rendez-vous, l'un d'eux prend la parole et pose sa question.</p>
      <ol class="ic-mouvements">
        {(d.cap ?? []).map((m, i) => (
          <li class="ic-reveal" style={`--teinte:${COULEURS[i % COULEURS.length]}`}>
            <span class="ic-mouvement__num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{m.titre}</h3>
              {m.posture && <p class="ic-mouvement__posture">{m.posture}</p>}
              <p class="ic-mouvement__question">{m.texte}</p>
            </div>
          </li>
        ))}
      </ol>
      {d.cap_note && <p class="ic-roue__note" set:html={fmt(d.cap_note)}></p>}
    </div>
  </section>

  <!-- 6. C'EST POUR TOI SI… -->
  <section class="ic-pourtoi">
    <div class="ic-large">
      <p class="eyebrow">Pour qui</p>
      <h2>C'est <span class="script">pour toi</span> si…</h2>
      <ul class="ic-pourtoi__liste">
        {(d.pourtoi ?? []).map((x) => { const [phrase, masque] = x.split('|').map((y) => y.trim()); return (
          <li class="ic-reveal"><p>{phrase}</p>{masque && <span class="ic-masque">{masque}</span>}</li>
        ); })}
      </ul>
      {d.pourtoi_note && <p class="ic-pourtoi__note">{d.pourtoi_note}</p>}
    </div>
  </section>

  <!-- 7. LE CADRE -->
  <section class="ic-cadre">
    <div class="ic-large">
      <p class="eyebrow">Ce que tu vis, concrètement</p>
      <h2>Quatre mois, <span class="script">trois rendez-vous</span></h2>
      <div class="ic-cadre__grille">
        {(d.etapes ?? []).map((e) => (
          <div class="ic-cadre__item ic-reveal">
            <h3>{e.titre}</h3>
            <p>{e.texte}</p>
          </div>
        ))}
      </div>
      {d.cadre && <p class="ic-cadre__note" set:html={fmt(d.cadre)}></p>}
    </div>
  </section>

  <!-- 8. LES TRAVERSÉES -->
  {d.temoignages?.length > 0 && (
    <section class="ic-traversees">
      <div class="ic-large">
        <p class="eyebrow">Ils l'ont traversé</p>
        <div class="ic-traversees__grille">
          {d.temoignages.map((t) => (
            <figure class="ic-reveal">
              <blockquote>{t.t}</blockquote>
              <figcaption>{t.n}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 9. L'ENGAGEMENT -->
  <section class="ic-engagement" id="engagement">
    <div class="ic-large">
      <p class="eyebrow">L'engagement</p>
      <h2>Trois places, <span class="script">ouvertes</span></h2>
      <div class="ic-tarifs">
        {(d.tarifs ?? []).map((t) => (
          <div class={`ic-tarif${t.avant ? ' ic-tarif--avant' : ''}`}>
            <span class="ic-tarif__label">{t.label}</span>
            <span class="ic-tarif__prix">{t.prix}</span>
            {t.detail && <span class="ic-tarif__detail">{t.detail}</span>}
          </div>
        ))}
      </div>
      <p class="ic-engagement__mot">On entre quand on est prêt. Un appel d'abord, pour voir si c'est ton moment.</p>
      <div class="ic-engagement__action"><Appel pour="IN CARNE" centre /></div>
    </div>
  </section>

  <Faq faq={d.faq} />

  <BarreAction titre="IN CARNE" sous="4 mois · 3 places">
    <Appel pour="IN CARNE" secondaire={false} court />
  </BarreAction>

  <script is:inline>
    // Chaque élément se dévoile en arrivant à l'écran.
    (function () {
      var els = document.querySelectorAll('.ic-reveal');
      if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      els.forEach(function (el) { el.classList.add('ic-cache'); });
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('ic-vu'); io.unobserve(en.target); } });
      }, { rootMargin: '0px 0px -12% 0px' });
      els.forEach(function (el) { io.observe(el); });
    })();
  </script>
</Base>

<style is:global>
  /* ── IN CARNE : une descente de l'ombre vers la lumière ── */
  .ic-large { width: min(92%, 1000px); margin-inline: auto; }
  .ic-cache { opacity: 0; transform: translateY(22px); transition: opacity 1s ease, transform 1s cubic-bezier(.2,.7,.2,1); }
  .ic-cache.ic-vu { opacity: 1; transform: none; }

  /* 1. L'appel */
  .ic-appel { position: relative; min-height: 92svh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; overflow: hidden; background: #05070F; }
  .ic-appel__fond { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.5; filter: saturate(0.85) brightness(0.65); }
  .ic-appel::after { content: ''; position: absolute; inset: 0; background: radial-gradient(58% 48% at 50% 38%, rgba(216,162,76,0.22), transparent 72%), linear-gradient(to bottom, rgba(5,7,15,0.7), rgba(5,7,15,0.35) 45%, #050710 100%); }
  .ic-appel__contenu { position: relative; z-index: 2; padding: 0 22px; }
  .ic-sigil { width: clamp(76px, 10vw, 120px); height: auto; filter: drop-shadow(0 0 34px rgba(216,162,76,0.55)); }
  .ic-appel h1 { margin-top: 1.6rem; font-family: 'Jost', sans-serif; font-weight: 300; text-transform: uppercase; letter-spacing: 0.34em; font-size: clamp(2rem, 6vw, 3.6rem); color: var(--cream); }
  .ic-appel__sous { margin-top: 0.9rem; font-family: 'Jost', sans-serif; text-transform: uppercase; letter-spacing: 0.2em; font-size: 0.72rem; color: var(--gold); }
  .ic-appel__phrase { margin: 2.4rem auto 0; max-width: 30ch; font-family: 'EB Garamond', serif; font-size: clamp(1.3rem, 2.4vw, 1.75rem); line-height: 1.5; color: var(--cream); }
  .ic-scroll { position: absolute; bottom: 30px; z-index: 2; display: flex; align-items: center; gap: 12px; font-family: 'Jost', sans-serif; text-transform: uppercase; letter-spacing: 0.24em; font-size: 0.6rem; color: var(--muted); }
  .ic-scroll span { width: 1px; height: 34px; background: linear-gradient(to bottom, var(--gold), transparent); }

  /* 2. Le constat */
  .ic-constat { background: #050710; padding-block: clamp(6rem, 14vw, 12rem); }
  .ic-grand { max-width: 24ch; font-family: 'EB Garamond', serif; font-size: clamp(1.7rem, 4vw, 3rem); line-height: 1.25; color: var(--cream); }
  .ic-grand em { font-style: normal; color: var(--gold); }
  .ic-grand + .ic-grand { margin-top: clamp(4rem, 9vw, 7rem); }
  .ic-grand:nth-child(2) { margin-left: auto; text-align: right; }
  .ic-grand:nth-child(3) { margin-inline: auto; text-align: center; }

  /* Respiration */
  .ic-souffle { position: relative; min-height: 70svh; display: grid; place-items: center; overflow: hidden; }
  .ic-souffle img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: brightness(0.5); }
  .ic-souffle::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(5,7,16,0.85), rgba(5,7,16,0.35) 50%, rgba(10,15,32,0.95)); }
  .ic-souffle__mot { position: relative; z-index: 2; max-width: 22ch; text-align: center; font-family: 'Jost', sans-serif; font-weight: 300; font-style: italic; font-size: clamp(1.4rem, 3vw, 2.2rem); line-height: 1.45; color: var(--cream); padding: 0 22px; }
  .ic-souffle__mot .script { font-size: 1.9em; line-height: 0.95; }

  /* 3. Le récit */
  .ic-recit { background: var(--navy); padding-block: clamp(5rem, 11vw, 9rem); }
  .ic-recit__grille { width: min(92%, 1100px); margin-inline: auto; display: grid; grid-template-columns: 0.75fr 1.25fr; gap: clamp(2.4rem, 6vw, 5rem); align-items: start; }
  .ic-recit__photo img { width: 100%; border-radius: 18px; filter: saturate(0.9); }
  .ic-recit__texte { margin-top: 1.6rem; }
  .ic-recit__texte p { font-family: 'EB Garamond', serif; font-size: clamp(1.15rem, 1.6vw, 1.35rem); line-height: 1.7; color: var(--cream); }
  .ic-recit__texte p + p { margin-top: 1.3rem; }
  .ic-recit__texte strong { color: var(--gold); font-weight: 400; }
  @media (max-width: 820px) { .ic-recit__grille { grid-template-columns: 1fr; } .ic-recit__photo { max-width: 320px; } }

  /* 4. Le nom */
  .ic-nom { background: linear-gradient(to bottom, var(--navy), var(--navy2)); padding-block: clamp(5rem, 11vw, 9rem); text-align: center; }
  .ic-sigil--grand { width: clamp(110px, 14vw, 170px); margin-bottom: 1.8rem; }
  .ic-nom h2 { font-family: 'Jost', sans-serif; font-weight: 300; text-transform: uppercase; letter-spacing: 0.22em; font-size: clamp(1.4rem, 3vw, 2rem); color: var(--cream); }
  .ic-nom p { max-width: 54ch; margin: 1.6rem auto 0; font-family: 'EB Garamond', serif; font-size: clamp(1.15rem, 1.6vw, 1.35rem); line-height: 1.7; color: #C9CBD8; padding-inline: 22px; }
  .ic-nom strong { color: var(--gold); font-weight: 400; }

  /* 5. Les sept mouvements */
  .ic-roue { background: var(--navy2); padding-block: clamp(5rem, 11vw, 9rem); }
  .ic-roue h2, .ic-pieges h2, .ic-cadre h2, .ic-engagement h2 { margin-top: 0.6rem; }
  .ic-roue__intro { max-width: 48ch; margin-top: 1.4rem; color: #C9CBD8; line-height: 1.8; }
  .ic-mouvements { list-style: none; margin: clamp(3rem, 6vw, 4.5rem) 0 0; padding: 0; }
  .ic-mouvements li { display: grid; grid-template-columns: auto 1fr; gap: 0 clamp(1.4rem, 3vw, 2.4rem); position: relative; padding-bottom: clamp(2.4rem, 5vw, 3.4rem); }
  .ic-mouvements li::before { content: ''; position: absolute; left: 27px; top: 62px; bottom: 0; width: 1px; background: linear-gradient(to bottom, var(--teinte), transparent); opacity: 0.45; }
  .ic-mouvements li:last-child { padding-bottom: 0; }
  .ic-mouvements li:last-child::before { display: none; }
  .ic-mouvement__num { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; border: 1px solid var(--teinte); color: var(--teinte); font-family: 'Jost', sans-serif; font-size: 0.86rem; letter-spacing: 0.1em; box-shadow: 0 0 22px -6px var(--teinte); }
  .ic-mouvements h3 { font-family: 'EB Garamond', serif; font-weight: 400; font-size: clamp(1.5rem, 2.4vw, 1.95rem); color: var(--cream); }
  .ic-mouvement__posture { margin-top: 0.3rem; font-family: 'Jost', sans-serif; text-transform: uppercase; letter-spacing: 0.18em; font-size: 0.74rem; color: var(--teinte); }
  .ic-mouvement__question { margin-top: 0.8rem; max-width: 52ch; color: #C9CBD8; line-height: 1.75; font-size: 1.05rem; }
  .ic-roue__note { max-width: 52ch; margin: clamp(2.4rem, 5vw, 3.4rem) auto 0; text-align: center; font-family: 'EB Garamond', serif; font-style: italic; font-size: 1.15rem; line-height: 1.7; color: #C9CBD8; }

  /* 6. C'est pour toi si… : la phrase d'abord, le masque ensuite */
  .ic-pourtoi { background: var(--navy); padding-block: clamp(5rem, 11vw, 9rem); }
  .ic-pourtoi__liste { list-style: none; margin: clamp(2.4rem, 5vw, 3.4rem) 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.8rem, 4vw, 2.8rem) clamp(2.4rem, 6vw, 4rem); }
  .ic-pourtoi__liste li { position: relative; padding-left: 1.8rem; }
  .ic-pourtoi__liste li::before { content: ''; position: absolute; left: 0; top: 0.75em; width: 8px; height: 8px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 12px rgba(216,162,76,0.6); }
  .ic-pourtoi__liste p { font-family: 'EB Garamond', serif; font-size: clamp(1.2rem, 1.8vw, 1.42rem); line-height: 1.5; color: var(--cream); }
  .ic-masque { display: inline-block; margin-top: 0.6rem; font-family: 'Jost', sans-serif; text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.72rem; color: var(--coral); }
  .ic-pourtoi__note { max-width: 46ch; margin: clamp(2.4rem, 5vw, 3.2rem) auto 0; text-align: center; font-family: 'EB Garamond', serif; font-style: italic; font-size: 1.15rem; color: #C9CBD8; }
  @media (max-width: 760px) { .ic-pourtoi__liste { grid-template-columns: 1fr; } }

  /* 7. Le cadre */
  .ic-cadre { background: var(--navy2); padding-block: clamp(5rem, 11vw, 9rem); }
  .ic-cadre__grille { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: clamp(1.8rem, 4vw, 3rem); margin-top: clamp(2.4rem, 5vw, 3.4rem); }
  .ic-cadre__item h3 { font-family: 'EB Garamond', serif; font-weight: 400; font-size: 1.45rem; color: var(--cream); padding-bottom: 0.6rem; border-bottom: 1px solid var(--faint); margin-bottom: 0.7rem; }
  .ic-cadre__item p { color: #C9CBD8; line-height: 1.7; }
  .ic-cadre__note { max-width: 60ch; margin: clamp(2.4rem, 5vw, 3.4rem) auto 0; padding: 1.6rem 1.8rem; border-left: 2px solid var(--gold); background: rgba(216,162,76,0.06); border-radius: 0 14px 14px 0; color: var(--cream); line-height: 1.75; }
  .ic-cadre__note strong { color: var(--gold); font-weight: 400; }

  /* 8. Les traversées */
  .ic-traversees { background: var(--navy); padding-block: clamp(5rem, 11vw, 9rem); }
  .ic-traversees__grille { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: clamp(2rem, 5vw, 3.4rem); margin-top: 2.4rem; }
  .ic-traversees blockquote { margin: 0; font-family: 'EB Garamond', serif; font-style: italic; font-size: clamp(1.2rem, 1.8vw, 1.4rem); line-height: 1.6; color: var(--cream); }
  .ic-traversees figcaption { margin-top: 1rem; font-family: 'Jost', sans-serif; text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.74rem; color: var(--gold); }

  /* 9. L'engagement, la lumière */
  .ic-engagement { background: linear-gradient(to bottom, var(--navy2), #16204A); padding-block: clamp(5rem, 11vw, 9rem); text-align: center; }
  .ic-tarifs { display: flex; flex-wrap: wrap; justify-content: center; gap: clamp(1.4rem, 3vw, 2.4rem); margin-top: clamp(2.4rem, 5vw, 3.4rem); }
  .ic-tarif { min-width: 240px; padding: 2rem 2.2rem; border-radius: 20px; border: 1px solid var(--faint); background: rgba(10,15,32,0.35); display: flex; flex-direction: column; gap: 0.5rem; }
  .ic-tarif--avant { border-color: rgba(216,162,76,0.55); box-shadow: 0 0 40px -18px var(--gold); }
  .ic-tarif__label { font-family: 'Jost', sans-serif; text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.72rem; color: var(--gold); }
  .ic-tarif__prix { font-family: 'EB Garamond', serif; font-size: clamp(2rem, 4vw, 2.6rem); color: var(--cream); line-height: 1; }
  .ic-tarif__detail { font-size: 0.92rem; color: #C9CBD8; line-height: 1.6; max-width: 26ch; margin-inline: auto; }
  .ic-engagement__mot { max-width: 44ch; margin: clamp(2.4rem, 5vw, 3.2rem) auto 0; font-family: 'EB Garamond', serif; font-size: 1.25rem; line-height: 1.7; color: var(--cream); }
  .ic-engagement__action { display: flex; justify-content: center; margin-top: 2rem; }
</style>
