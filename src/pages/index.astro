---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const dates = (await getCollection('agenda'))
  .filter((e) => e.data.publie && e.data.date)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 3);
const fmt = (d) => new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);

const offres = [
  { t: 'Soins', s: "Massage à l'huile · Soin énergétique", img: '/img/tile-soins.jpg', href: '/soins' },
  { t: 'Accompagnement', s: 'Individuel · Collectif', img: '/img/tile-accompagnement.jpg', href: '/accompagnement' },
  { t: 'Ateliers & voyages sonores', s: 'Infloressence · Le Triangle', img: '/img/tile-ateliers.jpg', href: '/agenda' },
  { t: 'Indigo Enoqii', s: 'Peinture · Œuvres', img: '/img/tile-art.jpg', href: 'https://enoqii.art' },
];
const temoins = [
  { t: "Anys a su parfaitement m'accompagner dans la traversée du désert intérieur. Le cœur, la présence, la douceur, le non-jugement.", n: 'Sandrine', c: 'Retraite au désert marocain' },
  { t: "Son regard et son écoute m'ont reconnectée à la confiance en moi et en l'autre. Depuis 4 ans, nos rencontres jalonnent les moments cruciaux de ma vie.", n: 'Polette', c: 'Accompagnement individuel' },
  { t: "Un voyage où le temps s'arrête et le corps se libère. Des pratiques devenues des outils du quotidien.", n: 'Sonia', c: 'Ateliers Infloressence' },
];
---
<Base title="Anys Mechkar">
  <!-- HERO -->
  <section id="hero">
    <div class="hero-bg"><img src="/img/univers-art.jpg" alt="Œuvre d'Indigo Enoqii" /></div>
    <span class="dot" style="width:7px;height:7px;background:var(--coral);top:26%;right:8%"></span>
    <span class="dot" style="width:6px;height:6px;background:var(--blue);top:40%;right:16%;opacity:.9"></span>
    <span class="dot" style="width:4px;height:4px;background:var(--cream);top:52%;right:5%;opacity:.7"></span>
    <span class="dot" style="width:5px;height:5px;background:var(--gold);top:70%;right:24%;opacity:.6"></span>
    <div class="hero-left">
      <p class="eyebrow">Guide · Créateur · Initiateur</p>
      <div class="hero-name" style="margin-top:22px;"><span class="top">Révéler ta</span><span class="serif-i">couleur unique.</span></div>
      <p class="lead" style="margin-top:26px;">J'accompagne celles et ceux qui traversent un passage, par le corps, le mouvement et la création, depuis un espace de non-effort.</p>
      <a class="cta" href="/agenda" style="margin-top:36px;">Voir l'agenda <span class="line"></span></a>
    </div>
    <div class="hero-scroll"><span class="l"></span>Scroll</div>
  </section>

  <!-- PARCOURS / PROPOSE -->
  <section>
    <div class="wrap cols">
      <div class="col">
        <div class="num">01</div>
        <h2>Mon parcours</h2>
        <p class="muted">J'ai passé des années à construire. Puis quelque chose s'est mis à tirer de l'intérieur. La réponse est venue par le corps : le Butoh, les arts internes, la méditation, la peinture.</p>
        <a class="cta" href="/accompagnement" style="margin-top:22px;">En savoir plus <span class="line"></span></a>
      </div>
      <div class="col"><div class="mid-wrap"><img class="mid-img" src="/img/univers-mid.jpg" alt="Présence" /></div></div>
      <div class="col">
        <div class="num">02</div>
        <h2>Ce que je propose</h2>
        <div class="links-list">
          <a href="/soins">Soins</a>
          <a href="/accompagnement">Accompagnement</a>
          <a href="/agenda">Ateliers & voyages sonores</a>
          <a href="https://enoqii.art" target="_blank" rel="noopener">Indigo Enoqii</a>
        </div>
      </div>
    </div>
  </section>

  <!-- TUILES -->
  <section class="tiles" style="padding:0;">
    {offres.map((o) => (
      <a class="tile" href={o.href}>
        <img src={o.img} alt={o.t} />
        <div class="tile-body"><h3>{o.t}</h3><span>{o.s}</span><span class="arw">→</span></div>
      </a>
    ))}
  </section>

  <!-- AGENDA -->
  <section>
    <div class="wrap">
      <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:1rem;">
        <p class="eyebrow">Prochaines dates</p>
        <a class="cta" href="/agenda">Tout l'agenda <span class="line"></span></a>
      </div>
      <div style="margin-top:1.8rem;">
        {dates.length === 0 ? (
          <p class="muted">Les prochaines dates seront publiées ici.</p>
        ) : dates.map((e) => (
          <div class="evt">
            <div class="evt__date">{fmt(e.data.date)}</div>
            <div>
              <div class="evt__title">{e.data.titre}</div>
              <div class="evt__meta">{e.data.lieu}{e.data.lien && <> · <a href={e.data.lien}>{e.data.reservable ? 'Réserver' : 'En savoir plus'}</a></>}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TEMOIGNAGES (photo en fond, voile) -->
  <section class="temoins veil">
    <div class="veil-bg" style="background-image:url('/img/band.jpg')"></div>
    <div class="wrap">
      <p class="eyebrow">Traversées</p>
      <div class="grid">
        {temoins.map((x) => (
          <div class="temoin"><p>« {x.t} »</p><cite><b>{x.n}</b> — {x.c}</cite></div>
        ))}
      </div>
    </div>
  </section>

  <!-- PARTENAIRES -->
  <section>
    <div class="wrap">
      <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:1rem;">
        <p class="eyebrow">Partenaires</p>
        <a class="cta" href="/partenaires">Les découvrir <span class="line"></span></a>
      </div>
      <div class="parts">
        <div class="part"><div class="part__name">Meïsō</div><div class="part__desc">Flottaison et bien-être, Lyon.</div></div>
        <div class="part"><div class="part__name">Chanka Studio</div><div class="part__desc"><a href="https://chanka-studio-lyon.fr" target="_blank" rel="noopener">Arts et pratiques, Lyon.</a></div></div>
        <div class="part"><div class="part__name">Blast</div><div class="part__desc">Collectif artistique.</div></div>
        <div class="part"><div class="part__name">TAMAKEAPA</div><div class="part__desc">Partenaire.</div></div>
        <div class="part"><div class="part__name">Espriterre</div><div class="part__desc">Le travail d'Alex, en nature.</div></div>
      </div>
    </div>
  </section>
</Base>
