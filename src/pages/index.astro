---
// L'accueil se lit comme un chemin : l'appel → le guide → le monde → les seuils
// → les prochaines dates → les traversées → l'art → le Codex → l'invitation.
import Base from '../layouts/Base.astro';
import Sigils from '../components/Sigils.astro';
import Quete from '../components/Quete.astro';
import Contact from '../components/Contact.astro';
import { getCollection, getEntry } from 'astro:content';
import { codex, propositions, hrefAgenda, estExterne, ligneDate } from '../lib/monde';
import { UNIVERS, SEUILS, typeLabel } from '../lib/univers.mjs';
import { tisser, contexte } from '../lib/lore.mjs';

const acc = (await getEntry('pages', 'accueil'))!.data;
const fmt = (t) => (t || '').replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/\*(.+?)\*/g, '<span class="script">$1</span>');
const ctx = contexte();

const piliers = UNIVERS.map((u, i) => ({ ...u, nom: acc.piliers?.[i]?.nom ?? u.nom, note: acc.piliers?.[i]?.note ?? '' }));

const toutes = await propositions();
const seuils = SEUILS.map((s, i) => ({
  ...s,
  nom: acc.seuils?.[i]?.titre ?? s.nom,
  texte: acc.seuils?.[i]?.texte ?? '',
  items: toutes
    .filter((p) => p.seuil === s.id)
    .sort((a, b) => (a.date ? 0 : 1) - (b.date ? 0 : 1) || (a.date?.getTime() ?? 0) - (b.date?.getTime() ?? 0) || a.ordre - b.ordre),
}));

const aujourdhui = new Date(new Date().toDateString());
const dates = (await getCollection('agenda'))
  .filter((e) => e.data.publie && e.data.date && (e.data.date_fin ?? e.data.date) >= aujourdhui)
  .sort((a, b) => a.data.date!.getTime() - b.data.date!.getTime())
  .slice(0, 3);
const catLabels = { atelier: 'Atelier', 'voyage-sonore': 'Voyage sonore', retraite: 'Retraite', immersion: 'Immersion', residence: 'Résidence', cercle: 'Cercle', accompagnement: 'Accompagnement', soin: 'Soin' };

const temoins = acc.temoins ?? [];

const fiches = await codex();
const apercu = ['pratique', 'notion', 'rencontre', 'realisation'].flatMap((t) => fiches.filter((f) => f.data.type === t).slice(0, 2));
const allies = fiches.filter((f) => f.data.type === 'allie' && f.data.logo);
---
<Base title="Anys Mechkar — Présence, mouvement, créativité">
  <!-- L'APPEL -->
  <section id="hero">
    <div class="hero-bg"><img src={acc.hero_image ?? '/img/univers-art.jpg'} alt="Œuvre d'Indigo Enoqii" /></div>
    <div class="hero-left">
      <p class="eyebrow">{acc.hero_eyebrow}</p>
      <h1 class="hero-name" style="margin-top:14px;"><span class="top">{acc.hero_titre}</span><span class="serif-i script">{acc.hero_accent}</span></h1>
      <p class="lead" style="margin-top:18px;" set:html={fmt(acc.hero_paragraphe)}></p>
      <a class="cta" href="#seuils" style="margin-top:24px;">{acc.hero_cta} <span class="line"></span></a>
    </div>
    <div class="hero-scroll"><span class="l"></span>Scroll</div>
  </section>

  <!-- LE GUIDE -->
  <section>
    <div class="wrap split">
      <div class="photo">{acc.portrait_image ? <img class="slot-img" src={acc.portrait_image} alt="Anys Mechkar" /> : <div class="imgph"></div>}</div>
      <div>
        <h2 set:html={fmt(acc.parcours_titre)}></h2>
        <p class="muted" set:html={tisser(acc.parcours_texte, ctx)}></p>
        <a class="cta" href="/a-propos" style="margin-top:22px;">{acc.parcours_cta} <span class="line"></span></a>
      </div>
    </div>
  </section>

  <!-- LE MONDE : les cinq univers -->
  <section style="background:var(--surface);">
    <div class="wrap">
      <p class="eyebrow">{acc.piliers_eyebrow}</p>
      <h2 style="margin-top:0.8rem;" set:html={fmt(acc.piliers_titre)}></h2>
      <div class="piliers">
        {piliers.map((u) => (
          <a class="pilier" href={`/codex#${u.id}`}>
            <div class="pilier__icon"><Fragment set:html={u.icon} /></div>
            <div class="pilier__name">{u.nom}</div>
            <div class="pilier__desc">{u.note}</div>
            <span class="pilier__more">Explorer →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- RESPIRATION -->
  <section class="breath">{acc.resp1_image ? <img src={acc.resp1_image} alt="" /> : <div class="ph-band"></div>}<div class="phrase" set:html={fmt(acc.citation1)}></div></section>

  <!-- LES SEUILS -->
  <section id="seuils">
    <div class="wrap">
      <p class="eyebrow">{acc.seuils_eyebrow ?? 'Les seuils'}</p>
      <h2 style="margin-top:0.8rem;" set:html={fmt(acc.seuils_titre ?? 'Par où *entrer*')}></h2>
      <div class="seuils">
        {seuils.map((s) => (
          <div class="seuil">
            <span class="seuil__num">{s.num}</span>
            <h3 class="seuil__nom">{s.nom}</h3>
            <p class="seuil__format">{s.format}</p>
            {s.texte && <p class="seuil__texte" set:html={tisser(s.texte, ctx)}></p>}
            <div class="seuil__items">{s.items.map((p) => <Quete p={p} />)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCHAINES DATES -->
  {dates.length > 0 && (
    <section style="background:var(--surface);">
      <div class="wrap">
        <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:1rem;">
          <p class="eyebrow">{acc.agenda_eyebrow}</p>
          <a class="cta" href="/agenda">Voir tout l'agenda <span class="line"></span></a>
        </div>
        <div class="egrid">
          {dates.map((e) => (
            <a class="ecard" href={hrefAgenda(e)} target={estExterne(hrefAgenda(e)) ? '_blank' : undefined} rel="noopener">
              <div class="ecard__img">{e.data.image ? <img src={e.data.image} alt="" /> : <div class="imgph"></div>}<span class="ecard__tag">{catLabels[e.data.categorie] ?? e.data.categorie}</span></div>
              <div class="ecard__body">
                <div class="ecard__when">{ligneDate(e.data)}</div>
                <div class="ecard__title">{e.data.titre}</div>
                {e.data.resume && <div class="ecard__desc">{e.data.resume}</div>}
                {e.data.lieu && <div class="ecard__meta">{e.data.lieu}</div>}
                <div class="ecard__foot">
                  {e.data.prix && <span class="ecard__price">{e.data.prix}</span>}
                  {e.data.earlybird && <span class="ecard__early">Early bird jusqu’au {e.data.earlybird}</span>}
                </div>
                {e.data.reservable && <span class="ecard__btn">{e.data.cta ?? 'Réserver'}</span>}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- TRAVERSÉES -->
  {temoins.length > 0 && (
    <section class="temoins veil">
      <div class="veil-bg" style="background-image:url('/img/tex-cosmic.jpg')"></div>
      <div class="wrap">
        <p class="eyebrow">{acc.temoins_eyebrow}</p>
        <div class="grid">
          {temoins.map((x) => (<div class="temoin"><p>« {x.t} »</p><cite><b>{x.n}</b>{x.c && ` — ${x.c}`}</cite></div>))}
        </div>
      </div>
    </section>
  )}

  <!-- RESPIRATION vers l'art -->
  <section class="breath">{acc.resp2_image ? <img src={acc.resp2_image} alt="" /> : <div class="ph-band"></div>}<div class="phrase" set:html={fmt(acc.citation2)}></div></section>

  <!-- INDIGO ENOQII -->
  <section>
    <div class="wrap">
      <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:1rem;">
        <div><p class="eyebrow">{acc.art_eyebrow}</p><h2 style="margin-top:0.8rem;" set:html={fmt(acc.art_titre)}></h2></div>
        <a class="cta" href="https://enoqii.art" target="_blank" rel="noopener">Voir la boutique <span class="line"></span></a>
      </div>
      <p style="margin-top:1.4rem; color:#B9BCCB; max-width:60ch; line-height:1.9;" set:html={tisser("Je crée des œuvres vibratoires, alchimiques, pleines de vie. Nomade, amoureux du grand mystère, nourri d'innombrables explorations, mes œuvres encapsulent la quintessence de mes expériences initiatiques. Habité par un langage magique indéchiffrable par la raison, le tao, la calligraphie, les couleurs primaires, les éléments et le mouvement composent mes créations. Chaque performance est pensée comme un rituel, un acte psychomagique offert au monde pour relier le personnel à l'universel.", ctx)}></p>
      <div class="gallery" style="margin-top:2rem;">
        {[acc.art1_image, acc.art2_image, acc.art3_image, acc.art4_image].filter(Boolean).map((src) => <img class="slot-img" src={src} alt="Œuvre d'Indigo Enoqii" loading="lazy" />)}
      </div>
    </div>
  </section>

  <!-- LE CODEX -->
  <section style="background:var(--surface);">
    <div class="wrap">
      <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:1rem;">
        <div><p class="eyebrow">{acc.codex_eyebrow ?? 'Le Codex'}</p><h2 style="margin-top:0.8rem;" set:html={fmt(acc.codex_titre ?? 'Le paysage *intérieur*')}></h2></div>
        <a class="cta" href="/codex">Ouvrir le Codex <span class="line"></span></a>
      </div>
      {acc.codex_texte && <p class="muted" style="margin-top:1rem;">{acc.codex_texte}</p>}
      <div class="apercu">
        {apercu.map((f) => (
          <a class="fiche-row" href={`/codex/${f.id}`}>
            <span><span class="rune" style="display:block; margin-bottom:0.3rem;">{typeLabel(f.data.type)}</span><span class="fiche-row__titre">{f.data.titre}</span></span>
            <Sigils ids={f.data.univers} />
          </a>
        ))}
      </div>
      {allies.length > 0 && (
        <div style="margin-top:3rem;">
          <p class="rune">Les alliés</p>
          <div class="allies">
            {allies.map((a) => (
              <a class="allie" href={`/codex/${a.id}`}>
                <span class={`allie__logo${a.data.logo_blanc ? ' allie__logo--blanc' : ''}`}><img src={a.data.logo} alt="" loading="lazy" /></span>
                <span class="allie__nom">{a.data.titre}</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- L'INVITATION -->
  <section class="breath" style="min-height:38vh;">
    {acc.resp3_image ? <img src={acc.resp3_image} alt="" /> : <div class="ph-band"></div>}
    <div class="phrase">{acc.citation_contact}</div>
  </section>

  <section id="contact">
    <div class="narrow">
      <p class="eyebrow">{acc.form_eyebrow}</p>
      <h2 set:html={fmt(acc.form_titre)}></h2>
      <p class="lead" style="margin-top:0.8rem;">{acc.form_intro}</p>
      <Contact />
    </div>
  </section>
</Base>
