---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const dates = (await getCollection('agenda'))
  .filter((e) => e.data.publie && e.data.date)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 3);
const fmt = (d) => new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);

const univers = [
  { t: 'Soins', img: '/img/u-soin.jpg', href: '/soins', rev: false,
    d: "Massage à l'huile et soin énergétique. Un temps pour le corps, où le toucher redonne de l'espace et de la présence." },
  { t: 'Accompagnement', img: '/img/u-accompagnement.jpg', href: '/accompagnement', rev: true,
    d: "Un chemin en individuel, ou un cheminement à plusieurs. Traverser un passage et retrouver sa direction, à son rythme." },
  { t: 'Immersions & retraites', img: '/img/u-immersion.jpg', href: '/agenda', rev: false,
    d: "Des expériences longues, en présence, du désert marocain aux retraites d'hommes. Se déposer loin du quotidien." },
  { t: 'Ateliers & voyages sonores', img: '/img/u-atelier.jpg', href: '/agenda', rev: true,
    d: "Infloressence à Chanka Studio, méditation, Butoh et son. Et les voyages sonores immersifs, dont Le Triangle." },
];
const temoins = [
  { t: "Anys a su parfaitement m'accompagner dans la traversée du désert intérieur. Le cœur, la présence, la douceur, le non-jugement.", n: 'Sandrine', c: 'Retraite au désert marocain' },
  { t: "Son regard et son écoute m'ont reconnectée à la confiance en moi et en l'autre. Depuis 4 ans, nos rencontres jalonnent les moments cruciaux de ma vie.", n: 'Polette', c: 'Accompagnement individuel' },
  { t: "Un voyage où le temps s'arrête et le corps se libère. Des pratiques devenues des outils du quotidien.", n: 'Sonia', c: 'Ateliers Infloressence' },
];
const partenaires = [
  { n: 'Meïsō', img: '/img/meiso-photo.jpg', logo: '/img/logo-meiso.png', d: 'Centre de flottaison et de bien-être, à Lyon.' },
  { n: 'Chanka Studio', img: '/img/u-atelier.jpg', logo: '/img/logo-chanka.svg', d: "Studio d'arts et de pratiques, où se tiennent les ateliers Infloressence.", lien: 'https://chanka-studio-lyon.fr' },
  { n: 'Blast', img: '/img/blast.jpg', d: 'Collectif artistique.' },
  { n: 'TAMAKEAPA', img: '/img/breath-desert.jpg', logo: '/img/logo-partner-white.png', d: 'Partenaire.' },
  { n: 'Espriterre', img: '/img/u-soin.jpg', d: "Le travail d'Alex, en nature." },
];
---
<Base title="Anys Mechkar">
  <!-- HERO -->
  <section id="hero">
    <div class="hero-bg"><img src="/img/univers-art.jpg" alt="Œuvre d'Indigo Enoqii" /></div>
    <span class="dot" style="width:7px;height:7px;background:var(--coral);top:26%;right:8%"></span>
    <span class="dot" style="width:6px;height:6px;background:var(--blue);top:40%;right:16%;opacity:.9"></span>
    <span class="dot" style="width:4px;height:4px;background:var(--cream);top:52%;right:5%;opacity:.7"></span>
    <span class="dot" style="width:5px;height:5px;background:var(--gold);top:70%;right:24%;opacity:.6"></span>
    <div class="hero-left">
      <p class="eyebrow">Guide · Créateur · Initiateur</p>
      <div class="hero-name" style="margin-top:22px;"><span class="top">Révéler ta</span><span class="serif-i">couleur unique.</span></div>
      <p class="lead" style="margin-top:26px;">J'accompagne celles et ceux qui traversent un passage, par le corps, le mouvement et la création, depuis un espace de non-effort.</p>
      <a class="cta" href="/agenda" style="margin-top:36px;">Voir l'agenda <span class="line"></span></a>
    </div>
    <div class="hero-scroll"><span class="l"></span>Scroll</div>
  </section>

  <!-- PARCOURS -->
  <section>
    <div class="wrap split">
      <div class="photo"><img src="/img/portrait.jpg" alt="Anys Mechkar" /></div>
      <div>
        <div class="num">01</div>
        <h2>Mon parcours</h2>
        <p class="muted">J'ai passé des années à construire. Puis quelque chose s'est mis à tirer de l'intérieur. La réponse est venue par le corps : le Butoh, les arts internes, la méditation, la peinture. Aujourd'hui, j'accompagne celles et ceux qui sentent le même appel.</p>
        <a class="cta" href="/accompagnement" style="margin-top:22px;">En savoir plus <span class="line"></span></a>
      </div>
    </div>
  </section>

  <div class="star-div"><span></span><img src="/img/logo.png" alt="" /><span></span></div>

  <!-- RESPIRATION -->
  <section class="breath"><img src="/img/breath-desert.jpg" alt="" /><div class="phrase">Là où le paysage devient intérieur.</div></section>

  <!-- LES UNIVERS -->
  <section style="padding-bottom:0;">
    <div class="wrap"><p class="eyebrow">Les univers</p><h2 style="margin-top:0.8rem;">Ce que je propose</h2></div>
  </section>
  {univers.map((u) => (
    <section class={`univers${u.rev ? ' rev' : ''}`} style="padding:0;">
      <div class="univers__img"><img src={u.img} alt={u.t} /></div>
      <div class="univers__body">
        <div class="num">→</div>
        <h2>{u.t}</h2>
        <p>{u.d}</p>
        <a class="cta" href={u.href}>Découvrir <span class="line"></span></a>
      </div>
    </section>
  ))}

  <!-- RESPIRATION vers l'art -->
  <section class="breath"><img src="/img/breath-art.jpg" alt="" /><div class="phrase">La couleur est un langage. La mienne parle en indigo.</div></section>

  <!-- INDIGO ENOQII -->
  <section>
    <div class="wrap">
      <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:1rem;">
        <div><p class="eyebrow">Indigo Enoqii</p><h2 style="margin-top:0.8rem;">Mon univers artistique</h2></div>
        <a class="cta" href="https://enoqii.art" target="_blank" rel="noopener">La boutique <span class="line"></span></a>
      </div>
      <div class="gallery">
        <img src="/img/art-1.jpg" alt="Œuvre" /><img src="/img/art-2.jpg" alt="Œuvre" /><img src="/img/art-3.jpg" alt="Œuvre" /><img src="/img/art-4.jpg" alt="Œuvre" />
      </div>
    </div>
  </section>

  <div class="star-div"><span></span><img src="/img/logo.png" alt="" /><span></span></div>

  <!-- AGENDA -->
  <section style="padding-top:0;">
    <div class="wrap">
      <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:1rem;">
        <p class="eyebrow">Prochaines dates</p>
        <a class="cta" href="/agenda">Tout l'agenda <span class="line"></span></a>
      </div>
      <div style="margin-top:1.8rem;">
        {dates.length === 0 ? (<p class="muted">Les prochaines dates seront publiées ici.</p>)
        : dates.map((e) => (
          <div class="evt">
            <div class="evt__date">{fmt(e.data.date)}</div>
            <div><div class="evt__title">{e.data.titre}</div>
              <div class="evt__meta">{e.data.lieu}{e.data.lien && <> · <a href={e.data.lien}>{e.data.reservable ? 'Réserver' : 'En savoir plus'}</a></>}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TEMOIGNAGES -->
  <section class="temoins veil">
    <div class="veil-bg" style="background-image:url('/img/u-immersion.jpg')"></div>
    <div class="wrap">
      <p class="eyebrow">Traversées</p>
      <div class="grid">
        {temoins.map((x) => (<div class="temoin"><p>« {x.t} »</p><cite><b>{x.n}</b> — {x.c}</cite></div>))}
      </div>
    </div>
  </section>

  <!-- PARTENAIRES -->
  <section>
    <div class="wrap">
      <p class="eyebrow">Partenaires</p>
      <div class="parts">
        {partenaires.map((p) => (
          <div class="part">
            <div class="part__media"><img src={p.img} alt={p.n} />{p.logo && <img class="part__logo" src={p.logo} alt={p.n} />}</div>
            <div class="part__name">{p.n}</div>
            <div class="part__desc">{p.lien ? <a href={p.lien} target="_blank" rel="noopener">{p.d}</a> : p.d}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="breath" style="min-height:38vh;">
    <img src="/img/hero.jpg" alt="" />
    <div class="phrase" style="display:flex;flex-direction:column;align-items:center;gap:1.6rem;">
      Un premier pas ?
      <a class="btn" href="mailto:contact@anysmechkar.com" style="font-style:normal;">Écrire à Anys</a>
    </div>
  </section>
</Base>
