---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const dates = (await getCollection('agenda'))
  .filter((e) => e.data.publie && e.data.date)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 4);
const fmt = (d) => new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);

const temoins = [
  { t: "Anys a su parfaitement m'accompagner dans la traversée du désert intérieur. Le cœur, la présence, la douceur, le non-jugement.", n: 'Sandrine', c: 'Retraite au désert marocain' },
  { t: "Son regard et son écoute m'ont reconnectée à la confiance en moi et en l'autre. Depuis 4 ans, nos rencontres jalonnent les moments cruciaux de ma vie.", n: 'Polette', c: 'Accompagnement individuel' },
  { t: "Un voyage où le temps s'arrête et le corps se libère. Des pratiques devenues des outils du quotidien.", n: 'Sonia', c: 'Ateliers Infloressence' },
];
---
<Base title="Anys Mechkar">
  <!-- HERO -->
  <section class="hero" style="background-image: url('/img/hero.jpg');">
    <div class="wrap">
      <p class="eyebrow">Guide · Créateur · Initiateur</p>
      <h1 style="max-width: 12ch; margin-top: 1.6rem;">Révéler ta couleur unique.</h1>
      <p class="lead" style="margin-top: 2rem;">Par le corps, le mouvement, la création, depuis un espace de non-effort.</p>
      <div style="margin-top: 2.6rem; display:flex; gap: 1rem; flex-wrap: wrap;">
        <a class="btn btn--solid" href="/agenda">Voir l'agenda</a>
        <a class="btn" href="/soins">Les soins</a>
      </div>
    </div>
  </section>

  <!-- PRESENTATION avec photo -->
  <section style="background: var(--surface);">
    <div class="wrap split">
      <div class="photo"><img src="/img/portrait.jpg" alt="Portrait d'Anys Mechkar" width="1000" height="1250" loading="lazy" /></div>
      <div>
        <p class="eyebrow" style="margin-bottom: 1.2rem;">Qui je suis</p>
        <p>J'ai passé des années à construire. Des produits, des systèmes, une vie qui avait l'air d'aller. Puis quelque chose s'est mis à tirer de l'intérieur.</p>
        <p>La réponse est venue par le corps. Le Butoh, les arts internes, la méditation, la peinture. Des pratiques qui ne m'ont pas appris à faire mieux, mais à me souvenir de ce que j'étais déjà.</p>
        <p>Aujourd'hui, j'accompagne celles et ceux qui sentent le même appel. Par des soins, un cheminement individuel ou collectif, et des expériences qui se vivent en présence.</p>
      </div>
    </div>
  </section>

  <!-- OFFRES -->
  <section>
    <div class="wrap">
      <p class="eyebrow">Ce que je propose</p>
      <div class="offres" style="margin-top: 2.6rem;">
        <div class="offre">
          <h3>Soins</h3>
          <p>Massage à l'huile et soin énergétique. Un temps pour le corps.</p>
          <a href="/soins">Découvrir</a>
        </div>
        <div class="offre">
          <h3>Accompagnement</h3>
          <p>Un chemin en individuel, ou un cheminement à plusieurs.</p>
          <a href="/accompagnement">En savoir plus</a>
        </div>
        <div class="offre">
          <h3>Ateliers et voyages sonores</h3>
          <p>Infloressence à Chanka Studio, et les voyages sonores.</p>
          <a href="/agenda">Voir les dates</a>
        </div>
      </div>
    </div>
  </section>

  <!-- AGENDA -->
  <section style="background: var(--surface);">
    <div class="wrap">
      <div style="display:flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 1rem;">
        <p class="eyebrow" style="margin:0;">Prochaines dates</p>
        <a href="/agenda" style="color: var(--ochre); border-bottom: 1px solid var(--faint); padding-bottom: 2px;">Tout l'agenda</a>
      </div>
      <div style="margin-top: 2rem;">
        {dates.length === 0 ? (
          <p class="muted">Les prochaines dates seront publiées ici.</p>
        ) : dates.map((e) => (
          <div class="evt">
            <div class="evt__date">{fmt(e.data.date)}</div>
            <div>
              <div class="evt__title">{e.data.titre}</div>
              <div class="evt__meta">
                {e.data.lieu}
                {e.data.lien && <> · <a href={e.data.lien}>{e.data.reservable ? 'Réserver' : 'En savoir plus'}</a></>}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- AMBIANCE -->
  <section class="band" style="background-image: url('/img/band.jpg');" aria-hidden="true"></section>

  <!-- TEMOIGNAGES -->
  <section class="temoins">
    <div class="wrap">
      <p class="eyebrow">Traversées</p>
      <div class="grid">
        {temoins.map((x) => (
          <div class="temoin">
            <p>« {x.t} »</p>
            <cite><b>{x.n}</b><br />{x.c}</cite>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PARTENAIRES -->
  <section>
    <div class="wrap">
      <p class="eyebrow">Partenaires</p>
      <div class="parts">
        <div class="part"><div class="part__name">Meïsō</div><div class="part__desc">Flottaison et bien-être, Lyon.</div></div>
        <div class="part"><div class="part__name">Chanka Studio</div><div class="part__desc"><a href="https://chanka-studio-lyon.fr" target="_blank" rel="noopener">Arts et pratiques, Lyon.</a></div></div>
        <div class="part"><div class="part__name">Blast</div><div class="part__desc">Collectif artistique.</div></div>
        <div class="part"><div class="part__name">TAMAKEAPA</div><div class="part__desc">Partenaire.</div></div>
        <div class="part"><div class="part__name">Espriterre</div><div class="part__desc">Le travail d'Alex, en nature.</div></div>
      </div>
    </div>
  </section>

  <!-- ART -->
  <section style="background: var(--surface);">
    <div class="wrap">
      <div style="display:flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 1rem;">
        <div>
          <p class="eyebrow">Indigo Enoqii</p>
          <h2 style="margin-top: 0.8rem;">Mon univers artistique</h2>
        </div>
        <a class="btn" href="https://enoqii.art" target="_blank" rel="noopener">La boutique</a>
      </div>
      <div class="gallery">
        <img src="/img/art-1.jpg" alt="Œuvre d'Indigo Enoqii" width="900" height="900" loading="lazy" />
        <img src="/img/art-2.jpg" alt="Œuvre d'Indigo Enoqii" width="900" height="900" loading="lazy" />
        <img src="/img/art-3.jpg" alt="Œuvre d'Indigo Enoqii" width="900" height="900" loading="lazy" />
        <img src="/img/art-4.jpg" alt="Œuvre d'Indigo Enoqii" width="900" height="900" loading="lazy" />
      </div>
    </div>
  </section>
</Base>
