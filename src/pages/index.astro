---
import Base from '../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';

const acc = (await getEntry('pages', 'accueil')).data;
const fmt = (t) => (t || '').replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/\*(.+?)\*/g, '<span class="script">$1</span>');
const events = (await getCollection('agenda')).filter((e) => e.data.publie);
const dated = events.filter((e) => e.data.date).sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const recurring = events.filter((e) => !e.data.date).sort((a, b) => a.data.ordre - b.data.ordre);
const homeEvents = [...dated, ...recurring].slice(0, 4);
const catLabels = { atelier: 'Atelier', 'voyage-sonore': 'Voyage sonore', retraite: 'Retraite', immersion: 'Immersion', residence: 'Résidence', cercle: 'Cercle', accompagnement: 'Accompagnement', soin: 'Soin' };
const accentDernier = (t) => {
  const w = t.trim().split(/\s+/);
  if (w.length < 2) return t.replace(/&/g, '&amp;');
  const last = w.pop();
  return w.join(' ').replace(/&/g, '&amp;') + ' <span class="script">' + last.replace(/&/g, '&amp;') + '</span>';
};
const dparts = (d) => ({ day: d.getDate(), mon: new Intl.DateTimeFormat('fr-FR', { month: 'short' }).format(d).replace('.', ''), yr: d.getFullYear() });
function ligneDate(d) {
  if (!d.date) return (d.rythme ?? 'Sur inscription');
  const fmt = (x) => new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' }).format(x).replace('.', '');
  if (d.date_fin) {
    const j = Math.round((d.date_fin.getTime() - d.date.getTime()) / 86400000) + 1;
    const same = d.date.getMonth() === d.date_fin.getMonth() && d.date.getFullYear() === d.date_fin.getFullYear();
    const dd = (x) => x.getDate();
    const mo = (x) => new Intl.DateTimeFormat('fr-FR', { month: 'short' }).format(x).replace('.', '');
    const moy = (x) => new Intl.DateTimeFormat('fr-FR', { month: 'short', year: 'numeric' }).format(x).replace('.', '');
    const r = same ? `Du ${dd(d.date)} au ${dd(d.date_fin)} ${moy(d.date_fin)}` : `Du ${dd(d.date)} ${mo(d.date)} au ${dd(d.date_fin)} ${moy(d.date_fin)}`;
    return `${r} · ${j} jours`;
  }
  return fmt(d.date) + (d.heure ? ` · ${d.heure}` : '');
}

const univers = [
  { t: 'La présence', p: 'Méditation, souffle, immobilité', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="12" cy="12" r="3"/><circle cx="12" cy="12" r="8" opacity="0.4"/></svg>' },
  { t: 'La connaissance de soi', p: 'Archétypes · Human Design · Tzolk\u2019in · BaZi', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"><path d="M12 3l2.1 6.1L20 11l-5.9 1.9L12 19l-2.1-6.1L4 11l5.9-1.9z"/></svg>' },
  { t: 'Le mouvement', p: 'Danse Butoh · Kung-fu · mouvement naturel', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"><path d="M3 15c3 0 3-6 6-6s3 6 6 6 3-6 6-6"/></svg>' },
  { t: 'Le lien au vivant', p: 'Chamanisme · peuples indigènes · sagesses ancestrales', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21v-8"/><path d="M12 13c0-3.5 2.3-5.5 6.5-5.5C18.5 12 16 14 12 13z"/><path d="M12 16c0-2.5-2.1-4.5-5.5-4.5C6.5 15.5 8.6 17 12 16z"/></svg>' },
  { t: 'L\u2019art et l\u2019expression créative', p: 'Danse · musique · peinture', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M15 4l5 5-9 9H6v-5z"/><path d="M12 7l5 5"/></svg>' },
];
const propositions = [
  { t: 'Ateliers', handle: 'ACCUEIL-ATELIERS', img: '/img/u-atelier.jpg', href: '/agenda', rev: false, cta: 'Voir les ateliers',
    d: "Ce qui transforme, c'est la régularité. Des ateliers de présence, de mouvement, de méditation, de connaissance de soi et de créativité, et des voyages sonores. Autant de portes pour revenir au corps et s'y ancrer dans la durée." },
  { t: 'Soins', handle: 'ACCUEIL-SOINS', img: '/img/u-soin.jpg', href: '/soins', rev: true, cta: 'Découvrir les soins',
    d: "Un temps pour relâcher, harmoniser et remettre du mouvement là où la vie s'est figée. Pour traverser une fatigue, un passage, une transformation, en étant accompagné dans le corps." },
  { t: 'Accompagnement', handle: 'ACCUEIL-ACCOMP', img: '/img/portrait.jpg', href: '/accompagnement', rev: false, cta: 'Découvrir l\u2019accompagnement',
    d: "Un cheminement individuel pour clarifier une transition, retrouver son axe et incarner un projet qui te ressemble. Avec, si tu le souhaites, la lecture de ton dessin originel." },
  { t: 'Immersions & retraites', handle: 'ACCUEIL-IMMERSIONS', img: '/img/u-immersion.jpg', href: '/agenda', rev: true, cta: 'Voir les immersions',
    d: "De vraies initiations, hors du quotidien, pour se déposer en profondeur et revenir à l'essentiel. Retraites d'hommes, désert marocain, cercles au cœur du vivant." },
];
const props = propositions.map((p, i) => ({ ...p, t: acc.propositions?.[i]?.titre ?? p.t, d: acc.propositions?.[i]?.texte ?? p.d, cta: acc.propositions?.[i]?.cta ?? p.cta, image: acc.propositions?.[i]?.image ?? null }));
const temoins = [
  { t: "Un voyage à la fois sonore et poétique, là où le temps s'arrête, le corps se libère et l'esprit se volatilise. Ces pratiques sont devenues de véritables outils qui me servent au quotidien et qui me permettent de me reconnecter avec moi-même. J'en ressors à chaque fois légère, ancrée et ressourcée.", n: 'Sonia', c: 'Ateliers Infloressence' },
  { t: "Anys a su parfaitement m'accompagner dans la traversée du désert intérieur. Le cœur, la présence, la douceur, le non-jugement.", n: 'Sandrine', c: 'Retraite au désert marocain' },
  { t: "Son regard et son écoute m'ont reconnectée à la confiance en moi et en l'autre. Depuis 4 ans, nos rencontres jalonnent les moments cruciaux de ma vie.", n: 'Polette', c: 'Accompagnement individuel' },
];
const partenaires = (await getEntry('pages', 'partenaires')).data.partenaires;
---
<Base title="Anys Mechkar">
  <!-- HERO -->
  <section id="hero">
    <div class="hero-bg"><img src={acc.hero_image ?? "/img/univers-art.jpg"} alt="Œuvre d'Indigo Enoqii" /></div>
    <span class="dot" style="width:7px;height:7px;background:var(--coral);top:26%;right:8%"></span>
    <span class="dot" style="width:6px;height:6px;background:var(--blue);top:40%;right:16%;opacity:.9"></span>
    <span class="dot" style="width:5px;height:5px;background:var(--gold);top:70%;right:24%;opacity:.6"></span>
    <div class="hero-left">
      <p class="eyebrow">{acc.hero_eyebrow}</p>
      <div class="hero-name" style="margin-top:14px;"><span class="top">{acc.hero_titre}</span><span class="serif-i script">{acc.hero_accent}</span></div>
      <p class="lead" style="margin-top:18px;" set:html={fmt(acc.hero_paragraphe)}></p>
      <a class="cta" href="/agenda" style="margin-top:24px;">Voir les prochains événements <span class="line"></span></a>
    </div>
    <div class="hero-scroll"><span class="l"></span>Scroll</div>
  </section>

  <!-- MON PARCOURS (teaser) -->
  <section>
    <div class="wrap split">
      <div class="photo">{acc.portrait_image ? <img class="slot-img" src={acc.portrait_image} alt="" /> : <div class="imgph"><span>ACCUEIL-PORTRAIT</span></div>}</div>
      <div>
        <h2>Qui je <span class="script">suis</span></h2>
        <p class="muted">Ancien ingénieur informatique, je me suis réveillé à 28 ans en prenant conscience que je n'avais jamais vraiment choisi ma vie. Ça a été le début d'une longue quête, de la méditation au chamanisme, du Butoh aux arts énergétiques. Aujourd'hui, j'accompagne celles et ceux qui sentent le même appel.</p>
        <a class="cta" href="/a-propos" style="margin-top:22px;">Lire mon histoire <span class="line"></span></a>
      </div>
    </div>
  </section>

  <!-- LES UNIVERS (piliers) -->
  <section style="background:var(--surface);">
    <div class="wrap">
      <p class="eyebrow">Les univers</p>
      <h2 style="margin-top:0.8rem;" set:html={fmt(acc.piliers_titre)}></h2>
      <div class="piliers">
        {univers.map((u) => (
          <div class="pilier">
            <div class="pilier__icon"><Fragment set:html={u.icon} /></div>
            <div class="pilier__name">{u.t}</div>
            <div class="pilier__desc">{u.p}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- RESPIRATION -->
  <section class="breath">{acc.resp1_image ? <img src={acc.resp1_image} alt="" /> : <div class="ph-band" data-h="RESP-01"></div>}<div class="phrase" set:html={fmt(acc.citation1)}></div></section>

  <!-- LES PROPOSITIONS -->
  <section style="padding-bottom:0;">
    <div class="wrap"><p class="eyebrow">Les propositions</p><h2 style="margin-top:0.8rem;" set:html={fmt(acc.propositions_titre)}></h2></div>
  </section>
  {props.map((u) => (
    <section class={`univers${u.rev ? ' rev' : ''}`} style="padding:0;">
      <div class="univers__img"><div class="imgph"><span>{u.handle}</span></div></div>
      <div class="univers__body">
        <h2>{u.t}</h2>
        <p>{u.d}</p>
        <a class="cta" href={u.href}>{u.cta} <span class="line"></span></a>
      </div>
    </section>
  ))}

  <!-- AGENDA -->
  <section style="background:var(--surface);">
    <div class="wrap">
      <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:1rem;">
        <p class="eyebrow">Prochaines dates</p>
        <a class="cta" href="/agenda">Voir tout l'agenda <span class="line"></span></a>
      </div>
      <div class="egrid">
        {homeEvents.map((e) => (
          <a class="ecard" href={e.data.site ?? `/agenda/${e.id}`} target={e.data.site && e.data.site.startsWith('http') ? '_blank' : undefined} rel="noopener">
            <div class="ecard__img">{e.data.image ? <img src={e.data.image} alt={e.data.titre} /> : <div class="imgph"><span>{e.id}</span></div>}<span class="ecard__tag">{catLabels[e.data.categorie] ?? e.data.categorie}</span></div>
            <div class="ecard__body">
              <div class="ecard__when">{ligneDate(e.data)}</div>
              <div class="ecard__title">{e.data.titre}</div>
              {e.data.resume && <div class="ecard__desc">{e.data.resume}</div>}
              {e.data.lieu && <div class="ecard__meta">{e.data.lieu}</div>}
              <div class="ecard__foot">
                {e.data.prix && <span class="ecard__price">{e.data.prix}</span>}
                {e.data.earlybird && <span class="ecard__early">Early bird jusqu’au {e.data.earlybird}</span>}
              </div>
              {e.data.reservable && <span class="ecard__btn">{e.data.cta ?? 'Réserver'}</span>}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- RESPIRATION vers l'art -->
  <section class="breath">{acc.resp2_image ? <img src={acc.resp2_image} alt="" /> : <div class="ph-band" data-h="RESP-02"></div>}<div class="phrase" set:html={fmt(acc.citation2)}></div></section>

  <!-- INDIGO ENOQII -->
  <section>
    <div class="wrap">
      <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:1rem;">
        <div><p class="eyebrow">Indigo Enoqii</p><h2 style="margin-top:0.8rem;">Mon univers <span class="script">artistique</span></h2></div>
        <a class="cta" href="https://enoqii.art" target="_blank" rel="noopener">Voir la boutique <span class="line"></span></a>
      </div>
      <p style="margin-top:1.4rem; color:#B9BCCB; max-width:60ch; line-height:1.9;">Je crée des œuvres vibratoires, alchimiques, pleines de vie. Nomade, amoureux du grand mystère, nourri d'innombrables explorations, mes œuvres encapsulent la quintessence de mes expériences initiatiques. Habité par un langage magique indéchiffrable par la raison, le tao, la calligraphie, les couleurs primaires, les éléments et le mouvement composent mes créations. Chaque performance est pensée comme un rituel, un acte psychomagique offert au monde pour relier le personnel à l'universel.</p>
      <div class="gallery" style="margin-top:2rem;">
        {acc.art1_image ? <img class="slot-img" src={acc.art1_image} alt="" /> : <div class="imgph"><span>ART-01</span></div>}{acc.art2_image ? <img class="slot-img" src={acc.art2_image} alt="" /> : <div class="imgph"><span>ART-02</span></div>}{acc.art3_image ? <img class="slot-img" src={acc.art3_image} alt="" /> : <div class="imgph"><span>ART-03</span></div>}{acc.art4_image ? <img class="slot-img" src={acc.art4_image} alt="" /> : <div class="imgph"><span>ART-04</span></div>}
      </div>
    </div>
  </section>

  <!-- TEMOIGNAGES -->
  <section class="temoins veil">
    <div class="veil-bg" style="background-image:url('/img/tex-cosmic.jpg')"></div>
    <div class="wrap">
      <p class="eyebrow">Traversées</p>
      <div class="grid">
        {temoins.map((x) => (<div class="temoin"><p>« {x.t} »</p><cite><b>{x.n}</b> — {x.c}</cite></div>))}
      </div>
    </div>
  </section>

  <!-- PARTENAIRES -->
  <section style="background:var(--surface);">
    <div class="wrap">
      <p class="eyebrow">Partenaires</p>
      <div class="parts">
        {partenaires.map((p) => (
          <div class="part">
            <div class="part__media">{p.image ? <img class="slot-img" src={p.image} alt={p.n} /> : <div class="imgph"><span>{p.handle}</span></div>}{p.logo && <img class={`part__logo${p.logoWhite ? ' part__logo--white' : ''}`} src={p.logo} alt={p.n} />}</div>
            <div class="part__name">{p.n}</div>
            <div class="part__desc">{p.lien ? <a href={p.lien} target="_blank" rel="noopener">{p.d}</a> : p.d}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="breath" style="min-height:38vh;">
    {acc.resp3_image ? <img src={acc.resp3_image} alt="" /> : <div class="ph-band" data-h="RESP-03"></div>}
    <div class="phrase">{acc.citation_contact}</div>
  </section>

  <!-- FORMULAIRE DE CONTACT -->
  <section id="contact">
    <div class="narrow">
      <p class="eyebrow">Contact</p>
      <h2 set:html={fmt(acc.form_titre)}></h2>
      <p class="lead" style="margin-top:0.8rem;">{acc.form_intro}</p>
      <form class="form" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/merci" style="margin-top:1.8rem;">
        <input type="hidden" name="form-name" value="contact" />
        <p hidden><label>Ne pas remplir <input name="bot-field" /></label></p>
        <div><label>Ton nom</label><input type="text" name="nom" required /></div>
        <div><label>Ton email</label><input type="email" name="email" required /></div>
        <div><label>Ce qui t'intéresse</label><select name="interet"><option>Un soin</option><option>Un accompagnement</option><option>Un atelier ou un événement</option><option>Autre chose</option></select></div>
        <div><label>Ton message</label><textarea name="message"></textarea></div>
        <button class="btn btn--solid" type="submit" style="justify-self:start;">Envoyer</button>
      </form>
    </div>
  </section>
</Base>
