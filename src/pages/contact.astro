---
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import { getEntry } from 'astro:content';
const cc = (await getEntry('pages', 'contact'))!.data;
---
<Base title="Contact — Anys Mechkar" description="Écris-moi : une question, une envie, un premier pas.">
  <section class="page-hero" style="min-height:34vh;">{cc.hero_image ? <img src={cc.hero_image} alt="" /> : <div class="ph-band"></div>}
    <div class="narrow"><p class="eyebrow">{cc.hero_eyebrow}</p><h1>{cc.hero_titre}</h1></div>
  </section>
  <section>
    <div class="narrow">
      <p class="lead">{cc.intro}</p>
      <Contact />
      {cc.appel_lien && (
        <div id="appel" style="margin-top:3.2rem;">
          <p class="eyebrow">{cc.appel_eyebrow}</p>
          <p class="muted" style="margin-top:0.9rem;">{cc.appel_texte}</p>
          <a class="btn" href={cc.appel_lien} target="_blank" rel="noopener" style="margin-top:1.1rem;">{cc.appel_cta}</a>
        </div>
      )}
    </div>
  </section>
</Base>
