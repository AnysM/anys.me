---
// La page des œuvres. Son travail n'est pas d'exposer un catalogue — il n'y a
// qu'une fiche pour l'instant — mais de donner envie : on traverse l'univers,
// on va voir le portfolio, on s'abonne pour la suite. Les toiles s'intercalent
// donc dans le texte plutôt que de l'attendre après.
import Base from '../../layouts/Base.astro';
import Separateur from '../../components/Separateur.astro';
import { airSousBord } from '../../lib/bords';
import Lettre from '../../components/Lettre.astro';
import Signe from '../../components/Signe.astro';
import { getCollection } from 'astro:content';

const artefacts = (await getCollection('artefacts')).filter((a) => a.data.publie).sort((a, b) => a.data.ordre - b.data.ordre);
const statut = (d) => d.original === 'disponible' ? `Original disponible${d.original_prix ? ` · ${d.original_prix}` : ''}` : d.tirages_statut === 'disponible' ? 'Reproductions disponibles' : d.tirages_statut === 'bientot' ? 'Reproductions bientôt' : d.original === 'acquis' ? 'Acquis' : 'Collection personnelle';

const PORTFOLIO = 'https://canva.link/8c9ls7q4e1cmosv';
---
<Base title="Art — les œuvres d'Indigo Enoqii | Anys Mechkar" description="Indigo Enoqii écrit son propre langage magique : des œuvres vivantes, vibrantes et symboliques. Originaux et reproductions à accueillir chez soi.">
  {/* Un bandeau court plutôt qu'un plein écran : la première œuvre doit se
      voir sans avoir à faire défiler. */}
  <section class="page-hero fiche-hero art-hero" style={`padding-bottom:${airSousBord('page-bas')}`}>
    <img src="/img/oeuvres/spirales-vives.jpg" alt="" />
    <Separateur id="page-bas" cote="bas" couleur="var(--navy)" />
    <div class="wrap">
      <p class="eyebrow">Indigo Enoqii</p>
      <h1>Art</h1>
    </div>
  </section>

  {/* Sa déclaration, portée par les toiles plutôt que posée devant elles : une
      phrase, une œuvre, une phrase. On regarde en lisant, et le texte paraît
      court parce qu'il ne se lit jamais d'un bloc. */}
  <section class="art-declaration">
    <div class="narrow">
      <p class="art-texte">Habité par un <b>langage magique</b> indéchiffrable par la raison, <b>le tao, la calligraphie, les couleurs primaires, les éléments</b> et <b>le mouvement</b> composent mes créations.</p>
    </div>
    <figure class="art-toile art-toile--large">
      <img src="/img/art-1.jpg" alt="" loading="eager" />
    </figure>
    <div class="narrow">
      <p class="art-texte">Le <b>mouvement</b> qui se dépose sur le papier prend aussi forme <b>dans l'espace du corps</b> à travers <b>la danse Butô</b>. <b>Chaque performance</b> réalisée est pensée comme <b>un rituel, un acte psychomagique</b> offert au monde pour <b>relier le personnel à l'universel</b>.</p>
    </div>
    <div class="art-paire">
      <figure class="art-toile"><img src="/img/oeuvres/eclat-bleu.jpg" alt="" loading="lazy" /></figure>
      <figure class="art-toile"><img src="/img/oeuvres/rouge-indigo.jpg" alt="" loading="lazy" /></figure>
    </div>

    {/* Le portfolio annoncé pour ce qu'il est : la suite, le temps que le site
        d'art et la boutique existent. Sans cette phrase, le bouton tombe sans
        qu'on sache ce qu'il y a derrière. */}
    <div class="narrow art-suite">
      <p class="art-suite__mot">Mon site d'art et ma boutique sont en construction. En attendant, tout le travail est là.</p>
      <a class="btn btn--solid" href={PORTFOLIO} target="_blank" rel="noopener">Voir le portfolio</a>
    </div>
  </section>

  {/* Les œuvres qui ont leur histoire : elles ouvrent sur une fiche entière. */}
  <section class="art-oeuvres">
    <div class="wrap">
      <p class="rune">Les œuvres</p>
      {/* Phrase de ma main, à remplacer par la tienne : elle dit seulement ce
          que la section contient, pour qu'on sache où l'on arrive. */}
      <p class="art-intro-oeuvres">Celles qui ont leur fiche — d'où elles sont nées, leur technique, leurs dimensions, et ce qu'elles portent.</p>
      <div class="artefacts">
        {artefacts.map((a) => (
          <a class="artefact-carte" href={`/art/${a.id}`}>
            <span class="artefact-carte__img">{a.data.images[0] && <img src={a.data.images[0]} alt={a.data.titre} loading="lazy" />}</span>
            <span class="artefact-carte__corps">
              <span class="artefact-carte__titre">{a.data.titre}</span>
              {a.data.sous_titre && <span class="artefact-carte__sous">{a.data.sous_titre}</span>}
              <span class="artefact-carte__statut">{statut(a.data)}</span>
            </span>
          </a>
        ))}
        <div class="artefact-carte artefact-carte--venir">
          <img class="artefact-carte__fond" src="/img/signes/oeil.png" alt="" aria-hidden="true" loading="lazy" />
          <span class="artefact-carte__img"><Signe id="artefacts-venir" /></span>
          <span class="artefact-carte__corps">
            <span class="artefact-carte__titre">D'autres arrivent</span>
            <span class="artefact-carte__sous">Les œuvres rejoignent la collection une à une, à mesure qu'elles sont photographiées et racontées.</span>
            <span class="artefact-carte__statut">Bientôt</span>
          </span>
        </div>
      </div>
    </div>
  </section>

  <Lettre eyebrow="Les prochaines œuvres" titre="Être *prévenu*" texte="Les nouvelles œuvres et les reproductions arrivent d'abord dans la lettre." bouton="Préviens-moi" source="artefacts" />
</Base>
