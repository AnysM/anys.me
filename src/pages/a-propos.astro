---
import Base from '../layouts/Base.astro';
import { getEntry } from 'astro:content';
import { recit, codex, propositionsDe } from '../lib/monde';
import { tisser, contexte } from '../lib/lore.mjs';
import { typeLabel } from '../lib/univers.mjs';

const ap = (await getEntry('pages', 'a-propos'))!.data;
const fiches = await codex();
const ctx = contexte();
const chapitres = await Promise.all((await recit()).map(async (c) => {
  const echos = c.echos.map((id) => fiches.find((f) => f.id === id)).filter(Boolean);
  const nes = new Map();
  for (const f of echos) for (const p of await propositionsDe(f)) if (!p.externe) nes.set(p.cle, p);
  return { ...c, echosFiches: echos, nes: [...nes.values()].slice(0, 3), html: c.texte.split(/\n\n+/).map((par) => tisser(par, ctx)) };
}));
---
<Base title="À propos — Anys Mechkar" description="Le récit d'Anys Mechkar : de l'ingénieur qui avait tout à la méditation, au chamanisme, au Butô et aux arts énergétiques.">
  <section class="page-hero" style="min-height:52vh;">{ap.hero_image ? <img src={ap.hero_image} alt="" /> : <div class="ph-band"></div>}
    <div class="narrow"><p class="eyebrow">{ap.hero_eyebrow}</p><h1>{ap.hero_titre}</h1></div>
  </section>

  <section>
    <div class="tl">
      {chapitres.map((c, i) => (
        <div class={`tl-row ${i % 2 === 0 ? 'text-left' : 'text-right'}`} id={c.ancre}>
          <span class="tl-dot"></span>
          <div class="tl-text"><h2>{c.titre}</h2>{c.html.map((par) => <p set:html={par}></p>)}</div>
          <div>
            {c.image && <div class="tl-media" style="margin-bottom:1.2rem;"><img class="slot-img" src={c.image} alt={c.titre} /></div>}
            {(c.echosFiches.length > 0 || c.nes.length > 0) && (
              <aside class="tl-echos">
                {c.echosFiches.length > 0 && <p class="rune">Échos dans le Codex</p>}
                {c.echosFiches.length > 0 && <div class="echos">{c.echosFiches.map((f) => <a class="echo" href={`/codex/${f.id}`}>{f.data.titre}<small>{typeLabel(f.data.type)}</small></a>)}</div>}
                {c.nes.length > 0 && (
                  <div class="tl-echos__ne">
                    <p class="rune">Ce qui en est né</p>
                    {c.nes.map((p) => <a href={p.href}>{p.titre}</a>)}
                  </div>
                )}
              </aside>
            )}
          </div>
        </div>
      ))}
    </div>
    <p class="tl-end script">La suite s'écrit encore.</p>
    <div class="wrap" style="text-align:center; margin-top:2.4rem; display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;">
      <a class="btn btn--bleu" href="/codex">Explorer le Codex</a>
      <a class="btn btn--solid" href="/contact">Écris-moi</a>
    </div>
  </section>
</Base>
