---
// Le récit : cinq mouvements, cinq respirations. Ce gabarit vient de la page
// d'aperçu du brouillon bref, devenue la page officielle le 8 novembre 2026 :
// c'est là qu'avaient été mis au point les titres d'acte et le chemin d'encre
// planifié, restés absents de l'ancienne page À propos.
import Atelier from '../components/Atelier.astro';
import Base from '../layouts/Base.astro';
import Separateur from '../components/Separateur.astro';
import Trace from '../components/Trace.astro';
import { airSousBord } from '../lib/bords';
import { allure as allure2 } from '../lib/allure.mjs';
import { getEntry } from 'astro:content';
import { recit, pageContenu } from '../lib/monde';
import { tisser, contexte } from '../lib/lore.mjs';
import sharp from 'sharp';

// Les repères de l'atelier : en développement seulement. Astro n'écrit pas
// un attribut dont la valeur vaut undefined.
const DEV = import.meta.env.DEV;

// Les dimensions réelles de chaque photo, lues au build : le navigateur réserve
// sa place exacte, rien ne saute pendant le chargement et rien n'est recadré.
const mesures = new Map<string, { w: number; h: number }>();
async function mesure(src: string) {
  if (!mesures.has(src)) {
    try {
      const m = await sharp(`public${src}`).metadata();
      mesures.set(src, { w: m.width ?? 1600, h: m.height ?? 900 });
    } catch { mesures.set(src, { w: 1600, h: 900 }); }
  }
  return mesures.get(src)!;
}

const ap = await pageContenu('a-propos');
const ctx = contexte();

// Le texte relie déjà au Codex (mots liés) : à côté, seulement la photo du chapitre.
const actes = await Promise.all((ap.actes ?? []).map(async (a) => ({
  ...a, taille: a.respiration ? await mesure(a.respiration) : null,
})));

// Le récit se lit par sections : chacune porte son fond, ses bords de pinceau et
// un seul grand tracé d'encre. Une section vise la hauteur de celles de l'accueil
// — autour de mille cinq cents pixels : au-delà, le tracé devient une tache.
const HAUTEUR_VISEE = 1250;
const hauteurDe = (b: any) => b.texte.length * 0.62 + 170 + (b.image ? 820 : 0);

const chapitres = await Promise.all((await recit('a-propos')).map(async (c) => ({
  ...c,
  // Un contexte par bloc : sinon le manifeste épuise les liens du Codex et le
  // récit, quinze mille signes plus bas, n'en a plus aucun.
  html: ((b) => c.texte.split(/\n{2,}/).map(
    (par) => par.split('\n').map((l) => tisser(l, b)).join('<br />')
  ))(contexte()),
  taille: c.image ? await mesure(c.image) : null,
  taille2: c.image2 ? await mesure(c.image2) : null,
})));

const groupes: { acte: any; blocs: any[] }[] = [];
chapitres.forEach((c, i) => {
  const a = c.acte ?? 0;
  if (!groupes.length || groupes[groupes.length - 1].acte?.n !== a) {
    groupes.push({ acte: actes.find((x) => x.n === a) ?? { n: a }, blocs: [] });
  }
  groupes[groupes.length - 1].blocs.push({ ...c, i });
});

const sections: { acte: any; blocs: any[]; ferme: boolean }[] = [];
for (const g of groupes) {
  let courante: any[] = [];
  let h = 0;
  for (const b of g.blocs) {
    courante.push(b);
    h += hauteurDe(b);
    if (h >= HAUTEUR_VISEE) { sections.push({ acte: g.acte, blocs: courante, ferme: false }); courante = []; h = 0; }
  }
  if (courante.length) sections.push({ acte: g.acte, blocs: courante, ferme: false });
  // La respiration ne se pose qu'à la toute fin de l'acte.
  sections[sections.length - 1].ferme = true;
}

// Le premier morceau d'un acte porte son numéro et son titre ; le dernier porte
// le signe de fin. Un acte long reste un seul chapitre, même coupé en deux sections.
{
  let vu = new Set();
  for (const sec of sections) {
    (sec as any).ouvre = !vu.has(sec.acte.n);
    vu.add(sec.acte.n);
  }
}
const ROMAIN = ['', 'I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII', 'XIII', 'XIV', 'XV'];
// Le numéro affiché ne compte que les chapitres qui portent un titre : enlever
// un titre ne laisse pas de trou dans la suite.
const NUMERO = new Map();
actes.filter((a) => a.titre).forEach((a, i) => NUMERO.set(a.n, i + 1));

// Une section qui finit sur une photo pleine largeur n'a pas besoin d'un bord de
// pinceau en plus : le bord du bas de la photo fait déjà la jonction.
for (const sec of sections) {
  const d: any = sec.blocs[sec.blocs.length - 1];
  (sec as any).bande = !!(sec.ferme && sec.acte.respiration)
    || (!!d.image && (d.allure ?? 'pleine') !== 'face');
}

// Le chemin est un seul tracé continu : une section, un fragment. Il n'y en a
// deux que si la section est vraiment très haute — l'encre, étirée sur toute sa
// hauteur, deviendrait alors deux fois plus large que la page. Dans ce cas les
// deux fragments se chevauchent pour que le tracé ne se coupe pas, et se posent
// de part et d'autre : superposés au même endroit, les deux encres se voient.
const PAS = 3000;
// La forme de chacun de tes neuf fragments : sa largeur rapportée à sa hauteur.
// Un fragment couché est deux fois plus large qu'un debout à hauteur égale.
const FORMES = [0.82, 0.59, 1.42, 1.27, 1.07, 0.95, 1.43, 1.36, 1.46];
const LARGEUR_VISEE = 950;
// Ceux de tes tracés qui portent un point : t4, t6 et t7 n'en ont pas.
const AVEC_POINT = new Set([1, 2, 3, 5, 8, 9]);
{
  // Premier passage : combien de fragments chaque section porte, et la hauteur
  // que chacun occupera vraiment — la photo qui ferme l'acte déduite.
  const parts: { sec: any; k: number; m: number; h: number }[] = [];
  for (const sec of sections) {
    const h = sec.blocs.reduce((t: number, b: any) =>
      t + b.texte.length + 170 + (b.image ? 820 : 0) + ((b.vignettes ?? []).length ? 500 : 0), 0);
    const m = Math.max(1, Math.round(h / PAS));
    // Une section qui se ferme sur la photo de l'acte : le tracé s'arrête au-dessus
    // d'elle. Sinon tout son fondu du bas se joue derrière la photo — on ne voit
    // que la coupe, jamais la dissolution.
    (sec as any).photo = sec.ferme && (sec.acte as any)?.respiration ? 700 : 0;
    for (let k = 0; k < m; k += 1) {
      parts.push({ sec, k, m, h: h / m - (k === m - 1 ? (sec as any).photo : 0) });
    }
  }

  // Tes fragments portent un numéro, et ce numéro est l'ordre du chemin : on les
  // pose dans le sens croissant, du premier au neuvième, quitte à en sauter.
  // Le neuvième ferme la page. Parmi toutes les suites croissantes possibles on
  // garde celle dont les formes tombent le plus juste, place par place — choisir
  // au fil de l'eau poussait les premiers numéros trop haut et laissait les
  // derniers fragments deux fois plus larges que la page.
  {
    let meilleure: number[] = [];
    let score = Infinity;
    const essai = (suite: number[]) => {
      if (suite.length === parts.length) {
        if (suite[suite.length - 1] !== 9) return;
        const s = suite.reduce((t, q, i) =>
          t + Math.abs(parts[i].h * FORMES[q - 1] - LARGEUR_VISEE)
            - (AVEC_POINT.has(q) ? 150 : 0), 0);
        if (s < score) { score = s; meilleure = [...suite]; }
        return;
      }
      const depart = suite.length ? suite[suite.length - 1] + 1 : 1;
      for (let q = depart; q <= 9 - (parts.length - 1 - suite.length); q += 1) {
        essai([...suite, q]);
      }
    };
    essai([]);
    parts.forEach((part, i) => { (part as any).n = meilleure[i]; });
  }

  // Second passage : la place de chaque fragment dans sa section.
  for (const sec of sections) {
    // Le chemin passe sous le texte, jamais sous une photo qui le cacherait.
    const cotes = sec.blocs.map((b: any) =>
      b.cote === 'droite' ? true : b.cote === 'gauche' ? false : b.i % 2 === 1);
    const photo = (sec as any).photo;
    (sec as any).traces = parts.filter((x) => x.sec === sec).map(({ k, m, n }: any) => {
      const droite = m > 1 ? k % 2 === 1 : cotes[Math.min(k, cotes.length - 1)];
      // Le chevauchement ne sert qu'aux jonctions internes : aux deux bouts de la
      // section, le fragment s'arrête pile au bord. Déborder, c'est passer sous la
      // section suivante qui le coupe net, là où le fondu n'a pas fini sa course.
      const haut = k === 0 ? 0 : (k * 100) / m - 7;
      const bas = k === m - 1 ? 100 : ((k + 1) * 100) / m + 7;
      return {
        n, x: droite ? 56 : 44, entree: droite ? 48 : 52, miroir: !droite,
        haut: `${haut}%`,
        hauteur: k === m - 1 && photo
          ? `calc(${bas - haut}% - ${photo}px)` : `${bas - haut}%`,
      };
    });
  }
}

// Un fond sur deux : le bord de pinceau porte la couleur d'en face.
const fond = (k: number) => (k % 2 === 0 ? 'var(--surface)' : 'var(--navy)');
---
<Base title="À propos | Anys Mechkar" description="Le récit d'Anys Mechkar : de l'ingénieur qui avait tout à la méditation, au chamanisme, au Butô et aux arts énergétiques.">
  <section class="page-hero" style={`min-height:64vh; --hero-y:32%; padding-bottom:${airSousBord('page-bas')}`}>{ap.hero_image ? <img src={ap.hero_image} alt="" /> : <div class="ph-band"></div>}
    {ap.hero_image && <Separateur id="page-bas" cote="bas" couleur="var(--navy)" />}
    <div class="narrow"><p class="eyebrow" data-edit={DEV ? "ligne" : undefined} data-cle="hero_eyebrow">{ap.hero_eyebrow}</p><h1 data-edit={DEV ? "ligne" : undefined} data-cle="hero_titre">{ap.hero_titre}</h1></div>
  </section>

  {ap.manifeste && (
    <section class="manifeste">
      <div class="narrow" data-edit={DEV ? "champ" : undefined} data-champ="manifeste">
        {(() => {
          // Un paragraphe ouvert par « > » est une voix : ce qu'Anys dit lentement,
          // en serif italique. Tout le reste se parcourt, en sans. Sans ce marquage
          // il faudrait désigner les lignes par leur rang, et la moindre retouche
          // dans Tina déplacerait la typographie.
          const lignes = ap.manifeste.split(/\n\n+/).map((p: string) => ({
            voix: /^>\s/.test(p), texte: p.replace(/^>[ \t]?/gm, ''),
          }));
          // Deux paragraphes de suite qui commencent par les mêmes deux mots font une
          // litanie : la tête s'écrit une seule fois, à la main, et les lignes suivent.
          const tete = (p: string) => p.replace(/[*_]/g, '').split(/\s+/).slice(0, 2).join(' ');
          return lignes.map((ligne, k) => {
            const par = ligne.texte;
            const t = tete(par);
            const avant = k > 0 && tete(lignes[k - 1].texte) === t;
            const apres = k + 1 < lignes.length && tete(lignes[k + 1].texte) === t;
            const lit = avant || apres;
            const premier = lit && !avant;
            const corps = lit
              ? par.replace(/^([*_]*)\S+[ \t]+\S+[ \t]*/, '$1')
              : par;
            return (
              <p class:list={[lit && 'litanie', premier && 'litanie--premiere', ligne.voix && 'voix']}>{premier && <span class="litanie__tete script">{t + ' '}</span>}<Fragment set:html={corps.split('\n').map((l) => tisser(l, ctx)).join('<br />')} /></p>
            );
          });
        })()}
      </div>
    </section>
  )}

  {ap.invitation && (
    <p class="invite-recit" data-edit={DEV ? "champ" : undefined} data-champ="invitation"><Fragment set:html={ap.invitation.split('\n').map((l: string) => tisser(l, ctx)).join('<br />')} /></p>
  )}

  {sections.map((sec, si) => {
    const { acte, blocs } = sec;
    const hautId = si % 2 ? 'acte2-haut' : 'acte-haut';
    const basId = si % 2 ? 'acte2-bas' : 'acte-bas';
    // La section d'avant s'est déjà fermée sur une photo : on n'ouvre pas celle-ci
    // avec une deuxième brosse, le texte part directement sous l'image.
    const brosseHaut = si === 0 || !(sections[si - 1] as any).bande;
    const brosseBas = si === sections.length - 1 && !(sec as any).bande;
    const fondSuivant = si === sections.length - 1 ? 'var(--navy)' : fond(si + 1);
    return (
        <section class="recit-part" style={`--fond:${fond(si)}; --fond-suivant:${fondSuivant}; background:var(--fond); padding-top:${brosseHaut ? airSousBord(hautId) : '0'}; padding-bottom:${(sec as any).bande ? '0' : (si === sections.length - 1 ? airSousBord(basId) : 'clamp(4rem, 8vw, 7rem)')}`}>
          {/* Un seul bord de pinceau par jonction : chaque section porte le sien en
              haut, peint de la couleur de celle d'avant. Deux brosses face à face
              laissaient une ligne droite entre elles. */}
          {brosseHaut && <Separateur id={hautId} cote="haut" couleur={si === 0 ? 'var(--navy)' : fond(si - 1)} />}
          {brosseBas && <Separateur id={basId} cote="bas" couleur="var(--navy)" />}
          {/* Un seul tracé par section, en grand, qui la traverse de bord à bord. */}
          {(sec as any).traces.map((t: any) => (
            <Trace n={t.n} x={t.x} entree={t.entree} force={0.14}
              miroir={t.miroir} haut={t.haut} hauteur={t.hauteur} />
          ))}
          {blocs.map((c) => {

        const i = c.i;
        const allure = c.allure ?? 'pleine';
        // Une bande pleine largeur et une grappe dans le même bloc se disputent
        // la mise en page et éjectent le texte : on n'en garde qu'une.
        const vignettes = c.image ? [] : (c.vignettes ?? []).slice(0, 3);
        // Deux colonnes seulement quand quelque chose se tient en face du texte :
        // une grappe de vignettes, ou une photo posée « en face ». Une bande pleine
        // largeur se pose sous le texte — le texte se lit donc au centre, sinon la
        // moitié de la page reste vide à côté de lui.
        const seul = vignettes.length === 0 && allure !== 'face';
        // Le côté : celui que tu as choisi dans l'atelier, sinon l'alternance.
        const cote = c.cote === 'centre' ? 'text-centre'
          : c.cote === 'droite' ? 'text-right'
          : c.cote === 'gauche' ? 'text-left'
          : (i % 2 === 0 ? 'text-left' : 'text-right');
        // La respiration ne se pose qu'au tout dernier bloc de l'acte.
        const ferme = sec.ferme && c === blocs[blocs.length - 1] ? acte : null;
        // Où la photo se glisse dans le texte : après le Nième paragraphe, ou à la fin.
        const coupe = Math.min(Math.max(c.apres ?? c.html.length, 0), c.html.length);
        const avant = allure === 'face' ? c.html : c.html.slice(0, coupe);
        const suite = allure === 'face' ? [] : c.html.slice(coupe);
        // Quand la photo ferme la section, son bord du bas devient la jonction.
        const clot = c === blocs[blocs.length - 1] && suite.length === 0;
        const sousBande = clot ? fondSuivant : 'var(--fond)';
        const media = c.image && (
          <div class:list={['tl-media', `tl-media--${allure}`]}>
            {allure !== 'face' && <Separateur id={i % 2 === 0 ? 'photo-haut' : 'photo2-haut'} cote="haut" couleur="var(--navy)" />}
            <div class="tl-media__vues">
              <img src={c.image} alt={c.titre} width={c.taille?.w} height={c.taille?.h} loading="lazy" />
              {allure === 'paire' && c.image2 && <img src={c.image2} alt="" width={c.taille2?.w} height={c.taille2?.h} loading="lazy" />}
            </div>
            {allure === 'souffle' && c.phrase && <div class="tl-media__phrase"><span class="script">{c.phrase}</span></div>}
            {allure !== 'face' && <Separateur id={i % 2 === 0 ? 'photo-bas' : 'photo2-bas'} cote="bas" couleur={clot && !ferme?.respiration ? sousBande : 'var(--fond)'} />}
          </div>
        );
        return (
          <div class:list={['tl-row', `tl-row--${allure}`, cote, seul && 'tl-row--seul', vignettes.length > 0 && 'tl-row--vignettes']} id={c.ancre}>
            <div class="tl-text">
              {(sec as any).ouvre && acte.titre && c === blocs[0] && (
                <p class="acte-tete"><span class="acte-n">{ROMAIN[NUMERO.get(acte.n)] ?? acte.n}</span><span data-edit={DEV ? "ligne" : undefined} data-cle="titre" data-acte={acte.n}>{acte.titre}</span></p>
              )}
              {c.titre && <span class="tl-dot"></span>}
              {c.titre && <h2>{c.titre}</h2>}
              {avant.map((par, j) => <p data-b={DEV ? i : undefined} data-p={DEV ? j : undefined} class:list={[allure2(par)]} set:html={par}></p>)}
              {si === sections.length - 1 && c === blocs[blocs.length - 1] && suite.length === 0 && (
                <p class="recit-signature script">Anys</p>
              )}
            </div>
            {vignettes.length > 0 && (
              <div class:list={['tl-vignettes', vignettes.length < 3 && `tl-vignettes--${vignettes.length}`]}>
                {vignettes.map((v) => <img src={v} alt="" loading="lazy" />)}
              </div>
            )}
            {media}
            {suite.length > 0 && <div class="tl-text tl-text--suite">{suite.map((par, j) => <p data-b={DEV ? i : undefined} data-p={DEV ? coupe + j : undefined} class:list={[allure2(par)]} set:html={par}></p>)}</div>}
            {ferme?.respiration && (
              <div class="tl-media tl-media--souffle-acte">
                <Separateur id={c.acte % 2 ? 'photo-haut' : 'photo2-haut'} cote="haut" couleur="var(--fond)" />
                <div class="tl-media__vues">
                  <img src={ferme.respiration} alt="" width={ferme.taille?.w} height={ferme.taille?.h} loading="lazy" />
                </div>
                <Separateur id={c.acte % 2 ? 'photo-bas' : 'photo2-bas'} cote="bas" couleur={sousBande} />
              </div>
            )}
          </div>
        );
          })}
        </section>
    );
  })}

  <style>
    /* La photo du portail passe devant celle de la montagne ; le Butô reste au-dessus. */
    .tl-vignettes img:nth-child(1) { z-index: 2; }
    .tl-vignettes img:nth-child(3) { z-index: 3; }
  </style>

  <Atelier page="a-propos" />

  <section class="fin-recit">
    <div class="narrow">
      <p>Si quelque chose ici a résonné, j'aimerais le savoir. Raconte-moi où tu en es,
        je te réponds toujours.</p>
      <a class="btn btn--solid" href="/contact">On s'écrit ?</a>
    </div>
  </section>
</Base>
