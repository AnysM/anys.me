---
import Base from '../layouts/Base.astro';
import { getEntry } from 'astro:content';
const ap = (await getEntry('pages', 'a-propos')).data;
const chapitres = ap.chapitres;
---
<Base title="À propos — Anys Mechkar">
  <section class="page-hero" style="min-height:52vh;">{ap.hero_image ? <img src={ap.hero_image} alt="" /> : <div class="ph-band" data-h="HERO-APROPOS"></div>}
    <div class="narrow"><p class="eyebrow">{ap.hero_eyebrow}</p><h1>{ap.hero_titre}</h1></div>
  </section>

  <section>
    <div class="tl">
      {chapitres.map((c, i) => (
        <div class={`tl-row ${i % 2 === 0 ? 'text-left' : 'text-right'}`}>
          <span class="tl-dot"></span>
          <div class="tl-text"><h2>{c.titre}</h2>{c.texte.split(/\n\n+/).map((par) => <p>{par}</p>)}</div>
          <div class="tl-media">{c.image ? <img class="slot-img" src={c.image} alt={c.titre} /> : <div class="tl-ph"><span>{'APROPOS-' + String(i + 1).padStart(2, '0')}</span></div>}</div>
        </div>
      ))}
    </div>
    <p class="tl-end script">La suite s'écrit encore.</p>
  </section>

  <script is:inline>
    (function () {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (window.matchMedia('(max-width: 760px)').matches) return;
      var imgs = Array.prototype.slice.call(document.querySelectorAll('.tl-media img'));
      if (!imgs.length) return;
      imgs.forEach(function (im) { im.style.willChange = 'transform'; });
      var ticking = false;
      function update() {
        var vh = window.innerHeight;
        imgs.forEach(function (im) {
          var r = im.parentElement.getBoundingClientRect();
          if (r.bottom < -100 || r.top > vh + 100) return;
          var progress = (r.top + r.height / 2 - vh / 2) / vh;
          progress = Math.max(-1, Math.min(1, progress));
          im.style.transform = 'translateY(' + (progress * -22).toFixed(1) + 'px) scale(1.12)';
        });
        ticking = false;
      }
      function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    })();
  </script>
</Base>
