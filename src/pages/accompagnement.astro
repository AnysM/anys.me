---
import Base from '../layouts/Base.astro';
import { photo } from '../lib/photo';
import { getCollection, getEntry } from 'astro:content';
const items = (await getCollection('offres')).filter((o) => o.data.publie && o.data.categorie === 'accompagnement').sort((a, b) => a.data.ordre - b.data.ordre);
const ac = (await getEntry('pages', 'accompagnement')).data;
const fmt = (t) => (t || '').replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/\*(.+?)\*/g, '<span class="script">$1</span>');
const outils = ac.outils;
---
<Base title="Accompagnement — Anys Mechkar">
  <section class="page-hero">{photo('HERO-ACCOMP') ? <img src={photo('HERO-ACCOMP')} alt="" /> : <div class="ph-band" data-h="HERO-ACCOMP"></div>}
    <div class="narrow"><p class="eyebrow">{ac.hero_eyebrow}</p><h1>{ac.hero_titre}</h1></div>
  </section>

  <!-- CŒUR À CŒUR -->
  <section class="coeur">
    <div class="wrap split">
      <div class="photo">{photo('ACCOMP-PORTRAIT') ? <img class="slot-img" src={photo('ACCOMP-PORTRAIT')} alt="" /> : <div class="imgph"><span>ACCOMP-PORTRAIT</span></div>}</div>
      <div class="coeur__text">{ac.coeur.split(/\n\n+/).map((par) => <p set:html={fmt(par)}></p>)}</div>
    </div>
  </section>

  <!-- POUR QUI -->
  <section>
    <div class="narrow">
      <p class="eyebrow">{ac.pourqui_eyebrow}</p>
      <h2 style="margin-top:0.8rem;" set:html={fmt(ac.pourqui_titre)}></h2>
      {ac.pourqui_texte.split(/\n\n+/).map((par, i) => <p style={`margin-top:${i===0?"1.2rem":"0.9rem"}; color:#C2C5D2; line-height:1.9;`}>{par}</p>)}
    </div>
  </section>

  <!-- LES OUTILS -->
  <section style="padding:0;">
    <div class="univers rev">
      <div class="univers__img">{photo('ACCOMP-UNIVERS') ? <img class="slot-img" src={photo('ACCOMP-UNIVERS')} alt="" /> : <div class="imgph"><span>ACCOMP-UNIVERS</span></div>}</div>
      <div class="univers__body">
        <p class="eyebrow" style="margin-bottom:0.6rem;">{ac.outils_eyebrow}</p>
        <h2 set:html={fmt(ac.outils_titre)}></h2>
        <div class="pratiques" style="margin-top:1.4rem;">{outils.map((o) => <span>{o}</span>)}</div>
      </div>
    </div>
  </section>

  <!-- MA POSTURE (bloc de couleur) -->
  <section class="bloc-or passage">
    <div class="narrow">
      <p>{ac.passage}</p>
    </div>
  </section>

  <!-- LES FORMULES -->
  <section>
    <div class="wrap">
      <p class="eyebrow">{ac.formules_eyebrow}</p>
      <h2 style="margin-top:0.8rem;" set:html={fmt(ac.formules_titre)}></h2>
      <div style="margin-top:2.4rem;">
        {items.map((o) => (
          <a class="evt" href={`/offre/${o.id}`}>
            <div class="evt__img">{o.data.image ? <img src={o.data.image} alt={o.data.titre} /> : <div class="imgph"><span>Photo</span></div>}</div>
            <div class="evt__body">
              <div class="evt__date"><span class="soon">{o.data.tag}</span></div>
              <div class="evt__title">{o.data.titre}</div>
              <div class="evt__desc">{o.data.resume}</div>
              {o.data.prix && <div class="evt__meta">{o.data.prix}</div>}
              <span class="cta" style="margin-top:0.4rem;">Découvrir <span class="line"></span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
