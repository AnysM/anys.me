---
// Le récit court : la colonne vertébrale seule, les réalisations et ce qu'elles fondent. Hors sitemap,
// hors navigation, noindex — elle sert à comparer les deux versions.
import Atelier from '../components/Atelier.astro';
import Base from '../layouts/Base.astro';
import Separateur from '../components/Separateur.astro';
import Trace from '../components/Trace.astro';
import { airSousBord } from '../lib/bords';
import { getEntry } from 'astro:content';
import { recit } from '../lib/monde';
import { tisser, contexte } from '../lib/lore.mjs';
import sharp from 'sharp';

// Les repères de l'atelier : en développement seulement. Astro n'écrit pas
// un attribut dont la valeur vaut undefined.
const DEV = import.meta.env.DEV;

// Les dimensions réelles de chaque photo, lues au build : le navigateur réserve
// sa place exacte, rien ne saute pendant le chargement et rien n'est recadré.
const mesures = new Map<string, { w: number; h: number }>();
async function mesure(src: string) {
  if (!mesures.has(src)) {
    try {
      const m = await sharp(`public${src}`).metadata();
      mesures.set(src, { w: m.width ?? 1600, h: m.height ?? 900 });
    } catch { mesures.set(src, { w: 1600, h: 900 }); }
  }
  return mesures.get(src)!;
}

// Un paragraphe entièrement en gras devient un souffle ; un paragraphe
// entièrement à la main garde sa place à lui. Le reste est du texte courant.
function allure2(par: string) {
  const nu = par.trim();
  if (/^<strong>[^<]*<\/strong>$/.test(nu)) {
    return nu.replace(/<[^>]+>/g, '').length > 120 ? 'souffle--long' : 'souffle--court';
  }
  if (/^<span class="script">[^<]*<\/span>$/.test(nu)) return 'main-levee';
  return null;
}

const ap = (await getEntry('pages', 'a-propos-court'))!.data;
const ctx = contexte();

// Le texte relie déjà au Codex (mots liés) : à côté, seulement la photo du chapitre.
const actes = await Promise.all((ap.actes ?? []).map(async (a) => ({
  ...a, taille: a.respiration ? await mesure(a.respiration) : null,
})));

// Le récit se lit par sections : chacune porte son fond, ses bords de pinceau et
// un seul grand tracé d'encre. Une section vise la hauteur de celles de l'accueil
// — autour de mille cinq cents pixels : au-delà, le tracé devient une tache.
const HAUTEUR_VISEE = 1250;
const hauteurDe = (b: any) => b.texte.length * 0.62 + 170 + (b.image ? 820 : 0);

const chapitres = await Promise.all((await recit('a-propos-court')).map(async (c) => ({
  ...c,
  // Un contexte par bloc : sinon le manifeste épuise les liens du Codex et le
  // récit, quinze mille signes plus bas, n'en a plus aucun.
  html: ((b) => c.texte.split(/\n{2,}/).map(
    (par) => par.split('\n').map((l) => tisser(l, b)).join('<br />')
  ))(contexte()),
  taille: c.image ? await mesure(c.image) : null,
  taille2: c.image2 ? await mesure(c.image2) : null,
})));

// L'alternance gauche / droite ne compte que les blocs qui ont une photo :
// ceux qui n'en ont pas se tiennent au centre, et ne doivent pas décaler le rythme.
let visuel = -1;
const groupes: { acte: any; blocs: any[] }[] = [];
chapitres.forEach((c, i) => {
  if (c.image || (c.vignettes ?? []).length) visuel += 1;
  const a = c.acte ?? 0;
  if (!groupes.length || groupes[groupes.length - 1].acte?.n !== a) {
    groupes.push({ acte: actes.find((x) => x.n === a) ?? { n: a }, blocs: [] });
  }
  groupes[groupes.length - 1].blocs.push({ ...c, i, v: visuel });
});

const sections: { acte: any; blocs: any[]; ferme: boolean }[] = [];
for (const g of groupes) {
  let courante: any[] = [];
  let h = 0;
  for (const b of g.blocs) {
    courante.push(b);
    h += hauteurDe(b);
    if (h >= HAUTEUR_VISEE) { sections.push({ acte: g.acte, blocs: courante, ferme: false }); courante = []; h = 0; }
  }
  if (courante.length) sections.push({ acte: g.acte, blocs: courante, ferme: false });
  // La respiration ne se pose qu'à la toute fin de l'acte.
  sections[sections.length - 1].ferme = true;
}

// Une section qui finit sur une photo pleine largeur n'a pas besoin d'un bord de
// pinceau en plus : le bord du bas de la photo fait déjà la jonction.
for (const sec of sections) {
  const d: any = sec.blocs[sec.blocs.length - 1];
  (sec as any).bande = !!(sec.ferme && sec.acte.respiration)
    || (!!d.image && (d.allure ?? 'pleine') !== 'face');
}

// Un fond sur deux : le bord de pinceau porte la couleur d'en face.
const fond = (k: number) => (k % 2 === 0 ? 'var(--surface)' : 'var(--navy)');
---
<Base noindex title="À propos (court) — Anys Mechkar" description="Le récit d'Anys Mechkar : de l'ingénieur qui avait tout à la méditation, au chamanisme, au Butô et aux arts énergétiques.">
  <section class="page-hero" style={`min-height:64vh; --hero-y:32%; padding-bottom:${airSousBord('page-bas')}`}>{ap.hero_image ? <img src={ap.hero_image} alt="" /> : <div class="ph-band"></div>}
    {ap.hero_image && <Separateur id="page-bas" cote="bas" couleur="var(--navy)" />}
    <div class="narrow"><p class="eyebrow">{ap.hero_eyebrow}</p><h1>{ap.hero_titre}</h1></div>
  </section>

  {ap.manifeste && (
    <section class="manifeste">
      <div class="narrow">
        {(() => {
          const pars = ap.manifeste.split(/\n\n+/);
          // « Le temps » ne se répète pas : il s'écrit une fois, à la main, et la
          // litanie le continue ligne après ligne.
          return pars.map((par, k) => {
            const lit = par.startsWith('Le temps ');
            const premier = lit && !pars[k - 1]?.startsWith('Le temps ');
            return (
              <p class:list={[lit && 'litanie', premier && 'litanie--premiere']}>
                {premier && <span class="litanie__tete script">Le temps</span>}
                <Fragment set:html={tisser(lit ? par.replace(/^Le temps /, '') : par, ctx)} />
              </p>
            );
          });
        })()}
      </div>
    </section>
  )}

  {ap.invitation && (
    <p class="invite-recit">{ap.invitation}</p>
  )}

  {sections.map((sec, si) => {
    const { acte, blocs } = sec;
    const hautId = si % 2 ? 'acte2-haut' : 'acte-haut';
    const basId = si % 2 ? 'acte2-bas' : 'acte-bas';
    // La section d'avant s'est déjà fermée sur une photo : on n'ouvre pas celle-ci
    // avec une deuxième brosse, le texte part directement sous l'image.
    const brosseHaut = si === 0 || !(sections[si - 1] as any).bande;
    const brosseBas = si === sections.length - 1 && !(sec as any).bande;
    const fondSuivant = si === sections.length - 1 ? 'var(--navy)' : fond(si + 1);
    return (
        <section class="recit-part" style={`--fond:${fond(si)}; --fond-suivant:${fondSuivant}; background:var(--fond); padding-top:${brosseHaut ? airSousBord(hautId) : '0'}; padding-bottom:${(sec as any).bande ? '0' : (si === sections.length - 1 ? airSousBord(basId) : 'clamp(4rem, 8vw, 7rem)')}`}>
          {/* Un seul bord de pinceau par jonction : chaque section porte le sien en
              haut, peint de la couleur de celle d'avant. Deux brosses face à face
              laissaient une ligne droite entre elles. */}
          {brosseHaut && <Separateur id={hautId} cote="haut" couleur={si === 0 ? 'var(--navy)' : fond(si - 1)} />}
          {brosseBas && <Separateur id={basId} cote="bas" couleur="var(--navy)" />}
          {/* Un seul tracé par section, en grand, qui la traverse de bord à bord. */}
          <Trace n={(si % 9) + 1} x={si % 2 ? 24 : 78} entree={si % 2 ? 72 : 28}
            force={0.085} miroir={si % 4 >= 2} />
          {blocs.map((c) => {

        const i = c.i;
        const allure = c.allure ?? 'pleine';
        // Une bande pleine largeur et une grappe dans le même bloc se disputent
        // la mise en page et éjectent le texte : on n'en garde qu'une.
        const vignettes = c.image ? [] : (c.vignettes ?? []).slice(0, 3);
        // Deux colonnes seulement quand quelque chose se tient en face du texte :
        // une grappe de vignettes, ou une photo posée « en face ». Une bande pleine
        // largeur se pose sous le texte — le texte se lit donc au centre, sinon la
        // moitié de la page reste vide à côté de lui.
        const seul = vignettes.length === 0 && allure !== 'face';
        // Le côté : celui que tu as choisi dans l'atelier, sinon l'alternance.
        const cote = c.cote === 'centre' ? 'text-centre'
          : c.cote === 'droite' ? 'text-right'
          : c.cote === 'gauche' ? 'text-left'
          : (c.v % 2 === 0 ? 'text-left' : 'text-right');
        // La respiration ne se pose qu'au tout dernier bloc de l'acte.
        const ferme = sec.ferme && c === blocs[blocs.length - 1] ? acte : null;
        // Où la photo se glisse dans le texte : après le Nième paragraphe, ou à la fin.
        const coupe = Math.min(Math.max(c.apres ?? c.html.length, 0), c.html.length);
        const avant = allure === 'face' ? c.html : c.html.slice(0, coupe);
        const suite = allure === 'face' ? [] : c.html.slice(coupe);
        // Quand la photo ferme la section, son bord du bas devient la jonction.
        const clot = c === blocs[blocs.length - 1] && suite.length === 0;
        const sousBande = clot ? fondSuivant : 'var(--fond)';
        const media = c.image && (
          <div class:list={['tl-media', `tl-media--${allure}`]}>
            {allure !== 'face' && <Separateur id={i % 2 === 0 ? 'photo-haut' : 'photo2-haut'} cote="haut" couleur="var(--navy)" />}
            <div class="tl-media__vues">
              <img src={c.image} alt={c.titre} width={c.taille?.w} height={c.taille?.h} loading="lazy" />
              {allure === 'paire' && c.image2 && <img src={c.image2} alt="" width={c.taille2?.w} height={c.taille2?.h} loading="lazy" />}
            </div>
            {allure === 'souffle' && c.phrase && <div class="tl-media__phrase"><span class="script">{c.phrase}</span></div>}
            {allure !== 'face' && <Separateur id={i % 2 === 0 ? 'photo-bas' : 'photo2-bas'} cote="bas" couleur={clot && !ferme?.respiration ? sousBande : 'var(--fond)'} />}
          </div>
        );
        return (
          <div class:list={['tl-row', `tl-row--${allure}`, cote, seul && 'tl-row--seul', vignettes.length > 0 && 'tl-row--vignettes']} id={c.ancre}>
            <div class="tl-text">
              {c.titre && <span class="tl-dot"></span>}
              {c.titre && <h2>{c.titre}</h2>}
              {avant.map((par, j) => <p data-b={DEV ? i : undefined} data-p={DEV ? j : undefined} class:list={[allure2(par)]} set:html={par}></p>)}
              {si === sections.length - 1 && c === blocs[blocs.length - 1] && suite.length === 0 && (
                <p class="recit-signature script">Anys</p>
              )}
            </div>
            {vignettes.length > 0 && (
              <div class:list={['tl-vignettes', vignettes.length < 3 && `tl-vignettes--${vignettes.length}`]}>
                {vignettes.map((v) => <img src={v} alt="" loading="lazy" />)}
              </div>
            )}
            {media}
            {suite.length > 0 && <div class="tl-text tl-text--suite">{suite.map((par, j) => <p data-b={DEV ? i : undefined} data-p={DEV ? coupe + j : undefined} class:list={[allure2(par)]} set:html={par}></p>)}</div>}
            {ferme?.respiration && (
              <div class="tl-media tl-media--souffle-acte">
                <Separateur id={c.acte % 2 ? 'photo-haut' : 'photo2-haut'} cote="haut" couleur="var(--fond)" />
                <div class="tl-media__vues">
                  <img src={ferme.respiration} alt="" width={ferme.taille?.w} height={ferme.taille?.h} loading="lazy" />
                </div>
                <Separateur id={c.acte % 2 ? 'photo-bas' : 'photo2-bas'} cote="bas" couleur={sousBande} />
              </div>
            )}
          </div>
        );
          })}
        </section>
    );
  })}

  <Atelier page="a-propos-court" />

  <section class="fin-recit">
    <div class="narrow">
      <p>Si quelque chose ici a résonné, j'aimerais le savoir. Raconte-moi où tu en es,
        je te réponds toujours.</p>
      <a class="btn btn--solid" href="/contact">On s'écrit ?</a>
    </div>
  </section>
</Base>
