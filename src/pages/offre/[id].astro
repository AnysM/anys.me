---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';
import Sigils from '../../components/Sigils.astro';
import Icone from '../../components/Icone.astro';
import Etapes from '../../components/Etapes.astro';
import Appel from '../../components/Appel.astro';
import Temoignages from '../../components/Temoignages.astro';
import Faq from '../../components/Faq.astro';
import Lettre from '../../components/Lettre.astro';
import BarreAction from '../../components/BarreAction.astro';
import { codexDe } from '../../lib/monde';
import { seuil, seuilDe, typeLabel } from '../../lib/univers.mjs';
import { fil, description, PERSONNE_ID, SITE, abs } from '../../lib/seo';
const ICONES = { 'Durée': 'duree', 'Tarif': 'prix', 'Format': 'format', 'Modalité': 'format' };
export async function getStaticPaths() {
  const offres = (await getCollection('offres')).filter((o) => o.data.publie);
  return offres.map((o) => {
    const sameCat = offres.filter((x) => x.data.categorie === o.data.categorie).sort((a, b) => a.data.ordre - b.data.ordre);
    const idx = sameCat.findIndex((x) => x.id === o.id);
    const n = sameCat.length > 1 ? sameCat[(idx + 1) % sameCat.length] : null;
    const next = n ? { id: n.id, titre: n.data.titre, image: n.data.image ?? null } : null;
    return { params: { id: o.id }, props: { o, next } };
  });
}
const { o, next } = Astro.props;
const { Content } = await render(o);
const d = o.data;
const soin = d.categorie === 'soin';
const infos = [];
if (d.duree) infos.push({ k: 'Durée', v: d.duree });
if (d.prix && !d.tarifs) infos.push({ k: 'Tarif', v: d.prix });
if (d.format) infos.push({ k: 'Format', v: d.format });
if (d.tag && !d.format) infos.push({ k: 'Modalité', v: d.tag });
const labelNext = soin ? 'Prochain soin' : 'Prochain accompagnement';
const lies = await codexDe(`offres/${o.id}`);
const touche = lies.filter((f) => f.data.type !== 'allie');
const avec = lies.filter((f) => f.data.type === 'allie');
const sigils = [...new Set(touche.flatMap((f) => f.data.univers))];
const fmt = (t = '') => t.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/\*(.+?)\*/g, '<em>$1</em>');
const s = seuil(seuilDe(d));
const contact = `/contact?pour=${encodeURIComponent(d.titre)}`;
const enPreparation = /préparation|construction/i.test(d.prix ?? '') || /en construction/i.test(o.body ?? '');
// Formules regroupées (ex. : En ligne / Immersion) pour une lecture hiérarchisée
const groupes = Object.entries((d.tarifs ?? []).reduce((acc, t) => { (acc[t.groupe ?? ''] ??= []).push(t); return acc; }, {} as Record<string, NonNullable<typeof d.tarifs>>));
const prixDepart = d.prix && /\d/.test(d.prix) ? d.prix : d.tarifs?.length ? `dès ${[...d.tarifs].sort((a, b) => parseInt(a.prix) - parseInt(b.prix))[0].prix}` : null;
const desc = description(d.resume, o.body);
const montant = (t?: string) => (t && /\d/.test(t) ? t.match(/\d+([.,]\d+)?/)![0].replace(',', '.') : null);
const offres = (d.tarifs ?? [{ label: d.titre, prix: d.prix ?? '' }])
  .map((t) => ({ nom: t.label, prix: montant(t.prix) }))
  .filter((t) => t.prix);
const jsonld = [
  {
    '@type': 'Service',
    name: d.titre,
    description: desc,
    serviceType: soin ? 'Soin' : 'Accompagnement',
    provider: { '@id': PERSONNE_ID },
    areaServed: d.format && /ligne/i.test(d.format) ? ['Lyon', 'En ligne'] : 'Lyon',
    url: abs(`/offre/${o.id}`),
    ...(d.image && { image: new URL(d.image, SITE).href }),
    ...(offres.length && { offers: offres.map((t) => ({ '@type': 'Offer', name: t.nom, price: t.prix, priceCurrency: 'EUR' })) }),
  },
  fil([{ nom: 'Accueil', url: '/' }, { nom: soin ? 'Soins' : 'Accompagnement', url: soin ? '/soins' : '/accompagnement' }, { nom: d.titre, url: `/offre/${o.id}` }]),
];
---
<Base title={`${d.titre} — ${soin ? 'Soin à Lyon' : 'Accompagnement'} | Anys Mechkar`} description={desc} image={d.image} jsonld={jsonld}>
  <section class="page-hero">{d.image ? <img src={d.image} alt="" /> : <div class="ph-band"></div>}
    <div class="narrow"><p class="eyebrow">{d.tag ?? (soin ? 'Soin' : 'Accompagnement')}</p><h1>{d.titre}</h1>
      <p class="seuil-tag"><i>{s?.num}</i> {s?.nom}<Sigils ids={sigils} /></p>
      {!enPreparation && (
        <div class="offre-action">
          {soin ? <a class="cta" href={contact} data-evt="Contact">Prendre rendez-vous <span class="line"></span></a> : <Appel pour={d.titre} discret />}
        </div>
      )}
    </div>
  </section>

  <section>
    <div class="narrow"><div class="prose"><Content /></div>
      {touche.length > 0 && (
        <div class="touche">
          <p class="rune">Ce que ça touche</p>
          <div class="echos">{touche.map((f) => <a class="echo" href={`/codex/${f.id}`}>{f.data.titre}<small>{typeLabel(f.data.type)}</small></a>)}</div>
        </div>
      )}
      {avec.length > 0 && (
        <p class="muted" style="margin-top:1.4rem; font-size:0.92rem;">Avec {avec.map((a, i) => <Fragment>{i > 0 && (i === avec.length - 1 ? ' et ' : ', ')}<a class="lore" href={`/codex/${a.id}`}>{a.data.titre}</a></Fragment>)}</p>
      )}
      {!enPreparation && !(d.benefices?.length > 0) && <div class="offre-relance">{soin ? <a class="btn btn--solid" href={contact} data-evt="Contact">Prendre rendez-vous</a> : <Appel pour={d.titre} centre />}</div>}
    </div>
  </section>

  {d.benefices?.length > 0 && (
    <section class="bloc benefices">
      <div class="narrow">
        <div class="tete"><p class="eyebrow">Ce que tu y trouves</p><h2>Ce que ça peut <span class="script">ouvrir</span></h2></div>
        <ul class="benefices__liste">{d.benefices.map((b) => <li><Icone nom="etoile" taille={16} /><span>{b}</span></li>)}</ul>
        {!enPreparation && <div class="offre-relance">{soin ? <a class="btn btn--solid" href={contact} data-evt="Contact">Prendre rendez-vous</a> : <Appel pour={d.titre} centre />}</div>}
      </div>
    </section>
  )}

  <Etapes etapes={d.etapes} />

  <Temoignages temoignages={d.temoignages} />

  {enPreparation ? (
    <Lettre eyebrow="En préparation" titre="Être *prévenu*" texte={`${d.titre} se prépare. Laisse ton email : tu seras parmi les premiers informés, avant l'annonce publique.`} bouton="Préviens-moi" source={`attente-${o.id}`} />
  ) : (
    <Fragment>
      {(infos.length > 0 || d.tarifs) && (
        <section class="bloc-or" id="tarifs">
          <div class="wrap" style="max-width:1000px;">
            <p class="eyebrow">Infos & tarifs</p>
            {infos.length > 0 && <div class="infos" style="margin-top:1.4rem;">{infos.map((it) => <div><div class="k"><Icone nom={ICONES[it.k] ?? 'etoile'} />{it.k}</div><div class="v">{it.v}</div></div>)}</div>}
            {groupes.map(([nom, formules]) => (
              <div class="formules">
                {nom && <h3 class="formules__titre">{nom}</h3>}
                <div class={`formules__grille formules__grille--${formules.length}`}>
                  {formules.map((t, i) => {
                    const enAvant = formules.some((x) => x.avant) ? t.avant : formules.length === 3 && i === 1;
                    return (
                    <div class={`formule${enAvant ? ' formule--avant' : ''}`}>
                      {enAvant && <span class="formule__badge">Recommandé</span>}
                      <span class="formule__duree">{t.label}</span>
                      <span class="formule__prix">{t.prix}</span>
                      {t.detail && <span class="formule__detail">{t.detail}</span>}
                    </div>
                    );
                  })}
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <Faq faq={d.faq} />

      <section class="invite">
        <div class="narrow">
          <p class="eyebrow">Un premier pas</p>
          <h2>{soin ? 'Envie de prendre soin de toi ?' : 'Commençons par un appel'}</h2>
          <p class="muted" style="margin:0.9rem auto 0; max-width:50ch;">{soin ? 'Dis-moi quand tu es disponible, on trouve un créneau ensemble. Je te réponds sous 48 h.' : 'Un appel découverte pour faire le point sur ta situation, sentir si ce chemin est fait pour toi, et voir quel accompagnement serait le plus adapté.'}</p>
          <div class="invite__btns">
            {soin ? <a class="btn btn--solid" href={contact} data-evt="Contact">Prendre rendez-vous</a> : <Appel pour={d.titre} centre />}
          </div>
        </div>
      </section>

      <BarreAction titre={d.titre} sous={prixDepart ?? ''}>
        {soin ? <a class="btn btn--solid" href={contact} data-evt="Contact">Réserver</a> : <Appel pour={d.titre} secondaire={false} court />}
      </BarreAction>
    </Fragment>
  )}

  <section class="detail-foot">
    <div class="wrap detail-nav">
      <a class="cta" href={soin ? '/soins' : '/accompagnement'}>← Retour</a>
      {next && (
        <a class="next-card" href={`/offre/${next.id}`}>
          <span class="next-card__txt"><span class="next-card__label">{labelNext}</span><span class="next-card__title">{next.titre}</span></span>
          <span class="next-card__img">{next.image ? <img src={next.image} alt={next.titre} /> : <div class="imgph"><span></span></div>}</span>
        </a>
      )}
    </div>
  </section>
</Base>
