---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const offres = (await getCollection('offres')).filter((o) => o.data.publie);
  return offres.map((o) => {
    const sameCat = offres.filter((x) => x.data.categorie === o.data.categorie).sort((a, b) => a.data.ordre - b.data.ordre);
    const idx = sameCat.findIndex((x) => x.id === o.id);
    const n = sameCat.length > 1 ? sameCat[(idx + 1) % sameCat.length] : null;
    const next = n ? { id: n.id, titre: n.data.titre, image: n.data.image ?? '/img/hero-soins.jpg' } : null;
    return { params: { id: o.id }, props: { o, next } };
  });
}
const { o, next } = Astro.props;
const { Content } = await render(o);
const d = o.data;
const soin = d.categorie === 'soin';
const infos = [];
if (d.duree) infos.push({ k: 'Durée', v: d.duree });
if (d.prix && !d.tarifs) infos.push({ k: 'Tarif', v: d.prix });
if (d.format) infos.push({ k: 'Format', v: d.format });
if (d.tag && !d.format) infos.push({ k: 'Modalité', v: d.tag });
const labelNext = soin ? 'Prochain soin' : 'Prochain accompagnement';
---
<Base title={`${d.titre} — Anys Mechkar`}>
  <section class="page-hero"><img src={d.image ?? '/img/hero-soins.jpg'} alt="" />
    <div class="narrow"><p class="eyebrow">{d.tag ?? (soin ? 'Soin' : 'Accompagnement')}</p><h1>{d.titre}</h1></div>
  </section>

  <section>
    <div class="narrow"><div class="prose"><Content /></div></div>
  </section>

  {d.resume && (
    <section class="breath" style="min-height:42vh;"><img src={d.image ?? '/img/breath-art.jpg'} alt="" /><div class="phrase">{d.resume}</div></section>
  )}

  {(infos.length > 0 || d.tarifs) && (
    <section class="bloc-or">
      <div class="narrow">
        <p class="eyebrow">Infos & tarifs</p>
        {infos.length > 0 && <div class="infos" style="margin-top:1.4rem;">{infos.map((it) => <div><div class="k">{it.k}</div><div class="v">{it.v}</div></div>)}</div>}
        {d.tarifs && <div class="tarifs" style="margin-top:1.2rem;">{d.tarifs.map((t) => <div class="tarif"><div class="label">{t.label}</div><div class="prix">{t.prix}</div>{t.detail && <div class="detail">{t.detail}</div>}</div>)}</div>}
      </div>
    </section>
  )}

  <section class="striptease">
    <div class="photo-slot">Photo à venir</div>
    <div class="photo-slot">Photo à venir</div>
    <div class="photo-slot">Photo à venir</div>
  </section>

  <section class="invite">
    <div class="narrow">
      <p class="eyebrow">Un premier pas</p>
      <h2>{soin ? 'Envie de prendre soin de toi ?' : "Envie d'en parler ?"}</h2>
      <p class="muted" style="margin:0.9rem auto 0; max-width:46ch;">Écris-moi un mot, ou réservons un temps ensemble. Je réponds à chaque message.</p>
      <div class="invite__btns">
        {soin ? (
          <Fragment>
            <a class="btn btn--solid" href="/contact#rdv">Prendre RDV</a>
            <a class="btn" href="/contact">Écris-moi</a>
          </Fragment>
        ) : (
          <Fragment>
            <a class="btn btn--solid" href="/contact">Écris-moi</a>
            <a class="btn" href="/contact#appel">Prendre un appel</a>
          </Fragment>
        )}
      </div>
    </div>
  </section>

  <section class="detail-foot">
    <div class="wrap detail-nav">
      <a class="cta" href={soin ? '/soins' : '/accompagnement'}>← Retour</a>
      {next && (
        <a class="next-card" href={`/offre/${next.id}`}>
          <span class="next-card__txt"><span class="next-card__label">{labelNext}</span><span class="next-card__title">{next.titre}</span></span>
          <span class="next-card__img"><img src={next.image} alt={next.titre} /></span>
        </a>
      )}
    </div>
  </section>
</Base>
