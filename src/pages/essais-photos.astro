---
// Atelier des photos. Page de travail : hors menu, hors plan du site, et
// l'enregistrement ne marche qu'en local (npm run dev).
import { getEntry } from 'astro:content';
import FONDS from '../data/fonds.json';
const acc = (await getEntry('pages', 'accueil'))!.data;

const F = FONDS as Record<string, { voile: number; lumiere: number }>;
const fmt = (t = '') => t.replace(/\*(.+?)\*/g, '<span class="script">$1</span>');

// Chaque emplacement de la page d'accueil, avec ce qu'il montre aujourd'hui.
const PLACES = [
  { champ: 'hero_photo',    titre: 'Le hero',              type: 'hero',
    actuel: acc.hero_photo ?? '/img/hero-fusion.jpg',  phrase: 'Marcher un chemin qui te ressemble vraiment' },
  { champ: 'portrait_image', titre: 'Le portrait de la bio', type: 'portrait',
    actuel: acc.portrait_image, phrase: 'Qui suis-je ?' },
  { champ: 'resp1_image',   titre: 'Respiration 1',        type: 'breath',
    actuel: acc.resp1_image,  phrase: acc.citation1 },
  { champ: 'resp2_image',   titre: 'Respiration 2',        type: 'breath',
    actuel: acc.resp2_image,  phrase: acc.citation2 },
  { champ: 'resp3_image',   titre: 'Respiration 3',        type: 'breath',
    actuel: acc.resp3_image,  phrase: acc.citation3 },
  { champ: 'danse_image',   titre: 'Derrière « Apprendre à danser »', type: 'breath',
    actuel: acc.danse_image,  phrase: 'Apprendre à danser avec la vie' },
  { champ: 'seuils_image',  titre: 'Derrière « Par où entrer »',     type: 'breath',
    actuel: acc.seuils_image, phrase: 'Par où entrer' },
  { champ: 'contact_image', titre: 'Derrière « Écris-moi »',         type: 'breath',
    actuel: acc.contact_image, phrase: 'Écris-moi' },
  { champ: 'temoins_image', titre: 'Les témoignages',      type: 'breath',
    actuel: acc.temoins_image ?? '/img/traversees-dune-vent.jpg', phrase: 'Ce qu’ils et elles en disent' },
];
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Atelier des photos</title>
</head>
<body class="atelier">
  <header class="atelier__tete">
    <h1>Atelier des photos</h1>
    <p>Chaque emplacement de la page d'accueil, avec son image d'aujourd'hui. Clique
      une vignette pour l'essayer : l'aperçu reçoit le même traitement que sur le site
      (assombrissement, voile, citation). Rien n'est touché tant que tu n'enregistres pas.</p>
    <div class="atelier__actions">
      <a class="bouton bouton--creux" href="/" target="_blank">Voir la page d'accueil</a>
      <span id="etat" class="atelier__etat">Chargement des photos…</span>
    </div>
  </header>

  {PLACES.map((p) => (
    <section class="place" data-champ={p.champ} data-type={p.type} data-actuel={p.actuel}>
      <h2>{p.titre} <span class="place__champ">{p.champ}</span></h2>
      <div class={`vue vue--${p.type}`} style={`--voile:${F[p.champ]?.voile ?? 0.62}; --lum:${F[p.champ]?.lumiere ?? 0.8}; --posx:${F[p.champ]?.x ?? 50}%; --posy:${F[p.champ]?.y ?? 50}%`}>
        <img class="vue__img" src={p.actuel ?? '/img/portrait.jpg'} alt="" />
        <div class="vue__voile"></div>
        <p class="vue__phrase" set:html={fmt(p.phrase ?? '')}></p>
      </div>
      <p class="place__etat" data-nom>actuelle : {p.actuel ?? 'aucune'}</p>
      <div class="curseurs">
        <label>Voile <b data-sortie="voile">{Math.round((F[p.champ]?.voile ?? 0.62) * 100)} %</b>
          <input type="range" data-reg="voile" min="0" max="100" step="2" value={Math.round((F[p.champ]?.voile ?? 0.62) * 100)} /></label>
        <label>Lumière <b data-sortie="lumiere">{Math.round((F[p.champ]?.lumiere ?? 0.8) * 100)} %</b>
          <input type="range" data-reg="lumiere" min="20" max="140" step="2" value={Math.round((F[p.champ]?.lumiere ?? 0.8) * 100)} /></label>
        <label>Cadrage horizontal <b data-sortie="x">{F[p.champ]?.x ?? 50} %</b>
          <input type="range" data-reg="x" min="0" max="100" step="1" value={F[p.champ]?.x ?? 50} /></label>
        <label>Cadrage vertical <b data-sortie="y">{F[p.champ]?.y ?? 50} %</b>
          <input type="range" data-reg="y" min="0" max="100" step="1" value={F[p.champ]?.y ?? 50} /></label>
      </div>
      <div class="bande" data-bande></div>
      <button type="button" class="bouton" data-poser>Enregistrer cet emplacement</button>
    </section>
  ))}

  <style is:global>
    :root { --navy: #0A0F20; --cream: #ECE7DE; --gold: #D8A24C; }
    * { box-sizing: border-box; }
    body.atelier { background: #080C1A; color: var(--cream); font-family: 'Jost', system-ui, sans-serif;
      margin: 0; padding: 0 0 6rem; }
    .atelier__tete { padding: 2.4rem clamp(1rem,4vw,3rem) 1.6rem; border-bottom: 1px solid rgba(236,231,222,0.12); }
    .atelier__tete h1 { font-size: 1.5rem; font-weight: 400; letter-spacing: 0.06em; margin: 0 0 0.5rem; }
    .atelier__tete p { color: #9AA0B4; max-width: 68ch; margin: 0 0 1.2rem; line-height: 1.6; }
    .atelier__actions { display: flex; gap: 0.8rem; align-items: center; flex-wrap: wrap; }
    .bouton { background: var(--gold); color: var(--navy); border: 1px solid var(--gold); border-radius: 999px;
      padding: 0.6rem 1.4rem; font: inherit; letter-spacing: 0.08em; text-transform: uppercase;
      font-size: 0.74rem; cursor: pointer; text-decoration: none; }
    .bouton[disabled] { opacity: 0.35; cursor: default; }
    .bouton--creux { background: transparent; color: var(--gold); }
    .atelier__etat { color: #8FB3FF; font-size: 0.82rem; }

    .place { padding: 2.2rem clamp(1rem,4vw,3rem); border-bottom: 1px solid rgba(236,231,222,0.08); }
    .place h2 { font-size: 0.78rem; letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--gold); font-weight: 500; margin: 0 0 1rem; }
    .place__champ { color: #4E5468; letter-spacing: 0.04em; margin-left: 0.6rem; }
    .place__etat { color: #6E7489; font-size: 0.76rem; margin: 0.7rem 0 0.9rem; word-break: break-all; }

    .vue { position: relative; width: 100%; overflow: hidden; background: #0E1426;
      display: grid; place-items: center; }
    .vue--hero { height: clamp(300px, 46vh, 520px); }
    .vue--breath { height: clamp(260px, 40vh, 460px); }
    .vue--portrait { height: clamp(300px, 46vh, 520px); }
    .vue__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
      object-position: var(--posx, 50%) var(--posy, 50%); }
    .vue--breath .vue__img, .vue--hero .vue__img { filter: saturate(1.1) brightness(var(--lum, 0.8)) contrast(1.02); }
    .vue--portrait .vue__img { object-fit: contain; }
    .vue__voile { position: absolute; inset: 0; }
    .vue--breath .vue__voile, .vue--hero .vue__voile { background: linear-gradient(to bottom,
      rgba(10,16,48,var(--voile, 0.62)), rgba(10,18,56,calc(var(--voile, 0.62) * 0.48)) 50%,
      rgba(10,16,48,calc(var(--voile, 0.62) * 1.07))); }
    .curseurs { display: flex; gap: 2rem; flex-wrap: wrap; margin: 0.9rem 0 1rem; }
    .curseurs label { display: block; font-size: 0.74rem; letter-spacing: 0.1em; text-transform: uppercase;
      color: #9AA0B4; min-width: 220px; }
    .curseurs b { color: var(--cream); font-weight: 500; }
    .curseurs input { width: 100%; accent-color: var(--gold); margin-top: 0.4rem; }
    .vue__phrase { position: relative; z-index: 2; margin: 0; padding: 0 6%; text-align: center;
      font-style: italic; font-weight: 300; font-size: clamp(1.1rem, 2.4vw, 1.9rem);
      color: var(--cream); text-shadow: 0 2px 18px rgba(5,7,16,0.9), 0 0 42px rgba(5,7,16,0.75); }
    .vue--hero .vue__phrase { text-align: left; justify-self: start; }
    .vue--portrait .vue__phrase { display: none; }

    .bande { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 8px; }
    .bande::-webkit-scrollbar { height: 8px; }
    .bande::-webkit-scrollbar-thumb { background: rgba(236,231,222,0.2); border-radius: 99px; }
    .vignette { flex: none; width: 112px; height: 112px; border-radius: 8px; overflow: hidden;
      border: 2px solid transparent; background: #111A38; cursor: pointer; padding: 0; }
    .vignette img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .vignette[aria-pressed=true] { border-color: var(--gold); }
  </style>

  <script type="application/json" id="fonds-init" set:html={JSON.stringify(FONDS)}></script>
  <script is:inline>
    const etat = document.getElementById('etat');
    const FONDS = JSON.parse(document.getElementById('fonds-init').textContent);

    async function enregistrerFonds() {
      const rep = await fetch('/__fonds', { method: 'POST',
        headers: { 'content-type': 'application/json' }, body: JSON.stringify(FONDS, null, 2) });
      if (rep.status === 404) return { ok: false, erreur: 'route absente — coupe et relance npm run dev' };
      return rep.json();
    }

    document.querySelectorAll('.place').forEach((place) => {
      const champ = place.dataset.champ;
      const vue = place.querySelector('.vue');
      if (!FONDS[champ]) FONDS[champ] = { voile: 0.62, lumiere: 0.8, x: 50, y: 50 };
      place.querySelectorAll('[data-reg]').forEach((inp) => {
        inp.addEventListener('input', () => {
          const quoi = inp.dataset.reg;
          const brut = Number(inp.value);
          if (quoi === 'x' || quoi === 'y') {
            FONDS[champ][quoi] = brut;
            vue.style.setProperty(quoi === 'x' ? '--posx' : '--posy', brut + '%');
          } else {
            FONDS[champ][quoi] = brut / 100;
            vue.style.setProperty(quoi === 'voile' ? '--voile' : '--lum', String(brut / 100));
          }
          place.querySelector('[data-sortie=' + quoi + ']').textContent = brut + ' %';
        });
      });
    });

    fetch('/__photos/liste').then((r) => r.json()).then((photos) => {
      etat.textContent = photos.length + ' photos disponibles.';
      document.querySelectorAll('.place').forEach((place) => {
        const bande = place.querySelector('[data-bande]');
        const vue = place.querySelector('.vue__img');
        const nom = place.querySelector('[data-nom]');
        const poser = place.querySelector('[data-poser]');
        poser.disabled = false;
        let choisie = null;

        photos.forEach((p) => {
          const b = document.createElement('button');
          b.type = 'button'; b.className = 'vignette'; b.title = p.fichier;
          b.setAttribute('aria-pressed', 'false');
          const im = document.createElement('img');
          im.loading = 'lazy';
          im.src = p.dedans ?? ('/__photos/vue?l=220&cle=' + p.cle);
          b.appendChild(im);
          b.addEventListener('click', () => {
            choisie = p;
            vue.src = p.dedans ?? ('/__photos/vue?l=1800&cle=' + p.cle);
            nom.textContent = 'essai : ' + p.fichier;
            poser.disabled = false;
            bande.querySelectorAll('.vignette').forEach((x) => x.setAttribute('aria-pressed', 'false'));
            b.setAttribute('aria-pressed', 'true');
          });
          bande.appendChild(b);
        });

        poser.addEventListener('click', async () => {
          poser.disabled = true;
          etat.textContent = 'Enregistrement…';
          try {
            let j = { ok: true, dedans: null };
            if (choisie) {
              const rep = await fetch('/__photos/choisir', {
                method: 'POST', headers: { 'content-type': 'application/json' },
                body: JSON.stringify({ champ: place.dataset.champ, cle: choisie.cle }),
              });
              j = await rep.json();
            }
            const g = await enregistrerFonds();
            if (j.ok && g.ok) {
              if (j.dedans) nom.textContent = 'enregistrée : ' + j.dedans;
              etat.textContent = 'Enregistré. Recharge la page d’accueil.';
            } else { etat.textContent = 'Échec : ' + (j.erreur || g.erreur); poser.disabled = false; }
          } catch (e) {
            etat.textContent = 'Échec : ' + e + ' — si tu viens de me voir modifier le projet, coupe et relance npm run dev.';
            poser.disabled = false;
          }
        });
      });
    }).catch(() => { etat.textContent = 'Les photos ne se chargent qu’en local (npm run dev).'; });
  </script>
</body>
</html>
