---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('agenda')).filter((e) => e.data.publie);
const dates = all.filter((e) => e.data.date).sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const sansDate = all.filter((e) => !e.data.date).sort((a, b) => a.data.ordre - b.data.ordre);
const dparts = (d) => ({ day: d.getDate(), mon: new Intl.DateTimeFormat('fr-FR', { month: 'short' }).format(d).replace('.', ''), yr: d.getFullYear() });
---
<Base title="Agenda — Anys Mechkar">
  <section class="page-hero"><img src="/img/breath-art.jpg" alt="" />
    <div class="wrap"><p class="eyebrow">Ce qui arrive</p><h1>Agenda</h1></div>
  </section>

  <section>
    <div class="wrap">
      <p class="lead" style="margin-bottom:2.4rem;">Soins, ateliers, retraites, immersions et voyages sonores. Chaque proposition à sa date.</p>

      {dates.map((e) => {
        const p = dparts(e.data.date);
        return (
        <a class="evt" href={`/agenda/${e.id}`}>
          <div class="evt__img"><img src={e.data.image ?? '/img/u-immersion.jpg'} alt={e.data.titre} /></div>
          <div class="evt__body">
            <div class="evt__date"><span class="d">{p.day}</span><span class="m">{p.mon}</span><span class="y">{p.yr}</span></div>
            <div class="evt__title">{e.data.titre}</div>
            {e.data.resume && <div class="evt__meta" style="text-transform:none;letter-spacing:0;color:#B9BCCB;">{e.data.resume}</div>}
            <div class="evt__meta">{e.data.lieu}{e.data.prix ? ` · ${e.data.prix}` : ''}</div>
            <span class="cta" style="margin-top:0.4rem;">Découvrir <span class="line"></span></span>
          </div>
        </a>
        );
      })}

      {sansDate.length > 0 && (
        <div style="margin-top:3rem;">
          <p class="eyebrow">En continu et sur inscription</p>
          <div style="margin-top:1.6rem;">
            {sansDate.map((e) => (
              <a class="evt" href={`/agenda/${e.id}`}>
                <div class="evt__img"><img src={e.data.image ?? '/img/u-immersion.jpg'} alt={e.data.titre} /></div>
                <div class="evt__body">
                  <div class="evt__date"><span class="soon">Sur inscription</span></div>
                  <div class="evt__title">{e.data.titre}</div>
                  {e.data.resume && <div class="evt__meta" style="text-transform:none;letter-spacing:0;color:#B9BCCB;">{e.data.resume}</div>}
                  <div class="evt__meta">{e.data.lieu}{e.data.prix ? ` · ${e.data.prix}` : ''}</div>
                  <span class="cta" style="margin-top:0.4rem;">Découvrir <span class="line"></span></span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</Base>
