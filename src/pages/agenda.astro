---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('agenda')).filter((e) => e.data.publie);
const labels = { atelier: 'Atelier', 'voyage-sonore': 'Voyage sonore', retraite: 'Retraite', immersion: 'Immersion', residence: 'Résidence', accompagnement: 'Accompagnement', cercle: 'Cercle', soin: 'Soin' };
const fmtCourt = (d) => new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' }).format(d).replace('.', '');

const aVenir = all.filter((e) => e.data.date).sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const retraites = all.filter((e) => !e.data.date && ['retraite', 'immersion', 'residence'].includes(e.data.categorie)).sort((a, b) => a.data.ordre - b.data.ordre);
const reguliers = all.filter((e) => !e.data.date && !['retraite', 'immersion', 'residence'].includes(e.data.categorie)).sort((a, b) => a.data.ordre - b.data.ordre);

const groupes = [
  { titre: 'À venir', items: aVenir },
  { titre: 'Rendez-vous réguliers', items: reguliers },
  { titre: 'Retraites & immersions', items: retraites },
].filter((g) => g.items.length > 0);
---
<Base title="Agenda — Anys Mechkar">
  <section class="page-hero"><img src="/img/breath-art.jpg" alt="" />
    <div class="wrap"><p class="eyebrow">Ce qui arrive</p><h1>Agenda</h1></div>
  </section>

  <section>
    <div class="wrap">
      {groupes.map((g) => (
        <div class="group">
          <h2 class="group__title">{g.titre}</h2>
          <div class="egrid">
            {g.items.map((e) => (
              <a class="ecard" href={`/agenda/${e.id}`}>
                <div class="ecard__img"><img src={e.data.image ?? '/img/u-immersion.jpg'} alt={e.data.titre} /><span class="ecard__tag">{labels[e.data.categorie] ?? e.data.categorie}</span></div>
                <div class="ecard__body">
                  <div class="ecard__when">{e.data.date ? fmtCourt(e.data.date) : (e.data.rythme ?? 'Sur inscription')}{e.data.heure ? ` · ${e.data.heure}` : ''}</div>
                  <div class="ecard__title">{e.data.titre}</div>
                  {e.data.resume && <div class="ecard__desc">{e.data.resume}</div>}
                  {e.data.lieu && <div class="ecard__meta">{e.data.lieu}</div>}
                  <div class="ecard__foot">
                    {e.data.prix && <span class="ecard__price">{e.data.prix}</span>}
                    {e.data.earlybird && <span class="ecard__early">Early bird · {e.data.earlybird}</span>}
                  </div>
                  {e.data.lien && <span class="ecard__btn">{e.data.cta ?? 'Réserver'}</span>}
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>
