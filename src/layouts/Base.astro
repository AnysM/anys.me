---
import '../styles/global.css';
import '../styles/nav.css';
import { getCollection } from 'astro:content';
const { title = 'Anys Mechkar', description = "Soins, accompagnement et espaces de présence. Anys Mechkar, guide, créateur et initiateur." } = Astro.props;
const offres = (await getCollection('offres')).filter((o) => o.data.publie).sort((a, b) => a.data.ordre - b.data.ordre);
const soins = offres.filter((o) => o.data.categorie === 'soin');
const accs = offres.filter((o) => o.data.categorie === 'accompagnement');
const links = [
  { href: '/agenda', label: 'Agenda' },
  { href: '/a-propos', label: 'À propos' },
  { href: '/soins', label: 'Soins' },
  { href: '/accompagnement', label: 'Accompagnement' },
  { href: '/partenaires', label: 'Partenaires' },
];
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/img/logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />
</head>
<body>
  <nav class="site-nav">
    <a class="site-nav__logo" href="/"><img src="/img/logo.png" alt="Anys Mechkar" /><span>Anys Mechkar</span></a>
    <div class="site-nav__links">
      <a href="/agenda">Agenda</a>
      <a href="/a-propos">À propos</a>
      <div class="has-sub">
        <a href="/soins">Soins</a>
        <div class="subnav">{soins.map((o) => <a href={`/offre/${o.id}`}>{o.data.titre}</a>)}</div>
      </div>
      <div class="has-sub">
        <a href="/accompagnement">Accompagnement</a>
        <div class="subnav">{accs.map((o) => <a href={`/offre/${o.id}`}>{o.data.titre}</a>)}</div>
      </div>
      <a href="/partenaires">Partenaires</a>
      <a class="ext" href="https://enoqii.art" target="_blank" rel="noopener">Art</a>
    </div>
    <button class="site-nav__burger" aria-label="Menu" aria-expanded="false">
      <span class="site-nav__burger-line"></span>
      <span class="site-nav__burger-line"></span>
      <span class="site-nav__burger-line"></span>
    </button>
  </nav>

  <div class="site-nav__overlay">
    <div class="site-nav__menu">
      {links.map((l, i) => (
        <a class="site-nav__link" href={l.href}><span class="site-nav__link-num">{String(i + 1).padStart(2, '0')}</span>{l.label}</a>
      ))}
      <div class="site-nav__sep"></div>
      <div class="site-nav__sub">
        <a class="site-nav__sub-link" href="https://enoqii.art" target="_blank" rel="noopener">Art</a>
        <a class="site-nav__sub-link" href="mailto:contact@anys.me">Contact</a>
      </div>
    </div>
  </div>

  <main>
    <slot />
  </main>

  <footer class="foot">
    <div class="wrap foot__grid">
      <div class="foot__brand">
        <img class="foot__logo" src="/img/logo.png" alt="" />
        <p class="foot__name">Anys Mechkar</p>
        <p class="foot__tag">Guide, créateur, initiateur. Un chemin par la présence, le mouvement et la créativité.</p>
      </div>
      <div class="foot__col">
        <p class="foot__h">Contact</p>
        <a href="mailto:contact@anys.me">contact@anys.me</a>
        <a href="tel:+33661811673">+33 6 61 81 16 73</a>
        <span>Lyon, France</span>
      </div>
      <div class="foot__col">
        <p class="foot__h">Réseaux</p>
        <a href="https://www.instagram.com/anys.mechkar/" target="_blank" rel="noopener">Instagram</a>
        <a href="https://www.youtube.com/@anys.mechkar" target="_blank" rel="noopener">YouTube</a>
        <a href="https://www.facebook.com/anys.mechkar/" target="_blank" rel="noopener">Facebook</a>
      </div>
      <div class="foot__col">
        <p class="foot__h">Art</p>
        <a href="https://enoqii.art" target="_blank" rel="noopener">enoqii.art</a>
        <a href="https://www.instagram.com/indigo.enoqii/" target="_blank" rel="noopener">@indigo.enoqii</a>
      </div>
    </div>
    <div class="wrap foot__bottom">
      <span>© {new Date().getFullYear()} Anys Mechkar</span>
      <a href="/contact">Écris-moi</a>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var nav = document.querySelector('.site-nav');
      var burger = document.querySelector('.site-nav__burger');
      var body = document.body;
      if (!nav || !burger) return;
      window.addEventListener('scroll', function () { nav.classList.toggle('scrolled', window.scrollY > 40); }, { passive: true });
      function close() { body.classList.remove('nav-open'); burger.setAttribute('aria-expanded', 'false'); body.style.overflow = ''; }
      burger.addEventListener('click', function () {
        var open = body.classList.toggle('nav-open');
        burger.setAttribute('aria-expanded', open); body.style.overflow = open ? 'hidden' : '';
      });
      document.querySelectorAll('.site-nav__link, .site-nav__sub-link').forEach(function (a) { a.addEventListener('click', close); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
    })();
  </script>
</body>
</html>
