---
import '../styles/global.css';
const { title = 'Anys Mechkar', description = "Soins, accompagnement et espaces de présence. Anys Mechkar, guide, créateur et initiateur." } = Astro.props;
const links = [
  { href: '/agenda', label: 'Agenda' },
  { href: '/soins', label: 'Soins' },
  { href: '/accompagnement', label: 'Accompagnement' },
  { href: '/partenaires', label: 'Partenaires' },
];
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Libre+Bodoni:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Sorts+Mill+Goudy:ital@0;1&display=swap" rel="stylesheet" />
</head>
<body>
  <nav class="nav">
    <a class="nav__logo" href="/">Anys <em>Mechkar</em></a>
    <div class="nav__links">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a class="ext" href="https://enoqii.art" target="_blank" rel="noopener">Art</a>
    </div>
    <button class="burger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="menu">
      <span></span><span></span>
    </button>
  </nav>

  <div class="menu" id="menu">
    <nav class="menu__links">
      {links.map((l) => <a class="menu__link" href={l.href}>{l.label}</a>)}
      <a class="menu__link" href="https://enoqii.art" target="_blank" rel="noopener">Art</a>
    </nav>
    <div class="menu__foot">
      <a href="mailto:contact@anysmechkar.com">contact@anysmechkar.com</a>
    </div>
  </div>

  <main>
    <slot />
  </main>

  <footer class="foot">
    <div class="wrap foot__row">
      <span>© {new Date().getFullYear()} Anys Mechkar</span>
      <span>
        <a href="/agenda">Agenda</a> ·
        <a href="/soins">Soins</a> ·
        <a href="/accompagnement">Accompagnement</a> ·
        <a href="https://enoqii.art" target="_blank" rel="noopener">Art</a>
      </span>
      <a href="mailto:contact@anysmechkar.com">contact@anysmechkar.com</a>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var body = document.body;
      var burger = document.querySelector('.burger');
      if (!burger) return;
      function setOpen(open) {
        body.classList.toggle('menu-open', open);
        burger.setAttribute('aria-expanded', open ? 'true' : 'false');
        burger.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
      }
      burger.addEventListener('click', function () { setOpen(!body.classList.contains('menu-open')); });
      document.querySelectorAll('.menu__link').forEach(function (a) { a.addEventListener('click', function () { setOpen(false); }); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });
    })();
  </script>
</body>
</html>
