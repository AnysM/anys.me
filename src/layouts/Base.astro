---
import '../styles/global.css';
const { title = 'Anys Mechkar', description = "Soins, accompagnement et espaces de présence, à Lyon et ailleurs. Anys Mechkar." } = Astro.props;
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700&family=Hanken+Grotesk:wght@300;400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <nav class="nav">
    <a class="nav__logo" href="/">Anys Mechkar</a>
    <div class="nav__links">
      <a href="/agenda">Agenda</a>
      <a href="/soins">Soins</a>
      <a href="/accompagnement">Accompagnement</a>
      <a href="/partenaires">Partenaires</a>
      <a class="ext" href="https://enoqii.art" target="_blank" rel="noopener">Art</a>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer class="foot">
    <div class="wrap foot__row">
      <span>© {new Date().getFullYear()} Anys Mechkar</span>
      <span>
        <a href="/agenda">Agenda</a> ·
        <a href="/soins">Soins</a> ·
        <a href="/accompagnement">Accompagnement</a> ·
        <a href="https://enoqii.art" target="_blank" rel="noopener">Art</a>
      </span>
      <a href="mailto:contact@anysmechkar.com">contact@anysmechkar.com</a>
    </div>
  </footer>
</body>
</html>
