---
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/monde.css';
import '../styles/finition.css';
import { getCollection } from 'astro:content';
import { personne, siteWeb } from '../lib/seo';
import { typeLabel } from '../lib/univers.mjs';
const {
  title = 'Anys Mechkar',
  description = "Soins, accompagnement et espaces de présence. Anys Mechkar, guide, créateur et initiateur.",
  image = '/img/univers-art.jpg',
  type = 'website',
  publie,
  modifie,
  jsonld = [],
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
// Lexique du Codex pour l'aperçu au survol des mots tissés dans les textes
const lexique = JSON.stringify(Object.fromEntries(
  (await getCollection('codex')).filter((c) => c.data.publie).map((c) => [c.id, { t: c.data.titre, y: typeLabel(c.data.type), r: c.data.resume ?? '' }]),
)).replace(/</g, '\\u003c');
// Statistiques sans cookies : actives seulement si PUBLIC_PLAUSIBLE_DOMAIN est défini (Netlify › variables)
const plausible = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
const graphe = JSON.stringify({ '@context': 'https://schema.org', '@graph': [siteWeb, personne, ...jsonld] });
const offres = (await getCollection('offres')).filter((o) => o.data.publie).sort((a, b) => a.data.ordre - b.data.ordre);
const soins = offres.filter((o) => o.data.categorie === 'soin');
const accs = offres.filter((o) => o.data.categorie === 'accompagnement');
const links = [
  { href: '/agenda', label: 'Agenda' },
  { href: '/a-propos', label: 'À propos' },
  { href: '/soins', label: 'Soins' },
  { href: '/accompagnement', label: 'Accompagnement' },
  { href: '/codex', label: 'Codex' },
];
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content={type} />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content="Anys Mechkar" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  {type === 'article' && publie && <meta property="article:published_time" content={publie.toISOString()} />}
  {type === 'article' && modifie && <meta property="article:modified_time" content={modifie.toISOString()} />}
  {type === 'article' && <meta property="article:author" content="https://anys.me/a-propos" />}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <script type="application/ld+json" set:html={graphe} />
  {plausible && <script defer data-domain={plausible} src="https://plausible.io/js/script.outbound-links.js"></script>}
  {plausible && <script is:inline>window.plausible = window.plausible || function () { (window.plausible.q = window.plausible.q || []).push(arguments); };</script>}
  <meta name="theme-color" content="#0A0F20" />
  <link rel="icon" type="image/png" href="/img/logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />
  <link rel="preload" href="/fonts/Biloxi_Script.ttf" as="font" type="font/ttf" crossorigin />
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>
  <nav class="site-nav">
    <a class="site-nav__logo" href="/"><img src="/img/logo.png" alt="Anys Mechkar" /><span>Anys Mechkar</span></a>
    <div class="site-nav__links">
      <a href="/agenda">Agenda</a>
      <a href="/a-propos">À propos</a>
      <div class="has-sub">
        <a href="/soins">Soins</a>
        <div class="subnav">{soins.map((o) => <a href={`/offre/${o.id}`}>{o.data.titre}</a>)}</div>
      </div>
      <div class="has-sub">
        <a href="/accompagnement">Accompagnement</a>
        <div class="subnav">{accs.map((o) => <a href={`/offre/${o.id}`}>{o.data.titre}</a>)}</div>
      </div>
      <a href="/codex">Codex</a>
      <a class="ext" href="https://enoqii.art" target="_blank" rel="noopener">Art</a>
    </div>
    <button class="site-nav__burger" aria-label="Menu" aria-expanded="false">
      <span class="site-nav__burger-line"></span>
      <span class="site-nav__burger-line"></span>
      <span class="site-nav__burger-line"></span>
    </button>
  </nav>

  <div class="site-nav__overlay">
    <div class="site-nav__menu">
      {links.map((l, i) => (
        <a class="site-nav__link" href={l.href}><span class="site-nav__link-num">{String(i + 1).padStart(2, '0')}</span>{l.label}</a>
      ))}
      <div class="site-nav__sep"></div>
      <div class="site-nav__sub">
        <a class="site-nav__sub-link" href="https://enoqii.art" target="_blank" rel="noopener">Art</a>
        <a class="site-nav__sub-link" href="mailto:contact@anys.me">Contact</a>
      </div>
    </div>
  </div>

  <main>
    <slot />
  </main>

  <footer class="foot">
    <div class="wrap foot__grid">
      <div class="foot__brand">
        <img class="foot__logo" src="/img/logo.png" alt="" />
        <p class="foot__name">Anys Mechkar</p>
        <p class="foot__tag">Guide, créateur, initiateur. Un chemin par la présence, le mouvement et la créativité.</p>
      </div>
      <div class="foot__col">
        <p class="foot__h">Contact</p>
        <a href="mailto:contact@anys.me">contact@anys.me</a>
        <a href="tel:+33661811673">+33 6 61 81 16 73</a>
        <span>Lyon, France</span>
      </div>
      <div class="foot__col">
        <p class="foot__h">Réseaux</p>
        <a href="https://www.instagram.com/anys.mechkar/" target="_blank" rel="noopener">Instagram</a>
        <a href="https://www.youtube.com/@anys.mechkar" target="_blank" rel="noopener">YouTube</a>
        <a href="https://www.facebook.com/anys.mechkar/" target="_blank" rel="noopener">Facebook</a>
      </div>
      <div class="foot__col">
        <p class="foot__h">Art</p>
        <a href="https://enoqii.art" target="_blank" rel="noopener">enoqii.art</a>
        <a href="https://www.instagram.com/indigo.enoqii/" target="_blank" rel="noopener">@indigo.enoqii</a>
      </div>
    </div>
    <div class="wrap foot__bottom">
      <span>© {new Date().getFullYear()} Anys Mechkar</span>
      <a href="/contact">Écris-moi</a>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var nav = document.querySelector('.site-nav');
      var burger = document.querySelector('.site-nav__burger');
      var body = document.body;
      if (!nav || !burger) return;
      window.addEventListener('scroll', function () { nav.classList.toggle('scrolled', window.scrollY > 40); }, { passive: true });
      function close() { body.classList.remove('nav-open'); burger.setAttribute('aria-expanded', 'false'); body.style.overflow = ''; }
      burger.addEventListener('click', function () {
        var open = body.classList.toggle('nav-open');
        burger.setAttribute('aria-expanded', open); body.style.overflow = open ? 'hidden' : '';
      });
      document.querySelectorAll('.site-nav__link, .site-nav__sub-link').forEach(function (a) { a.addEventListener('click', close); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
    })();
  </script>
  <script is:inline>
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var secs = Array.prototype.slice.call(document.querySelectorAll('main > section, main > article > section'));
      if (!secs.length) return;
      if (reduce) { secs.forEach(function (x) { x.classList.add('is-in'); }); return; }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } });
      }, { threshold: 0.1, rootMargin: '0px 0px -6% 0px' });
      var started = false;
      function go() { if (started) return; started = true; secs.forEach(function (x) { io.observe(x); }); }
      if (document.fonts && document.fonts.ready) { document.fonts.ready.then(go); } else { go(); }
      setTimeout(go, 1000);
    })();
  </script>
  <script is:inline>
    (function () {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return; // parallax-vivant
      var items = Array.prototype.slice.call(document.querySelectorAll('.hero-bg img, .breath img'));
      if (!items.length) return;
      items.forEach(function (el, i) { el.style.willChange = 'transform'; el.dataset.ph = (i * 1.7).toFixed(2); });
      function loop(t) {
        var H = window.innerHeight;
        for (var k = 0; k < items.length; k++) {
          var el = items[k], r = el.getBoundingClientRect();
          if (r.bottom < -80 || r.top > H + 80) continue;
          var prog = (r.top + r.height / 2 - H / 2) / H;
          prog = Math.max(-1, Math.min(1, prog));
          var py = prog * -32;
          var ph = parseFloat(el.dataset.ph) || 0;
          var dx = Math.sin(t / 3400 + ph) * 12;
          var dy = Math.cos(t / 4200 + ph) * 8;
          el.style.transform = 'translate3d(' + dx.toFixed(1) + 'px,' + (py + dy).toFixed(1) + 'px,0) scale(1.18)';
        }
        requestAnimationFrame(loop);
      }
      requestAnimationFrame(loop);
    })();
  </script>
  <script is:inline>
    (function () {
      // Conversions : clics sur les actions et envois de formulaires marqués data-evt
      function envoyer(nom, props) { if (window.plausible) window.plausible(nom, { props: props }); }
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[data-evt]');
        if (a) envoyer(a.dataset.evt, { page: location.pathname });
      });
      document.addEventListener('submit', function (e) {
        var f = e.target;
        if (f.matches('form[name="contact"]')) envoyer('Formulaire contact', { interet: (f.interet && f.interet.value) || '' });
        if (f.matches('form[name="lettre"]')) envoyer('Inscription lettre', { source: (f.source && f.source.value) || '' });
      });
      // Barre d'action mobile : apparaît après le haut de page, s'efface près de l'invitation finale
      var barre = document.querySelector('.barre-action');
      if (barre) {
        var fin = document.querySelector('.invite, .detail-foot');
        var maj = function () {
          var passe = window.scrollY > window.innerHeight * 0.6;
          var proche = fin && fin.getBoundingClientRect().top < window.innerHeight;
          barre.classList.toggle('visible', passe && !proche);
        };
        window.addEventListener('scroll', maj, { passive: true }); maj();
      }
    })();
  </script>
  <script type="application/json" id="lexique" set:html={lexique} />
  <div class="apercu-lore" role="tooltip" hidden></div>
  <script is:inline>
    (function () {
      // Aperçu d'une fiche du Codex au survol d'un mot tissé (souris uniquement)
      if (!window.matchMedia('(hover: hover)').matches) return;
      var data = {}; try { data = JSON.parse(document.getElementById('lexique').textContent); } catch (e) { return; }
      var carte = document.querySelector('.apercu-lore'), minuteur;
      function montrer(a) {
        var id = a.getAttribute('href').split('/').pop(), f = data[id];
        if (!f) return;
        clearTimeout(minuteur);
        carte.innerHTML = '';
        var y = document.createElement('span'); y.className = 'rune'; y.textContent = f.y;
        var t = document.createElement('b'); t.textContent = f.t;
        var r = document.createElement('p'); r.textContent = f.r;
        var l = document.createElement('a'); l.href = a.getAttribute('href'); l.textContent = 'Lire la fiche →';
        carte.append(y, t, r, l);
        carte.hidden = false;
        var b = a.getBoundingClientRect(), w = carte.offsetWidth;
        var x = Math.min(Math.max(12, b.left + b.width / 2 - w / 2), window.innerWidth - w - 12);
        var haut = b.top > carte.offsetHeight + 24;
        carte.style.left = x + 'px';
        carte.style.top = (haut ? b.top + window.scrollY - carte.offsetHeight - 12 : b.bottom + window.scrollY + 12) + 'px';
        carte.classList.add('on');
      }
      function cacher() { minuteur = setTimeout(function () { carte.classList.remove('on'); carte.hidden = true; }, 180); }
      document.addEventListener('mouseover', function (e) {
        var a = e.target.closest && e.target.closest('a.lore');
        if (a) montrer(a); else if (e.target.closest && e.target.closest('.apercu-lore')) clearTimeout(minuteur);
      });
      document.addEventListener('mouseout', function (e) {
        if (e.target.closest && (e.target.closest('a.lore') || e.target.closest('.apercu-lore'))) cacher();
      });
    })();
  </script>
  <script is:inline>
    (function () {
      // Étoiles discrètes sur les grands visuels
      document.querySelectorAll('#hero, .page-hero').forEach(function (el) {
        for (var i = 0; i < 2; i++) { var d = document.createElement('div'); d.className = 'etoiles'; d.setAttribute('aria-hidden', 'true'); el.appendChild(d); }
      });
      // Phrases des respirations : les mots s'allument au fil du défilement
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var phrases = Array.prototype.slice.call(document.querySelectorAll('.breath .phrase'));
      phrases.forEach(function (ph) {
        var walker = document.createTreeWalker(ph, NodeFilter.SHOW_TEXT), noeuds = [];
        while (walker.nextNode()) noeuds.push(walker.currentNode);
        noeuds.forEach(function (n) {
          var frag = document.createDocumentFragment();
          n.nodeValue.split(/(\s+)/).forEach(function (m) {
            if (!m) return;
            if (/^\s+$/.test(m)) { frag.appendChild(document.createTextNode(m)); return; }
            var s = document.createElement('span'); s.className = 'mot'; s.textContent = m; frag.appendChild(s);
          });
          n.parentNode.replaceChild(frag, n);
        });
        ph._mots = ph.querySelectorAll('.mot');
      });
      function maj() {
        var H = window.innerHeight;
        phrases.forEach(function (ph) {
          var r = ph.getBoundingClientRect();
          var p = Math.max(0, Math.min(1, (H * 0.85 - r.top) / (H * 0.45)));
          var n = Math.round(p * ph._mots.length);
          for (var i = 0; i < ph._mots.length; i++) ph._mots[i].classList.toggle('on', i < n);
        });
      }
      window.addEventListener('scroll', function () { requestAnimationFrame(maj); }, { passive: true });
      maj();
    })();
  </script>
</body>
</html>
