---
import Icone from './Icone.astro';
import { hrefAgenda, estExterne, ligneDate } from '../lib/monde';
const { e } = Astro.props;
const d = e.data;
const href = hrefAgenda(e);
// La date : pas d'icône, et ce qui suit le point médian (l'heure, le nombre de jours) en plus léger.
const ligne = ligneDate(d);
// « 26 oct 2026 · 19h30 », mais aussi « Tous les dimanches, 19h - 20h30 » : l'heure passe en plus léger.
const coupe = ligne.includes(' · ') ? ligne.split(' · ') : ligne.split(/,\s*(?=\d{1,2}\s*h)/);
const [quand, ...suite] = coupe;
const lien_sep = ligne.includes(' · ') ? ' · ' : ', ';
const categories = { atelier: 'Atelier', 'voyage-sonore': 'Voyage sonore', retraite: 'Retraite', immersion: 'Immersion', residence: 'Résidence', cercle: 'Cercle', accompagnement: 'Accompagnement', soin: 'Soin' };
---
<a class="ecard" href={href} target={estExterne(href) ? '_blank' : undefined} rel={estExterne(href) ? 'noopener' : undefined}>
  <div class="ecard__img">{d.image ? <img src={d.image} alt="" loading="lazy" /> : <div class="imgph"></div>}<span class={`ecard__tag type-${d.categorie}`}>{categories[d.categorie] ?? d.categorie}</span></div>
  <div class="ecard__body">
    <div class="ecard__title">{d.titre}</div>
    <div class="ecard__when">{quand}{suite.length > 0 && <span class="ecard__when-sub">{lien_sep}{suite.join(' · ')}</span>}</div>
    {d.resume && <div class="ecard__desc">{d.resume}</div>}
    {d.lieu && <div class="ecard__meta"><Icone nom="lieu" />{d.lieu}</div>}
    <div class="ecard__foot">
      {d.prix && <span class="ecard__price">{d.prix}</span>}
      {d.earlybird && <span class="ecard__early">Early bird jusqu’au {d.earlybird}</span>}
    </div>
    <span class="ecard__btn">{estExterne(href) ? (d.cta ?? 'En savoir plus') : 'Voir les infos'} <Icone nom={estExterne(href) ? 'externe' : 'fleche'} /></span>
  </div>
</a>
