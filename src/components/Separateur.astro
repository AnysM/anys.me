---
// La séparation : un aplat de la couleur d'en face, masqué par un vrai bord
// de pinceau. Quatre bords photographiés, leurs symétries : aucune frontière
// ne se répète. Le masque garde ses proportions, donc les poils ne s'écrasent pas.
const {
  cote = 'bas',          // « bas » : au pied de la section · « haut » : à sa tête
  couleur = 'var(--navy)',
  bord = 1,              // 1 à 4
  retourne = false,      // symétrie gauche-droite
} = Astro.props;
---
<div
  class:list={['brosse', `brosse--${cote}`, retourne && 'brosse--retournee']}
  style={`color:${couleur}; --brosse-img:url(/img/brosses/bord-${bord}.png)`}
  aria-hidden="true"
></div>
