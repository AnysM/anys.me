---
// La séparation organique, même recette que sur muysua : un rectangle de la couleur
// qui arrive, masqué par un vrai bord de pinceau. Les rotations donnent les variantes.
const {
  cote = 'bas',          // « bas » : posé au pied de la section · « haut » : à sa tête
  couleur = 'var(--navy)',
  retourne = false,
  hauteur = 'clamp(36px, 6vw, 90px)',
} = Astro.props;
---
<div
  class:list={['brosse', `brosse--${cote}`, retourne && 'brosse--retournee']}
  style={`color:${couleur}; --brosse-h:${hauteur}`}
  aria-hidden="true"
></div>
