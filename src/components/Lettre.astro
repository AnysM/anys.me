---
// Inscription à la lettre (ou liste d'attente d'une retraite). Le formulaire poste
// vers netlify/functions/formulaire, qui range dans Airtable, prévient le téléphone
// et inscrit chez Brevo. La source dit d'où vient l'inscription.
const {
  eyebrow = 'La lettre',
  titre = 'Rester *relié*',
  texte = "Une fois par mois : les prochaines dates, un texte, une pratique. Rien d'autre.",
  bouton = 'Je m’inscris',
  source = 'site',
  compact = false,
} = Astro.props;
import Signe from './Signe.astro';
const fmt = (t = '') => t.replace(/\*(.+?)\*/g, '<span class="script">$1</span>');
---
<section class={`lettre${compact ? ' lettre--compacte' : ''}`}>
  <div class="wrap lettre__rangee">
    <Signe id="lettre" />
    <div class="lettre__texte">
      <p class="eyebrow">{eyebrow}</p>
      <h2 set:html={fmt(titre)}></h2>
      {texte && <p class="lettre__intro">{texte}</p>}
    </div>
    <div class="lettre__action">
      <form class="lettre__form" name="lettre" method="POST" action="/.netlify/functions/formulaire" data-evt="Lettre">
        <input type="hidden" name="form-name" value="lettre" />
        <input type="hidden" name="source" value={source} />
        <input type="hidden" name="duree" />
        {/* Les deux pièges, invisibles à l'œil comme au lecteur d'écran. Voir
            le commentaire de Contact.astro. */}
        <p hidden><label>Ne pas remplir <input name="bot-field" /></label></p>
        <div aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden">
          <label>Site web <input type="text" name="url" tabindex="-1" autocomplete="off" /></label>
        </div>
        <label class="sr" for={`l-prenom-${source}`}>Ton prénom</label>
        <input id={`l-prenom-${source}`} type="text" name="prenom" placeholder="Ton prénom" autocomplete="given-name" />
        <label class="sr" for={`l-email-${source}`}>Ton email</label>
        <input id={`l-email-${source}`} type="email" name="email" placeholder="Ton email" autocomplete="email" required />
        <button class="btn btn--solid" type="submit">{bouton}</button>
      </form>
      <p class="lettre__note">Un mot et je te sors de la liste, à tout moment.</p>
    </div>
  </div>
</section>
