---
// Les cinq dimensions, en ligne : lecture rapide, du plus intérieur au plus incarné.
const { univers = [], centre = 'Quintessence' } = Astro.props;
const ORDRE = ['presence', 'connaissance', 'mouvement', 'vivant', 'art'];
const rangs = ORDRE.map((id) => univers.find((u) => u.id === id)).filter(Boolean);
---
<div class="rangee">
  <!-- Filtre « encre » : le trait tremble et s'épaissit légèrement, comme au pinceau -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <filter id="encre" x="-10%" y="-10%" width="120%" height="120%">
      <feTurbulence type="fractalNoise" baseFrequency="0.09" numOctaves="2" seed="7" result="grain" />
      <feDisplacementMap in="SourceGraphic" in2="grain" scale="1.8" xChannelSelector="R" yChannelSelector="G" result="bouge" />
      <feMorphology in="bouge" operator="dilate" radius="0.15" />
    </filter>
  </svg>
  {centre && <p class="rangee__centre"><span>{centre}</span></p>}
  <div class="rangee__liste">
    {rangs.map((u) => (
      <a class={`rangee__item u-${u.id}`} href={`/codex#${u.id}`}>
        <span class="rangee__picto">{u.image ? <img src={u.image} alt="" /> : <Fragment set:html={u.icon} />}</span>
        <span class="rangee__nom">{u.nom}</span>
        {u.note && <span class="rangee__note">{u.note}</span>}
      </a>
    ))}
  </div>
</div>
