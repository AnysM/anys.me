---
// La carte de Lyon, interactive : fond OpenStreetMap teinté nuit, points d'or sur les lieux.
// Leaflet est servi depuis le site ; seules les tuiles viennent d'OpenStreetMap, au moment
// où la carte entre à l'écran.
import { LIEUX } from '../lib/lieux';

const { lieux = LIEUX, hauteur = '460px', titres = true, zoom = 13 } = Astro.props;
const centre = {
  lat: (Math.max(...lieux.map((l) => l.lat)) + Math.min(...lieux.map((l) => l.lat))) / 2,
  lon: (Math.max(...lieux.map((l) => l.lon)) + Math.min(...lieux.map((l) => l.lon))) / 2,
};
---
<figure class="carte" style={`--h:${hauteur}`}>
  <div
    class="carte__plan"
    data-carte
    data-lieux={JSON.stringify(lieux)}
    data-centre={JSON.stringify(centre)}
    data-zoom={zoom}
  ></div>
  {titres && (
    <ul class="carte__liste">
      {lieux.map((l) => (
        <li>
          {l.href ? <a href={l.href}>{l.nom}</a> : <span>{l.nom}</span>}
          <small>{l.quoi}</small>
        </li>
      ))}
    </ul>
  )}
</figure>

<link rel="stylesheet" href="/vendor/leaflet/leaflet.css" />
<script is:inline>
  (function () {
    var plans = document.querySelectorAll('[data-carte]');
    if (!plans.length) return;

    function dessine(plan) {
      var lieux = JSON.parse(plan.dataset.lieux);
      var centre = JSON.parse(plan.dataset.centre);
      var carte = L.map(plan, {
        center: [centre.lat, centre.lon],
        zoom: Number(plan.dataset.zoom),
        scrollWheelZoom: false,
        attributionControl: true,
      });
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 18,
        attribution: '© <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>',
      }).addTo(carte);
      lieux.forEach(function (l) {
        var point = L.marker([l.lat, l.lon], {
          icon: L.divIcon({ className: 'carte__epingle', html: '<span></span>', iconSize: [16, 16] }),
          title: l.nom,
        }).addTo(carte);
        var lien = l.href ? '<a href="' + l.href + '">' + l.nom + '</a>' : '<b>' + l.nom + '</b>';
        point.bindPopup('<span class="carte__bulle">' + lien + '<small>' + l.quoi + '</small></span>');
      });
      if (lieux.length > 1) carte.fitBounds(lieux.map(function (l) { return [l.lat, l.lon]; }), { padding: [46, 46] });
    }

    function charge(plan) {
      if (window.L) return dessine(plan);
      if (!document.getElementById('leaflet-js')) {
        var s = document.createElement('script');
        s.id = 'leaflet-js';
        s.src = '/vendor/leaflet/leaflet.js';
        s.onload = function () { document.querySelectorAll('[data-carte]').forEach(dessine); };
        document.head.appendChild(s);
      }
    }

    if (!('IntersectionObserver' in window)) { plans.forEach(charge); return; }
    var io = new IntersectionObserver(function (entrees) {
      entrees.forEach(function (e) { if (e.isIntersecting) { io.unobserve(e.target); charge(e.target); } });
    }, { rootMargin: '300px' });
    plans.forEach(function (p) { io.observe(p); });
  })();
</script>
