---
// Témoignages en cartes lisibles, avec la note Google quand elle est connue.
const { bordHaut = true, reglage = undefined, temoignages = [], titre: titreDonne = undefined, eyebrow = 'Traversées', note = null, nombre = null, lien = null, lienAvis = null, fond = false, image = null } = Astro.props;
import Separateur from './Separateur.astro';
const carrousel = temoignages.length > 3;
const seul = temoignages.length === 1;
// Un seul témoignage : un titre au singulier et une grande citation, au lieu d'une carte isolée.
const titre = titreDonne ?? (seul ? 'Témoignage' : '*Ils et elles* l’ont traversé');
const avecScript = (t = '') => t.replace(/\*(.+?)\*/g, '<span class="script">$1</span>');
---
{temoignages.length > 0 && (
  <section class={`temoins-offre${fond && !image ? ' bloc' : ''}${image ? ' temoins-offre--photo' : ''}`} style={reglage}>
    {image && <img class="temoins-offre__fond" src={image} alt="" loading="lazy" />}
    {image && bordHaut && <Separateur id="temoins-haut" cote="haut" couleur="var(--navy)" />}
    {image && <Separateur id="temoins-bas" cote="bas" couleur="var(--navy)" />}
    <div class="wrap">
      <div class="tete">
        <p class="eyebrow">{eyebrow}</p>
        {titre && <h2 set:html={avecScript(titre)}></h2>}
        {note && (
          <a class="avis-google" href={lien} target="_blank" rel="noopener">
            <span class="avis-google__etoiles" aria-hidden="true">★★★★★</span>
            <span><b>{note}</b> sur Google{nombre && ` · ${nombre} avis`}</span>
          </a>
        )}
        {lienAvis && (
          <a class="avis-ecrire" href={lienAvis} target="_blank" rel="noopener">Tu as traversé quelque chose avec moi ? Laisse un avis</a>
        )}
      </div>
      <div class={carrousel ? 'carrousel' : `temoins-offre__grille${seul ? ' temoins-offre__grille--seul' : ''}`} data-carrousel={carrousel ? '' : undefined}>
        <div class={carrousel ? 'carrousel__piste' : 'temoins-offre__cartes'}>
        {temoignages.map((x) => (
          <figure class="temoin-carte">
            <span class="temoin-carte__guillemet" aria-hidden="true">“</span>
            <blockquote>{String(x.t ?? '').split(/\n\n+/).map((par) => <p>{par}</p>)}</blockquote>
            <figcaption><b>{x.n}</b>{x.c && <span>{x.c}</span>}</figcaption>
          </figure>
        ))}
        </div>
        {carrousel && (
          <div class="carrousel__nav">
            <button type="button" class="carrousel__btn" data-sens="-1" aria-label="Témoignage précédent"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
            <div class="carrousel__puces" role="tablist" aria-label="Témoignages">
              {temoignages.map((x, i) => <button type="button" class="carrousel__puce" data-i={i} aria-label={`Témoignage ${i + 1} sur ${temoignages.length}`} aria-current={i === 0 ? 'true' : undefined}></button>)}
            </div>
            <button type="button" class="carrousel__btn" data-sens="1" aria-label="Témoignage suivant"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
          </div>
        )}
      </div>
    </div>
  </section>
)}

<script is:inline>
  (function () {
    // Carrousel sans bibliothèque : défilement natif aimanté, flèches et puces sous les cartes
    document.querySelectorAll('[data-carrousel]').forEach(function (c) {
      if (c.dataset.pret) return; c.dataset.pret = '1';
      var piste = c.querySelector('.carrousel__piste');
      if (!piste) return;
      var cartes = Array.prototype.slice.call(piste.children);
      if (!cartes.length) return;
      var puces = Array.prototype.slice.call(c.querySelectorAll('.carrousel__puce'));
      var fleches = Array.prototype.slice.call(c.querySelectorAll('.carrousel__btn'));
      function pos(i) { return cartes[i].offsetLeft - piste.offsetLeft; }
      function aller(i) {
        i = Math.max(0, Math.min(cartes.length - 1, i));
        piste.scrollTo({ left: pos(i), behavior: 'smooth' });
      }
      // La carte posée contre le bord gauche. C'est d'elle qu'on avance ou qu'on recule,
      // sinon en bout de piste les flèches viseraient une position déjà atteinte.
      function base() {
        var x = piste.scrollLeft, meilleur = 0;
        cartes.forEach(function (k, i) { if (Math.abs(pos(i) - x) < Math.abs(pos(meilleur) - x)) meilleur = i; });
        return meilleur;
      }
      function auDebut() { return piste.scrollLeft <= 4; }
      function aLaFin() { return piste.scrollLeft + piste.clientWidth >= piste.scrollWidth - 4; }
      // Pour les puces : en bout de piste, la dernière carte est la courante.
      function actuel() { return aLaFin() ? cartes.length - 1 : base(); }
      function maj() {
        var i = actuel();
        puces.forEach(function (p, j) { if (j === i) p.setAttribute('aria-current', 'true'); else p.removeAttribute('aria-current'); });
        fleches.forEach(function (b) {
          var bout = Number(b.dataset.sens) < 0 ? auDebut() : aLaFin();
          b.disabled = bout;
          b.setAttribute('aria-disabled', bout ? 'true' : 'false');
        });
      }
      fleches.forEach(function (b) { b.addEventListener('click', function () { aller(base() + Number(b.dataset.sens)); }); });
      puces.forEach(function (p) { p.addEventListener('click', function () { aller(Number(p.dataset.i)); }); });
      piste.addEventListener('scroll', function () { requestAnimationFrame(maj); }, { passive: true });
      window.addEventListener('resize', function () { requestAnimationFrame(maj); });
      maj();
    });
  })();
</script>
