---
// La carte du Codex : chaque fiche est une étoile, près des univers qu'elle touche,
// reliée à ses fiches sœurs. Survol : ses liens s'éclairent. Clic : on ouvre la fiche.
import { placer, ancres, W, H } from '../lib/constellation';
import { UNIVERS, typeLabel } from '../lib/univers.mjs';

const { fiches } = Astro.props;
const { noeuds, aretes } = placer(fiches.map((f) => ({ id: f.id, titre: f.data.titre, univers: f.data.univers, liens: f.data.liens })));
const parId = new Map(fiches.map((f) => [f.id, f]));
const pos = new Map(noeuds.map((n) => [n.id, n]));
const voisins = new Map(noeuds.map((n) => [n.id, [] as string[]]));
for (const [a, b] of aretes) { voisins.get(a)!.push(b); voisins.get(b)!.push(a); }
---
<figure class="constellation" aria-label="Carte du Codex : les fiches reliées entre elles">
  <div class="constellation__cadre">
    <svg viewBox={`0 0 ${W} ${H}`} role="presentation">
      {UNIVERS.map((u) => (
        <g class="c-ancre" data-u={u.id} transform={`translate(${ancres[u.id].x.toFixed(0)} ${ancres[u.id].y.toFixed(0)})`}>
          <circle r="92" class="c-ancre__halo" />
          <g transform="translate(-13 -13) scale(1.08)" class="c-ancre__icone" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><Fragment set:html={u.icon.replace(/<\/?svg[^>]*>/g, '')} /></g>
          <text y="34" class="c-ancre__nom">{u.nom}</text>
        </g>
      ))}
      {aretes.map(([a, b]) => (
        <line x1={pos.get(a)!.x} y1={pos.get(a)!.y} x2={pos.get(b)!.x} y2={pos.get(b)!.y} class="c-lien" data-a={a} data-b={b} />
      ))}
      {noeuds.map((n) => {
        const f = parId.get(n.id);
        const gauche = n.gauche;
        return (
          <a href={`/codex/${n.id}`} class={`c-etoile c-etoile--${f.data.type}`} data-id={n.id} data-u={f.data.univers.join(' ')} data-voisins={voisins.get(n.id)!.join(' ')}>
            <title>{f.data.titre} · {typeLabel(f.data.type)}</title>
            <circle cx={n.x} cy={n.y} r={10 + n.degre * 1.2} class="c-etoile__halo" />
            <circle cx={n.x} cy={n.y} r={3 + Math.min(n.degre, 5) * 0.55} class="c-etoile__coeur" />
            <text x={gauche ? n.x - 12 : n.x + 12} y={n.y + 4.5} text-anchor={gauche ? 'end' : 'start'} class="c-etoile__nom">{f.data.titre}</text>
          </a>
        );
      })}
    </svg>
  </div>
  <figcaption class="constellation__legende">
    <span><i class="c-pastille c-pastille--pratique"></i>Pratiques</span>
    <span><i class="c-pastille c-pastille--notion"></i>Notions</span>
    <span><i class="c-pastille c-pastille--rencontre"></i>Rencontres</span>
    <span><i class="c-pastille c-pastille--realisation"></i>Réalisations</span>
    <span class="constellation__aide">Survole une étoile pour voir ses liens, clique pour ouvrir la fiche.</span>
  </figcaption>
</figure>

<script is:inline>
  (function () {
    var fig = document.currentScript.previousElementSibling, svg = fig.querySelector('svg');
    function eclairer(id) {
      var e = svg.querySelector('.c-etoile[data-id="' + id + '"]');
      var proches = (e.dataset.voisins || '').split(' ').concat(id);
      svg.classList.add('focus');
      svg.querySelectorAll('.c-etoile').forEach(function (s) { s.classList.toggle('on', proches.indexOf(s.dataset.id) !== -1); });
      svg.querySelectorAll('.c-lien').forEach(function (l) { l.classList.toggle('on', l.dataset.a === id || l.dataset.b === id); });
    }
    function eteindre() { svg.classList.remove('focus'); svg.querySelectorAll('.on').forEach(function (x) { x.classList.remove('on'); }); }
    svg.querySelectorAll('.c-etoile').forEach(function (s) {
      s.addEventListener('mouseenter', function () { eclairer(s.dataset.id); });
      s.addEventListener('focus', function () { eclairer(s.dataset.id); });
      s.addEventListener('mouseleave', eteindre);
      s.addEventListener('blur', eteindre);
    });
    // Filtre par univers (boutons du Codex) : les étoiles hors de l'univers s'estompent
    document.addEventListener('codex:univers', function (ev) {
      var u = ev.detail;
      svg.classList.toggle('filtre', !!u);
      svg.querySelectorAll('.c-etoile').forEach(function (s) { s.classList.toggle('dans', !!u && s.dataset.u.split(' ').indexOf(u) !== -1); });
      svg.querySelectorAll('.c-ancre').forEach(function (a) { a.classList.toggle('dans', a.dataset.u === u); });
    });
  })();
</script>
